                        TweenService:Create(box, Tw.fast, { Size = UDim2.new(1, 0, 0, baseH) }):Play()
                        if opts.Callback then task.spawn(opts.Callback, cur) end
                    end
                end)
                self:_sepIf(box, opts.IsLast)
                return { Set = function(c) ch = { R = math.floor(c.R*255), G = math.floor(c.G*255), B = math.floor(c.B*255) }; refresh(false) end,
                         Get = function() return cur end }
            end

            return G
        end

        -- Компоненты напрямую на табе (без группы) — оборачиваем в скрытую группу
        function Tab:CreateToggle(opts)    local g = self:CreateGroup(); return g:CreateToggle(opts) end
