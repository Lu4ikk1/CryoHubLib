                local function update(input)
                    local relX = math.clamp((input.Position.X - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
                    fill.Size = UDim2.fromScale(relX, 1)
                    knob.Position = UDim2.fromScale(relX, 0.5)
                    lastValue = math.floor(min + (max - min) * relX)
                    valLbl.Text = tostring(lastValue)
