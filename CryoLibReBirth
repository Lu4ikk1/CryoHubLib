    water = TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
    waterIn = TweenInfo.new(0.65, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
}

local function mk(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    return o
end

local function corner(p, r) return mk("UICorner", { CornerRadius = UDim.new(0, r or 16), Parent = p }) end
local function stroke(p, c, t, tr)
    return mk("UIStroke", { Color = c or Color3.new(1,1,1), Thickness = t or 1.4, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p })
end

local function press(btn)
    local s = btn:FindFirstChildOfClass("UIScale") or mk("UIScale", { Scale = 1, Parent = btn })
    btn.MouseButton1Down:Connect(function() TweenService:Create(s, Tw.pressDown, { Scale = 0.96 }):Play() end)
    btn.MouseButton1Up:Connect(function() TweenService:Create(s, Tw.pressUp, { Scale = 1 }):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(s, Tw.fast, { Scale = 1 }):Play() end)
end

local function hoverEffect(obj, targetColor, baseColor)
    obj.MouseEnter:Connect(function() TweenService:Create(obj, Tw.fast, { BackgroundColor3 = targetColor }):Play() end)
    obj.MouseLeave:Connect(function() TweenService:Create(obj, Tw.fast, { BackgroundColor3 = baseColor }):Play() end)
end

local function getAdaptiveScale()
    local vp = workspace.CurrentCamera.ViewportSize
    local s = math.min(vp.X / 820, vp.Y / 620, 1)
    return math.max(s, 0.55)
end

function CryoHub.new(config)
    local self = setmetatable({}, CryoHub)
    self.Config = config or DEFAULT_CONFIG
    self.CurrentTheme = self.Config.Theme
    self.T = THEMES[self.CurrentTheme]
    self.Regs = {}
    self.Sounds = {}
    self.LastHoverTime = 0
    self.LastSliderSoundTime = 0
    self.OpenDropdowns = {}
    self.CurrentTab = nil
    self.SidebarItems = {}
    self.Pages = {}
    self.IsPanelMode = (self.Config.UIMode == "panel")
    self.Loaded = false
    self.Toggling = false
    self.Hidden = false

    local function makeSound(name, id, vol)
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://" .. id
        s.Volume = vol
        s.Parent = SoundService
        self.Sounds[name] = s
    end
    makeSound("click", "6895079853", 0.4)
    makeSound("hover", "107511012621133", 0.25)
    makeSound("close", "97375206361343", 0.3)
    makeSound("notify", "71730540025978", 0.4)
    makeSound("toggle", "128389255905279", 0.4)
    makeSound("slider", "121370732132760", 0.6)

    local function playSound(name)
        if not self.Config.SoundEnabled then return end
        local s = self.Sounds[name]
        if s then s:Stop(); s:Play() end
    end

    local function playHover()
        if not self.Config.SoundEnabled then return end
        local now = os.clock()
        if now - self.LastHoverTime < 0.06 then return end
        self.LastHoverTime = now
        playSound("hover")
    end

    local function playSliderTick()
        if not self.Config.SoundEnabled then return end
        local now = os.clock()
        if now - self.LastSliderSoundTime < 0.05 then return end
        self.LastSliderSoundTime = now
        playSound("slider")
    end

    local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
    for _, n in ipairs({"CryoHubUI"}) do
        local o = pg:FindFirstChild(n); if o then o:Destroy() end
    end

    self.Gui = mk("ScreenGui", {
        Name = "CryoHubUI", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999, Parent = pg,
    })

    self.NotifWrap = mk("Frame", {
        AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -20),
        Size = UDim2.fromOffset(340, 0), BackgroundTransparency = 1, ZIndex = 5, Parent = self.Gui,
    })
    mk("UIListLayout", {
        Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Bottom, Parent = self.NotifWrap,
    })
    self.NotifOrder = 0

    function self:Notify(title, desc, iconId)
        self.NotifOrder += 1
        iconId = iconId or ICONS.Check
        playSound("notify")
        local slot = mk("Frame", {
            Size = UDim2.fromOffset(340, 76), BackgroundTransparency = 1,
            LayoutOrder = self.NotifOrder, Parent = self.NotifWrap,
        })
        local card = mk("Frame", {
            Size = UDim2.fromScale(1, 1), Position = UDim2.new(1, 360, 0, 0),
            BackgroundColor3 = self.T.card, BackgroundTransparency = 0, Parent = slot,
        })
        corner(card, 16); stroke(card, self.T.stroke, 1.2, 0.35)

        local iconBox = mk("Frame", {
            Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(48, 48),
            BackgroundColor3 = self.T.activePill, BackgroundTransparency = 0, Parent = card,
        })
        corner(iconBox, 14)
        mk("ImageLabel", {
            Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            BackgroundTransparency = 1, Image = iconId, ImageColor3 = self.T.accent, Parent = iconBox,
        })
        mk("TextLabel", {
            Position = UDim2.fromOffset(76, 14), Size = UDim2.new(1, -110, 0, 20),
            BackgroundTransparency = 1, Text = title, Font = Enum.Font.GothamBold, TextSize = 14,
            TextColor3 = self.T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
        })
        mk("TextLabel", {
            Position = UDim2.fromOffset(76, 36), Size = UDim2.new(1, -90, 0, 30),
            BackgroundTransparency = 1, Text = desc, Font = Enum.Font.Gotham, TextSize = 12,
            TextColor3 = self.T.textDim, TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Parent = card,
        })
        local closeBtn = mk("TextButton", {
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10),
            Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, Text = "×",
            Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = self.T.textDim, AutoButtonColor = false, Parent = card,
        })
        closeBtn.MouseEnter:Connect(function() playHover(); TweenService:Create(closeBtn, Tw.fast, { TextColor3 = self.T.text }):Play() end)
        closeBtn.MouseLeave:Connect(function() TweenService:Create(closeBtn, Tw.fast, { TextColor3 = self.T.textDim }):Play() end)
        closeBtn.MouseButton1Down:Connect(function() playSound("click") end)

        local dismissed = false
        local function dismiss()
            if dismissed then return end
            dismissed = true
            local out = TweenService:Create(card, Tw.med, { Position = UDim2.new(1, 360, 0, 0) })
            out:Play()
            out.Completed:Connect(function() slot:Destroy() end)
        end
        closeBtn.MouseButton1Click:Connect(dismiss)
        TweenService:Create(card, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0, 0, 0, 0) }):Play()
        task.delay(4, dismiss)
    end

    local ROOT_W, ROOT_H = 700, 500
    local TITLE_H = 56
    local SIDEBAR_W = 190
    local baseScale = getAdaptiveScale()

    if self.IsPanelMode then
        local vp = workspace.CurrentCamera.ViewportSize
        local PANEL_W = math.min(360, vp.X * 0.88)
        local M = 14
        self.Root = mk("CanvasGroup", {
            Name = "Root", AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, PANEL_W, 0, M),
            Size = UDim2.new(0, PANEL_W, 1, -M * 2),
            BackgroundColor3 = self.T.bg, BackgroundTransparency = 0,
            BorderSizePixel = 0, ClipsDescendants = true, Parent = self.Gui,
        })
        corner(self.Root, 22); stroke(self.Root, self.T.stroke, 1.5, 0.5)
        table.insert(self.Regs, { el = self.Root, prop = "BackgroundColor3", key = "bg" })

        self.TitleBar = mk("Frame", { Size = UDim2.new(1, 0, 0, TITLE_H), BackgroundTransparency = 1, ZIndex = 2, Parent = self.Root })
        local titleLbl = mk("TextLabel", {
            Position = UDim2.fromOffset(20, 0), Size = UDim2.new(1, -80, 1, 0),
            BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "CryoHub",
            TextSize = 17, TextColor3 = self.T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = self.TitleBar,
        })
        table.insert(self.Regs, { el = titleLbl, prop = "TextColor3", key = "text" })

        self.TabStrip = mk("ScrollingFrame", {
            Position = UDim2.fromOffset(0, TITLE_H), Size = UDim2.new(1, 0, 0, 50),
            BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
            ScrollBarImageColor3 = self.T.stroke, ScrollBarImageTransparency = 0.5,
            CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.X,
            ScrollingDirection = Enum.ScrollingDirection.X, Parent = self.Root,
        })
        mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center, Parent = self.TabStrip })
        mk("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = self.TabStrip })

        self.Content = mk("Frame", {
            Position = UDim2.fromOffset(0, TITLE_H + 50), Size = UDim2.new(1, 0, 1, -TITLE_H - 50),
            BackgroundTransparency = 1, ClipsDescendants = true, BorderSizePixel = 0, Parent = self.Root,
        })

        self.RefreshSidebarColors = function()
            for tid, el in pairs(self.SidebarItems) do
                local active = (tid == self.CurrentTab)
                el.btn.BackgroundColor3 = active and self.T.activePill or (el.baseColor or self.T.content)
                el.lbl.TextColor3 = active and self.T.text or self.T.textDim
                el.ico.ImageColor3 = active and self.T.text or self.T.textDim
            end
        end

        local handle = mk("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0),
            Size = UDim2.fromOffset(14, 84), BackgroundColor3 = self.T.accent,
            BackgroundTransparency = 0.15, Text = "", AutoButtonColor = false,
            ZIndex = 15, Parent = self.Gui,
        })
        corner(handle, 7); stroke(handle, self.T.stroke, 1, 0.5)
        local handleIcon = mk("TextLabel", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            Text = "‹", Font = Enum.Font.GothamBold, TextSize = 16,
            TextColor3 = self.T.bg, Parent = handle,
        })

        local panelOpen = false
        local function openPanel()
            if panelOpen then return end
            panelOpen = true
            playSound("toggle")
            TweenService:Create(self.Root, Tw.waterIn, { Position = UDim2.new(1, -M, 0, M) }):Play()
            handleIcon.Text = "›"
        end
        local function closePanel()
            if not panelOpen then return end
            panelOpen = false
            playSound("toggle")
            TweenService:Create(self.Root, Tw.water, { Position = UDim2.new(1, PANEL_W, 0, M) }):Play()
            handleIcon.Text = "‹"
        end
        local function togglePanel()
            if panelOpen then closePanel() else openPanel() end
        end
        handle.MouseButton1Click:Connect(togglePanel)

        local swipeStartX = nil
        UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.Touch then
                local pos = UserInputService:GetMouseLocation()
                local vp2 = workspace.CurrentCamera.ViewportSize
                if pos.X > vp2.X - 60 then swipeStartX = pos.X end
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not swipeStartX then return end
            if input.UserInputType == Enum.UserInputType.Touch then
                local pos = UserInputService:GetMouseLocation()
                local delta = pos.X - swipeStartX
                if not panelOpen and delta < -50 then openPanel(); swipeStartX = nil
                elseif panelOpen and delta > 50 then closePanel(); swipeStartX = nil end
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then swipeStartX = nil end
        end)
        UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.KeyCode == Enum.KeyCode.K then togglePanel() end
        end)

        self.WindowPlayIntro = function()
            task.delay(0.4, function()
                self:Notify("Panel Ready", "Swipe right edge or tap handle.", ICONS.Check)
            end)
        end
    else
        self.Root = mk("CanvasGroup", {
            Name = "Root", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(ROOT_W, ROOT_H), BackgroundColor3 = self.T.bg,
            BackgroundTransparency = 0, BorderSizePixel = 0, ClipsDescendants = true,
            GroupTransparency = 1, Visible = false, Parent = self.Gui,
        })
        corner(self.Root, 22); stroke(self.Root, self.T.stroke, 1.5, 0.3)
        table.insert(self.Regs, { el = self.Root, prop = "BackgroundColor3", key = "bg" })
        self.UiScale = mk("UIScale", { Scale = baseScale, Parent = self.Root })

        self.TitleBar = mk("Frame", {
            Name = "TitleBar", Size = UDim2.new(1, 0, 0, TITLE_H),
            BackgroundTransparency = 1, Active = true, ZIndex = 2, Parent = self.Root,
        })
        local titleLbl = mk("TextLabel", {
            Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -200, 1, 0),
            BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "CryoHub",
            TextSize = 17, TextColor3 = self.T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = self.TitleBar,
        })
        table.insert(self.Regs, { el = titleLbl, prop = "TextColor3", key = "text" })

        local function windowGlyph(glyph, baseKey, brightKey, xOffset)
            local btn = mk("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, xOffset, 0.5, 0),
                Size = UDim2.fromOffset(36, 36), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = self.TitleBar,
            })
            local lbl = mk("TextLabel", {
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = glyph,
                TextColor3 = self.T[baseKey], Font = Enum.Font.GothamBold, TextSize = 22, Parent = btn,
            })
            btn.MouseEnter:Connect(function() playHover(); TweenService:Create(lbl, Tw.fast, { TextColor3 = self.T[brightKey] }):Play() end)
            btn.MouseLeave:Connect(function() TweenService:Create(lbl, Tw.fast, { TextColor3 = self.T[baseKey] }):Play() end)
            btn.MouseButton1Down:Connect(function() playSound("click") end)
            return btn
        end

        self.BtnMin = windowGlyph("−", "textDim", "text", -62)
        self.BtnClose = windowGlyph("×", "textDim", "redBright", -20)

        local sidebar = mk("Frame", {
            Name = "Sidebar", Position = UDim2.fromOffset(0, TITLE_H),
            Size = UDim2.new(0, SIDEBAR_W, 1, -TITLE_H), BackgroundColor3 = self.T.sidebar,
            BackgroundTransparency = 0, BorderSizePixel = 0, ZIndex = 2, Parent = self.Root,
        })
        table.insert(self.Regs, { el = sidebar, prop = "BackgroundColor3", key = "sidebar" })

        self.SidebarScroll = mk("ScrollingFrame", {
            Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
            ScrollBarImageColor3 = self.T.stroke, ScrollBarImageTransparency = 0.9,
            CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y, Parent = sidebar,
        })
        mk("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = self.SidebarScroll })
        mk("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = self.SidebarScroll })

        local scrollHideTask
        self.SidebarScroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
            self.SidebarScroll.ScrollBarImageTransparency = 0.1
            if scrollHideTask then task.cancel(scrollHideTask) end
            scrollHideTask = task.delay(0.8, function()
                TweenService:Create(self.SidebarScroll, Tw.med, { ScrollBarImageTransparency = 0.9 }):Play()
            end)
        end)
        self.SidebarScroll.ScrollBarImageTransparency = 0.9

        self.Content = mk("Frame", {
            Name = "Content", Position = UDim2.fromOffset(SIDEBAR_W, TITLE_H),
            Size = UDim2.new(1, -SIDEBAR_W, 1, -TITLE_H), BackgroundColor3 = self.T.content,
            BackgroundTransparency = 0, ClipsDescendants = true, BorderSizePixel = 0, ZIndex = 2, Parent = self.Root,
        })
        table.insert(self.Regs, { el = self.Content, prop = "BackgroundColor3", key = "content" })

        self.RefreshSidebarColors = function()
            for tid, el in pairs(self.SidebarItems) do
                local active = (tid == self.CurrentTab)
                el.btn.BackgroundColor3 = active and self.T.activePill or self.T.sidebar
                el.btn.BackgroundTransparency = active and 0 or 1
                el.lbl.TextColor3 = active and self.T.text or self.T.textDim
                el.ico.ImageColor3 = active and self.T.text or self.T.textDim
            end
        end

        self.ClampRootPosition = function()
            local vp = workspace.CurrentCamera.ViewportSize
            local sz = self.Root.AbsoluteSize
            if sz.X <= 0 or sz.Y <= 0 then return end
            local cx = self.Root.Position.X.Scale * vp.X + self.Root.Position.X.Offset
            local cy = self.Root.Position.Y.Scale * vp.Y + self.Root.Position.Y.Offset
            local halfW, halfH = sz.X / 2, sz.Y / 2
            local clampedX = math.clamp(cx, halfW, vp.X - halfW)
            local clampedY = math.clamp(cy, halfH, vp.Y - halfH)
            self.Root.Position = UDim2.new(0, clampedX, 0, clampedY)
        end

        workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            local s = getAdaptiveScale()
            if self.UiScale then TweenService:Create(self.UiScale, Tw.fast, { Scale = s }):Play() end
            task.wait(0.05)
            if self.ClampRootPosition then self.ClampRootPosition() end
        end)
    end

    function self:ApplyTheme(name)
        self.CurrentTheme = name
        self.T = THEMES[name]
        for _, r in ipairs(self.Regs) do
            if r.el and r.el.Parent then
                TweenService:Create(r.el, Tw.med, { [r.prop] = self.T[r.key] }):Play()
            end
        end
        self:RefreshSidebarColors()
    end

    function self:AddTab(id, label, icon)
