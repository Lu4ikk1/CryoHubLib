            function group:AddDropdown(title, options, opts)
                opts = opts or {}
                local multi = opts.multi or false
                local baseHeight = 76
                local optHeight = 40
                local listHeight = #options * optHeight

                local box = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, baseHeight), BackgroundColor3 = self.T.card,
                    BackgroundTransparency = 0, Parent = groupFrame,
                })
                table.insert(self.Regs, { el = box, prop = "BackgroundColor3", key = "card" })
                hoverEffect(box, self.T.cardHover, self.T.card); box.MouseEnter:Connect(playHover)

                local name = mk("TextLabel", {
                    Position = UDim2.fromOffset(18, 10), Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1, Text = title, Font = Enum.Font.GothamMedium,
                    TextSize = 15, TextColor3 = self.T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = box,
                })
                table.insert(self.Regs, { el = name, prop = "TextColor3", key = "text" })

                local dropBtn = mk("TextButton", {
                    Position = UDim2.fromOffset(18, 36), Size = UDim2.new(1, -36, 0, 34),
                    BackgroundColor3 = self.T.toggleOff, BackgroundTransparency = 0, Text = "", AutoButtonColor = false, Parent = box,
                })
                corner(dropBtn, 12); stroke(dropBtn, self.T.stroke, 1, 0.6)
                table.insert(self.Regs, { el = dropBtn, prop = "BackgroundColor3", key = "toggleOff" })

                local dropLbl = mk("TextLabel", {
                    Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 1, 0),
                    BackgroundTransparency = 1, Text = multi and "Select..." or options[1],
                    Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = self.T.text,
                    TextXAlignment = Enum.TextXAlignment.Left, Parent = dropBtn,
                })
                table.insert(self.Regs, { el = dropLbl, prop = "TextColor3", key = "text" })

                local list = mk("Frame", {
                    Position = UDim2.fromOffset(18, baseHeight), Size = UDim2.new(1, -36, 0, 0),
                    BackgroundColor3 = self.T.toggleOff, BackgroundTransparency = 0,
                    ClipsDescendants = true, Parent = box,
                })
                corner(list, 12); table.insert(self.Regs, { el = list, prop = "BackgroundColor3", key = "toggleOff" })
                mk("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

                local selected = {}
                local optionRows = {}
                local callback = opts.onSelect

                local function updateSelectionVisual()
                    for opt, row in pairs(optionRows) do
                        local check = row:FindFirstChild("Check")
                        if check then check.Visible = selected[opt] == true end
                    end
                end

                for i, opt in ipairs(options) do
                    local optRow = mk("TextButton", {
                        Size = UDim2.new(1, 0, 0, optHeight), BackgroundColor3 = self.T.card,
                        BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = i, Parent = list,
                    })
                    optRow.MouseEnter:Connect(function() playHover(); TweenService:Create(optRow, Tw.fast, { BackgroundColor3 = self.T.cardHover, BackgroundTransparency = 0 }):Play() end)
                    optRow.MouseLeave:Connect(function() TweenService:Create(optRow, Tw.fast, { BackgroundTransparency = 1 }):Play() end)
                    optRow.MouseButton1Down:Connect(function() playSound("click") end)

                    local lbl = mk("TextLabel", {
                        Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -56, 1, 0),
                        BackgroundTransparency = 1, Text = opt, Font = Enum.Font.Gotham,
                        TextSize = 14, TextColor3 = self.T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = optRow,
                    })
                    table.insert(self.Regs, { el = lbl, prop = "TextColor3", key = "text" })

                    local check = mk("TextLabel", {
                        Name = "Check", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
                        Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Text = "✓",
                        Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = self.T.accent, Visible = false, Parent = optRow,
                    })
                    table.insert(self.Regs, { el = check, prop = "TextColor3", key = "accent" })
                    optionRows[opt] = optRow
                    if not multi and i == 1 then selected[opt] = true; check.Visible = true end

                    optRow.MouseButton1Click:Connect(function()
                        playSound("click")
                        if multi then
                            selected[opt] = not selected[opt]
                            updateSelectionVisual()
                            local parts = {}
                            for k, v in pairs(selected) do if v then table.insert(parts, k) end end
                            table.sort(parts)
                            dropLbl.Text = #parts > 0 and table.concat(parts, ", ") or "Select..."
                            if callback then callback(parts) end
                            self:Notify(title, #parts > 0 and "Selected: " .. table.concat(parts, ", ") or "Cleared", ICONS.Check)
                        else
                            for k in pairs(selected) do selected[k] = nil end
                            selected[opt] = true
                            updateSelectionVisual()
                            dropLbl.Text = opt
                            if callback then callback(opt) end
                            self:Notify(title, "Selected: " .. opt, ICONS.Check)
                            task.defer(function()
                                for i2, dd in ipairs(self.OpenDropdowns) do
                                    if dd.box == box then dd.close(); break end
                                end
                            end)
                        end
                    end)
                end

                local isOpen = false
                local function closeDrop()
                    if not isOpen then return end
                    isOpen = false
                    TweenService:Create(list, Tw.fast, { Size = UDim2.new(1, -36, 0, 0) }):Play()
                    TweenService:Create(box, Tw.fast, { Size = UDim2.new(1, 0, 0, baseHeight) }):Play()
                    for i, dd in ipairs(self.OpenDropdowns) do
                        if dd.box == box then table.remove(self.OpenDropdowns, i); break end
                    end
                end

                dropBtn.MouseButton1Click:Connect(function()
                    if isOpen then closeDrop()
                    else
                        isOpen = true
                        TweenService:Create(list, Tw.med, { Size = UDim2.new(1, -36, 0, listHeight) }):Play()
                        TweenService:Create(box, Tw.med, { Size = UDim2.new(1, 0, 0, baseHeight + listHeight) }):Play()
                        table.insert(self.OpenDropdowns, { box = box, btn = dropBtn, list = list, close = closeDrop })
                    end
                end)
                addSep(box)
                return {
                    GetValue = function() return selected end,
                    SetValue = function(val)
                        if multi then
                            for k in pairs(selected) do selected[k] = false end
                            for _, v in ipairs(val) do selected[v] = true end
                        else
                            for k in pairs(selected) do selected[k] = false end
                            selected[val] = true
                        end
                        updateSelectionVisual()
                        if multi then
                            local parts = {}
                            for k, v in pairs(selected) do if v then table.insert(parts, k) end end
                            dropLbl.Text = #parts > 0 and table.concat(parts, ", ") or "Select..."
                        else
                            dropLbl.Text = val
                        end
                        if callback then callback(selected) end
                    end,
                    OnChanged = function(cb) callback = cb end
                }
            end

