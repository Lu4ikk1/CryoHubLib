-- ============================================================
--  UTILITIES
-- ============================================================
local function mk(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    return o
end

local function corner(p, r) return mk("UICorner", { CornerRadius = UDim.new(0, r or 16), Parent = p }) end

local function stroke(p, c, t, tr)
    return mk("UIStroke", {
        Color = c or T.stroke, Thickness = t or 1.4, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p,
    })
end

local function press(btn)
    local s = btn:FindFirstChildOfClass("UIScale") or mk("UIScale", { Scale = 1, Parent = btn })
    btn.MouseButton1Down:Connect(function() TweenService:Create(s, Tw.pressDown, { Scale = 0.94 }):Play() end)
    btn.MouseButton1Up:Connect(function() TweenService:Create(s, Tw.pressUp, { Scale = 1 }):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(s, Tw.fast, { Scale = 1 }):Play() end)
end

local function hoverEffect(obj, targetKey, baseKey)
    obj.MouseEnter:Connect(function() TweenService:Create(obj, Tw.fast, { BackgroundColor3 = T[targetKey] }):Play() end)
    obj.MouseLeave:Connect(function() TweenService:Create(obj, Tw.fast, { BackgroundColor3 = T[baseKey] }):Play() end)
end

local function getAdaptiveScale()
    local vp = workspace.CurrentCamera.ViewportSize
    local s = math.min(vp.X / 820, vp.Y / 620, 1)
    return math.max(s, 0.55)
end

-- ============================================================
--  DEPENDENCY SYSTEM
-- ============================================================
local function processDependencies()
    for _, dep in ipairs(Library.Dependencies) do
        local parentFlag = Library.Flags[dep.flag]
        if parentFlag and dep.element then
            local isVisible = false
            if type(parentFlag.Value) == "boolean" then
                isVisible = (parentFlag.Value == dep.value)
            elseif type(parentFlag.Value) == "string" then
                isVisible = (parentFlag.Value == dep.value)
            elseif type(parentFlag.Value) == "number" then
                isVisible = (parentFlag.Value >= dep.value)
            end
            
            if dep.element.Visible ~= isVisible then
                dep.element.Visible = isVisible
                if isVisible then
                    dep.element.Size = UDim2.new(1, 0, 0, 0)
                    TweenService:Create(dep.element, Tw.fast, { Size = dep.originalSize }):Play()
                end
            end
        end
    end
end

-- ============================================================
--  SOUNDS
-- ============================================================
local Sounds = {}
local function makeSound(name, id, vol)
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. id
    s.Volume = vol
    s.Parent = SoundService
    Sounds[name] = s
end
makeSound("click",   "6895079853",        0.4)
makeSound("hover",   "107511012621133",   0.25)
makeSound("close",   "97375206361343",    0.3)
makeSound("notify",  "71730540025978",    0.4)
makeSound("toggle",  "128389255905279",   0.4)
makeSound("slider",  "121370732132760",   0.6)

local lastHoverTime, lastSliderSoundTime = 0, 0
local SoundEnabled = true

local function playSound(name)
    if not SoundEnabled then return end
    local s = Sounds[name]
    if s then s:Stop(); s:Play() end
end
local function playHover()
    if not SoundEnabled then return end
    local now = os.clock()
    if now - lastHoverTime < 0.06 then return end
    lastHoverTime = now
    playSound("hover")
end
local function playSliderTick()
    if not SoundEnabled then return end
    local now = os.clock()
    if now - lastSliderSoundTime < 0.05 then return end
    lastSliderSoundTime = now
    playSound("slider")
end

