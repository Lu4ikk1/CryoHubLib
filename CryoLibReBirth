                local cy = root.Position.Y.Offset
                cx = math.clamp(cx, sz.X * 0.25, vp.X - sz.X * 0.25)
                cy = math.clamp(cy, sz.Y * 0.2, vp.Y - sz.Y * 0.2)
                root.Position = UDim2.fromOffset(math.floor(cx), math.floor(cy))
