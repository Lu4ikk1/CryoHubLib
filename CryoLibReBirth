function Library:Notify(title, desc, iconId, duration, actionText, actionCallback)
    notifOrder += 1
    iconId = iconId or ICONS.Check
    duration = duration or 4
    playSound("notify")
    
    local slot = mk("Frame", { Size = UDim2.fromOffset(340, 84), BackgroundTransparency = 1, LayoutOrder = notifOrder, Parent = notifWrap })
    local card = mk("Frame", { Size = UDim2.fromScale(1, 1), Position = UDim2.new(1, 360, 0, 0), BackgroundColor3 = T.card, BackgroundTransparency = 0, ClipsDescendants = true, Parent = slot })
    corner(card, 16)
    stroke(card, T.stroke, 1.2, 0.35)

    local iconBox = mk("Frame", { Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(48, 48), BackgroundColor3 = T.activePill, BackgroundTransparency = 0, Parent = card })
    corner(iconBox, 14)
    mk("ImageLabel", { Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Image = iconId, ImageColor3 = T.accent, Parent = iconBox })
    
    local titleLbl = mk("TextLabel", { Position = UDim2.fromOffset(76, 14), Size = UDim2.new(1, -110, 0, 20), BackgroundTransparency = 1, Text = title, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
    local descLbl = mk("TextLabel", { Position = UDim2.fromOffset(76, 34), Size = UDim2.new(1, -110, 0, 28), BackgroundTransparency = 1, Text = desc, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.textDim, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Parent = card })
    
    local closeBtn = mk("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, Text = "×", Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = T.textDim, AutoButtonColor = false, Parent = card })
    closeBtn.MouseEnter:Connect(function() playHover(); TweenService:Create(closeBtn, Tw.fast, { TextColor3 = T.text }):Play() end)
    closeBtn.MouseLeave:Connect(function() TweenService:Create(closeBtn, Tw.fast, { TextColor3 = T.textDim }):Play() end)
    closeBtn.MouseButton1Down:Connect(function() playSound("click") end)

    -- Action Button
    if actionText and actionCallback then
        local actBtn = mk("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -10, 1, -10), Size = UDim2.fromOffset(60, 20), BackgroundColor3 = T.accent, BackgroundTransparency = 0.8, Text = actionText, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = T.accent, AutoButtonColor = false, Parent = card })
        corner(actBtn, 6)
        actBtn.MouseEnter:Connect(function() TweenService:Create(actBtn, Tw.fast, { BackgroundTransparency = 0.5 }):Play() end)
        actBtn.MouseLeave:Connect(function() TweenService:Create(actBtn, Tw.fast, { BackgroundTransparency = 0.8 }):Play() end)
        actBtn.MouseButton1Click:Connect(function()
            playSound("click")
            actionCallback()
            -- Dismiss on action
            local out = TweenService:Create(card, Tw.med, { Position = UDim2.new(1, 360, 0, 0) })
            out:Play()
            out.Completed:Connect(function() slot:Destroy() end)
        end)
    end

    -- Progress Bar
    local progressBg = mk("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.5, Parent = card })
    local progressFill = mk("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = T.accent, BackgroundTransparency = 0, Parent = progressBg })
    TweenService:Create(progressFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) }):Play()

    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        local out = TweenService:Create(card, Tw.med, { Position = UDim2.new(1, 360, 0, 0) })
        out:Play()
        out.Completed:Connect(function() slot:Destroy() end)
    end
    closeBtn.MouseButton1Click:Connect(dismiss)
    TweenService:Create(card, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0, 0, 0, 0) }):Play()
    task.delay(duration, dismiss)
end

