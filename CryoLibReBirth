function Library:CreateWindow(config)
    config = config or {}
    local Title = config.Title or "CryoHub"
    local Theme = config.Theme or "SteamDark"
    local FloatIcon = config.FloatIcon or ICONS.Default
    local LoadingConfig = config.Loading or { Stages = {} }

    applyTheme(Theme)

    local Window = { Title = Title, Pages = {}, Tabs = {}, ActiveTab = nil }
    local ROOT_W, ROOT_H = 700, 500
    local TITLE_H, SIDEBAR_W = 56, 190

    local root = mk("CanvasGroup", {
        Name = "Root", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(ROOT_W, ROOT_H), BackgroundColor3 = T.bg, BackgroundTransparency = 0,
        BorderSizePixel = 0, ClipsDescendants = true, GroupTransparency = 1, Visible = false, Parent = gui,
    })
    corner(root, 22)
    reg(root, "BackgroundColor3", "bg")
    stroke(root, T.stroke, 1.5, 0.3)

    local uiScale = mk("UIScale", { Scale = getAdaptiveScale(), Parent = root })

    local titleBar = mk("Frame", { Name = "TitleBar", Size = UDim2.new(1, 0, 0, TITLE_H), BackgroundTransparency = 1, Active = true, ZIndex = 2, Parent = root })
    local titleLbl = mk("TextLabel", { Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -200, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = Title, TextSize = 17, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = titleBar })
    reg(titleLbl, "TextColor3", "text")

    local function windowGlyph(glyph, baseKey, brightKey, xOffset)
        local btn = mk("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, xOffset, 0.5, 0), Size = UDim2.fromOffset(36, 36), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = titleBar })
        local lbl = mk("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = glyph, TextColor3 = T[baseKey], Font = Enum.Font.GothamBold, TextSize = 22, Parent = btn })
        btn.MouseEnter:Connect(function() playHover(); TweenService:Create(lbl, Tw.fast, { TextColor3 = T[brightKey] }):Play() end)
        btn.MouseLeave:Connect(function() TweenService:Create(lbl, Tw.fast, { TextColor3 = T[baseKey] }):Play() end)
        btn.MouseButton1Down:Connect(function() playSound("click") end)
        return btn
    end

    local btnMin = windowGlyph("−", "textDim", "text", -62)
    local btnClose = windowGlyph("×", "textDim", "redBright", -20)

    local sidebar = mk("Frame", { Name = "Sidebar", Position = UDim2.fromOffset(0, TITLE_H), Size = UDim2.new(0, SIDEBAR_W, 1, -TITLE_H), BackgroundColor3 = T.sidebar, BackgroundTransparency = 0, BorderSizePixel = 0, ZIndex = 2, Parent = root })
    reg(sidebar, "BackgroundColor3", "sidebar")

    local sidebarScroll = mk("ScrollingFrame", {
        Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.stroke, ScrollBarImageTransparency = 0.5,
        CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, Parent = sidebar,
    })
    mk("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = sidebarScroll })
    mk("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = sidebarScroll })

    local scrollHideTask
    sidebarScroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
        sidebarScroll.ScrollBarImageTransparency = 0.1
        if scrollHideTask then task.cancel(scrollHideTask) end
        scrollHideTask = task.delay(0.8, function() TweenService:Create(sidebarScroll, Tw.med, { ScrollBarImageTransparency = 0.9 }):Play() end)
    end)
    sidebarScroll.ScrollBarImageTransparency = 0.9

    local content = mk("Frame", { Name = "Content", Position = UDim2.fromOffset(SIDEBAR_W, TITLE_H), Size = UDim2.new(1, -SIDEBAR_W, 1, -TITLE_H), BackgroundColor3 = T.content, BackgroundTransparency = 0, ClipsDescendants = true, BorderSizePixel = 0, ZIndex = 2, Parent = root })
    reg(content, "BackgroundColor3", "content")

    local function refreshSidebar()
        for id, data in pairs(Window.Tabs) do
            local active = (id == Window.ActiveTab)
            data.btn.BackgroundColor3 = active and T.activePill or T.sidebar
            data.btn.BackgroundTransparency = active and 0 or 1
            data.lbl.TextColor3 = active and T.text or T.textDim
            data.ico.ImageColor3 = active and T.text or T.textDim
        end
    end

    local function clampRootPosition()
        local vp = workspace.CurrentCamera.ViewportSize
        local sz = root.AbsoluteSize
        if sz.X <= 0 or sz.Y <= 0 then return end
        local cx, cy = root.Position.X.Scale * vp.X + root.Position.X.Offset, root.Position.Y.Scale * vp.Y + root.Position.Y.Offset
        local halfW, halfH = sz.X / 2, sz.Y / 2
        root.Position = UDim2.new(0, math.clamp(cx, halfW, vp.X - halfW), 0, math.clamp(cy, halfH, vp.Y - halfH))
    end

    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        local s = getAdaptiveScale()
        TweenService:Create(uiScale, Tw.fast, { Scale = s }):Play()
        task.wait(0.05)
        clampRootPosition()
    end)

    -- ============================================================
    --  FLOATING ISLAND
    -- ============================================================
    local floatBtn = mk("TextButton", {
        Name = "FloatToggle", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14),
        Size = UDim2.fromOffset(108, 44), BackgroundColor3 = T.card, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Visible = false, ZIndex = 10, Parent = gui,
    })
    corner(floatBtn, 22)
    local fStroke = stroke(floatBtn, T.accent, 1.5, 1)
    reg(fStroke, "Color", "accent")

    local floatIcon = mk("ImageLabel", { Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 16, 0.5, 0), BackgroundTransparency = 1, Image = FloatIcon, ImageColor3 = T.accent, ZIndex = 11, Parent = floatBtn })
    local floatText = mk("TextLabel", { Position = UDim2.fromOffset(46, 0), Size = UDim2.new(1, -50, 1, 0), BackgroundTransparency = 1, Text = Title, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11, Parent = floatBtn })
    reg(floatText, "TextColor3", "text")
    local floatScale = mk("UIScale", { Scale = 1, Parent = floatBtn })

    task.spawn(function()
        while floatBtn.Parent do
            TweenService:Create(fStroke, TweenInfo.new(1.5, Enum.EasingStyle.Sine), { Transparency = 0.6 }):Play()
            task.wait(1.5)
            if not floatBtn.Parent then break end
            TweenService:Create(fStroke, TweenInfo.new(1.5, Enum.EasingStyle.Sine), { Transparency = 0.1 }):Play()
            task.wait(1.5)
        end
    end)

    floatBtn.MouseEnter:Connect(function() playHover(); TweenService:Create(floatBtn, Tw.fast, { BackgroundColor3 = T.cardHover }):Play() end)
    floatBtn.MouseLeave:Connect(function() TweenService:Create(floatBtn, Tw.fast, { BackgroundColor3 = T.card }):Play() end)

    local hidden, toggling, loaded = false, false, false
    local lastPos = UDim2.fromScale(0.5, 0.5)

    local function toggleUI()
        if not loaded or toggling then return end
        toggling = true
        playSound("toggle")
        TweenService:Create(floatScale, Tw.pressDown, { Scale = 0.9 }):Play()
        task.delay(0.1, function() TweenService:Create(floatScale, Tw.pressUp, { Scale = 1 }):Play() end)
        
        local btnCenter = floatBtn.AbsolutePosition + floatBtn.AbsoluteSize * 0.5
        if not hidden then
            lastPos = root.Position
            local t = TweenService:Create(root, Tw.slow, { Position = UDim2.fromOffset(btnCenter.X, btnCenter.Y), GroupTransparency = 1 })
            TweenService:Create(uiScale, Tw.slow, { Scale = 0.05 }):Play()
            t:Play()
            t.Completed:Connect(function()
                root.Visible = false; hidden = true; toggling = false
                floatIcon.Rotation = 180
                floatText.Text = "Show"
            end)
        else
            root.Visible = true; root.Position = UDim2.fromOffset(btnCenter.X, btnCenter.Y); root.GroupTransparency = 1; uiScale.Scale = 0.05
            local t = TweenService:Create(root, Tw.slow, { Position = lastPos, GroupTransparency = 0 })
            TweenService:Create(uiScale, Tw.slow, { Scale = getAdaptiveScale() }):Play()
            t:Play()
            t.Completed:Connect(function()
                hidden = false; toggling = false
                floatIcon.Rotation = 0
                floatText.Text = Title
            end)
        end
    end

    floatBtn.MouseButton1Click:Connect(toggleUI)
    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.K then toggleUI() end
    end)

    -- ============================================================
    --  MINIMIZE & CLOSE
    -- ============================================================
    local minimized = false
    btnMin.MouseButton1Click:Connect(function()
        if toggling or hidden then return end
        minimized = not minimized
        TweenService:Create(root, Tw.med, { Size = minimized and UDim2.fromOffset(ROOT_W, TITLE_H) or UDim2.fromOffset(ROOT_W, ROOT_H) }):Play()
        task.delay(0.3, function() clampRootPosition() end)
    end)

    local confirmOverlay = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Visible = false, ZIndex = 20, Parent = root })
    local confirmBox = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(340, 160), BackgroundColor3 = T.card, BackgroundTransparency = 0, ZIndex = 21, Parent = confirmOverlay })
    corner(confirmBox, 20)
    stroke(confirmBox, T.red, 1.5, 0.3)
    reg(confirmBox, "BackgroundColor3", "card")

    mk("ImageLabel", { Position = UDim2.fromOffset(20, 20), Size = UDim2.fromOffset(32, 32), BackgroundTransparency = 1, Image = ICONS.Warning, ImageColor3 = T.red, Parent = confirmBox })
    mk("TextLabel", { Position = UDim2.fromOffset(64, 22), Size = UDim2.new(1, -70, 0, 24), BackgroundTransparency = 1, Text = "Close Interface?", Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = confirmBox })
    mk("TextLabel", { Position = UDim2.fromOffset(64, 48), Size = UDim2.new(1, -70, 0, 20), BackgroundTransparency = 1, Text = "You'll need to re-execute the script.", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.textDim, TextXAlignment = Enum.TextXAlignment.Left, Parent = confirmBox })

    local btnYes = mk("TextButton", { Position = UDim2.fromOffset(20, 100), Size = UDim2.fromOffset(140, 40), BackgroundColor3 = T.red, BackgroundTransparency = 0, Text = "Yes, close", Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = T.text, AutoButtonColor = false, Parent = confirmBox })
    corner(btnYes, 12)
    hoverEffect(btnYes, T.redBright, T.red)
    btnYes.MouseButton1Down:Connect(function() playSound("click") end)

    local btnNo = mk("TextButton", { Position = UDim2.fromOffset(180, 100), Size = UDim2.fromOffset(140, 40), BackgroundColor3 = T.cardHover, BackgroundTransparency = 0, Text = "Cancel", Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = T.text, AutoButtonColor = false, Parent = confirmBox })
    corner(btnNo, 12)
    hoverEffect(btnNo, T.card, T.cardHover)
    btnNo.MouseButton1Down:Connect(function() playSound("click") end)

    btnClose.MouseButton1Click:Connect(function()
        if toggling then return end
        confirmOverlay.Visible = true; confirmOverlay.BackgroundTransparency = 1
        TweenService:Create(confirmOverlay, Tw.fast, { BackgroundTransparency = 0.45 }):Play()
        confirmBox.Size = UDim2.fromOffset(0, 0)
        TweenService:Create(confirmBox, Tw.med, { Size = UDim2.fromOffset(340, 160) }):Play()
    end)

    btnNo.MouseButton1Click:Connect(function()
        local t = TweenService:Create(confirmOverlay, Tw.fast, { BackgroundTransparency = 1 })
        t:Play(); t.Completed:Connect(function() confirmOverlay.Visible = false end)
    end)

    local function destroyUI()
        loaded = false
        playSound("close")
        TweenService:Create(uiScale, Tw.med, { Scale = 0.88 }):Play()
        TweenService:Create(floatBtn, Tw.fast, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(floatIcon, Tw.fast, { ImageTransparency = 1 }):Play()
        TweenService:Create(floatText, Tw.fast, { TextTransparency = 1 }):Play()
        local t = TweenService:Create(root, Tw.med, { GroupTransparency = 1 })
        t:Play(); t.Completed:Connect(function() gui:Destroy() end)
    end

    btnYes.MouseButton1Click:Connect(function()
        confirmOverlay.Visible = false
        destroyUI()
    end)

