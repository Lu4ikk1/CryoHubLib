-- ============================================================
--  CRYOHUB — STEAM EDITION (Loadable Library Version)
-- ============================================================

local CryoHub = {}
CryoHub.__index = CryoHub

function CryoHub.Load(userConfig)
    local Players           = game:GetService("Players")
    local TweenService      = game:GetService("TweenService")
    local UserInputService  = game:GetService("UserInputService")
    local SoundService      = game:GetService("SoundService")

    local player = Players.LocalPlayer
    local pg = player:WaitForChild("PlayerGui")

    -- ============================================================
    --  КОНФИГ (Настройки загрузки)
    -- ============================================================
    local CONFIG = {
        UIMode            = "window",
        Theme             = "SteamDark",
        FloatIcon         = "rbxassetid://10709752035",
        FloatIconClosed   = nil,
        FloatIconSize     = 22,
        FloatIconColor    = nil,
        LoadingIcon       = "rbxassetid://10709752035",
        LoadingIconSize   = 34,
        LoadingIconColor  = nil,
        LoadingHasGlow    = true,
        SoundEnabled      = true,
        
        LoadingStages = {
            { text = "Initializing...", duration = 0.5 },
            { text = "Bypassing Anti-Cheat...", callback = function()
                task.wait(1.2) 
            end },
            { text = "Loading libraries...", duration = 0.8 },
            { text = "Loading modules...", callback = function()
                task.wait(1.0)
            end },
            { text = "Preparing interface...", duration = 0.6 },
            { text = "Almost ready...", duration = 0.4 },
            { text = "Done.", duration = 0.2 },
        }
    }

    if type(userConfig) == "table" then
        for k, v in pairs(userConfig) do
            CONFIG[k] = v
        end
    end

    -- ============================================================
    --  ЗВУКИ
    -- ============================================================
    local sounds = {}
    local function makeSound(name, id, vol)
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://" .. id
        s.Volume = vol
        s.Parent = SoundService
        sounds[name] = s
    end
    makeSound("click",   "6895079853",        0.4)
    makeSound("hover",   "107511012621133",   0.25)
    makeSound("close",   "97375206361343",    0.3)
    makeSound("notify",  "71730540025978",    0.4)
    makeSound("toggle",  "128389255905279",   0.4)
    makeSound("slider",  "121370732132760",   0.6)

    local lastHoverTime = 0
    local lastSliderSoundTime = 0
    local function playSound(name)
        if not CONFIG.SoundEnabled then return end
        local s = sounds[name]
        if s then s:Stop(); s:Play() end
    end
    local function playHover()
        if not CONFIG.SoundEnabled then return end
        local now = os.clock()
        if now - lastHoverTime < 0.06 then return end
        lastHoverTime = now
        playSound("hover")
    end
    local function playSliderTick()
        if not CONFIG.SoundEnabled then return end
        local now = os.clock()
        if now - lastSliderSoundTime < 0.05 then return end
        lastSliderSoundTime = now
        playSound("slider")
    end

    -- ============================================================
    --  ТЕМЫ
    -- ============================================================
    local THEMES = {
        SteamDark = {
            bg = Color3.fromRGB(23, 26, 33), sidebar = Color3.fromRGB(27, 30, 38),
            content = Color3.fromRGB(32, 35, 44), card = Color3.fromRGB(42, 46, 56),
            cardHover = Color3.fromRGB(52, 57, 70),
            activePill = Color3.fromRGB(60, 63, 77),
            stroke = Color3.fromRGB(61, 63, 71), text = Color3.fromRGB(224, 228, 235),
            textDim = Color3.fromRGB(150, 155, 165), accent = Color3.fromRGB(102, 192, 244),
            accentBright = Color3.fromRGB(135, 210, 255), onAccent = Color3.fromRGB(23, 26, 33),
            red = Color3.fromRGB(235, 100, 98), redBright = Color3.fromRGB(255, 130, 130),
            success = Color3.fromRGB(116, 199, 108),
            toggleOff = Color3.fromRGB(30, 34, 43),
            toggleKnobOff = Color3.fromRGB(150, 155, 165),
            toggleKnobOn = Color3.fromRGB(23, 26, 33),
        },
        SteamMidnight = {
            bg = Color3.fromRGB(15, 17, 22), sidebar = Color3.fromRGB(19, 21, 26),
            content = Color3.fromRGB(22, 24, 30), card = Color3.fromRGB(30, 33, 40),
            cardHover = Color3.fromRGB(40, 44, 54),
            activePill = Color3.fromRGB(45, 49, 60),
            stroke = Color3.fromRGB(40, 43, 50), text = Color3.fromRGB(240, 242, 245),
            textDim = Color3.fromRGB(130, 135, 145), accent = Color3.fromRGB(102, 192, 244),
            accentBright = Color3.fromRGB(150, 220, 255), onAccent = Color3.fromRGB(15, 17, 22),
            red = Color3.fromRGB(220, 90, 90), redBright = Color3.fromRGB(245, 120, 120),
            success = Color3.fromRGB(100, 180, 95),
            toggleOff = Color3.fromRGB(22, 25, 31),
            toggleKnobOff = Color3.fromRGB(120, 125, 135),
            toggleKnobOn = Color3.fromRGB(15, 17, 22),
        },
        SteamLight = {
            bg = Color3.fromRGB(238, 238, 244), sidebar = Color3.fromRGB(228, 228, 236),
            content = Color3.fromRGB(245, 245, 250), card = Color3.fromRGB(222, 222, 232),
            cardHover = Color3.fromRGB(212, 212, 224),
            activePill = Color3.fromRGB(200, 200, 215),
            stroke = Color3.fromRGB(200, 200, 210), text = Color3.fromRGB(28, 30, 36),
            textDim = Color3.fromRGB(100, 105, 115), accent = Color3.fromRGB(60, 130, 200),
            accentBright = Color3.fromRGB(40, 110, 180), onAccent = Color3.fromRGB(255, 255, 255),
            red = Color3.fromRGB(210, 70, 70), redBright = Color3.fromRGB(190, 50, 50),
            success = Color3.fromRGB(50, 150, 70),
            toggleOff = Color3.fromRGB(196, 196, 208),
            toggleKnobOff = Color3.fromRGB(120, 120, 130),
            toggleKnobOn = Color3.fromRGB(255, 255, 255),
        },
    }

    local currentTheme = CONFIG.Theme
    local T = THEMES[currentTheme]

    local Tw = {
        fast  = TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        med   = TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        slow  = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        pressDown = TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        pressUp   = TweenInfo.new(0.32, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out),
        water = TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        waterIn = TweenInfo.new(0.65, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
    }

    local ICONS = {
        Toggle = "rbxassetid://10709752035", Slider = "rbxassetid://10709810948",
        Input  = "rbxassetid://10709751939", Drop = "rbxassetid://10734941354",
        Button = "rbxassetid://10709810814", Theme = "rbxassetid://10709810948",
        Config = "rbxassetid://10709752035", Info = "rbxassetid://10709751939",
        Keybind = "rbxassetid://10709752035", Color = "rbxassetid://10734941354",
        Check = "rbxassetid://10709752035", Warning = "rbxassetid://10709752035",
    }

    local TABS = {
        { id="toggles",  label="Toggles",   icon=ICONS.Toggle },
        { id="sliders",  label="Sliders",   icon=ICONS.Slider },
        { id="inputs",   label="Inputs",    icon=ICONS.Input },
        { id="dropdowns",label="Dropdowns", icon=ICONS.Drop },
        { id="buttons",  label="Buttons",   icon=ICONS.Button },
        { id="keybinds", label="Keybinds",  icon=ICONS.Keybind },
        { id="colors",   label="Colors",    icon=ICONS.Color },
        { id="themes",   label="Themes",    icon=ICONS.Theme },
        { id="config",   label="Config",    icon=ICONS.Config },
        { id="info",     label="Info",      icon=ICONS.Info },
    }

    local function mk(class, props)
        local o = Instance.new(class)
        for k, v in pairs(props or {}) do o[k] = v end
        return o
    end

    local function corner(p, r) return mk("UICorner", { CornerRadius = UDim.new(0, r or 16), Parent = p }) end

    local function stroke(p, c, t, tr)
        return mk("UIStroke", {
            Color = c or T.stroke, Thickness = t or 1.4, Transparency = tr or 0,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p,
        })
    end

    local function press(btn)
        local s = btn:FindFirstChildOfClass("UIScale") or mk("UIScale", { Scale = 1, Parent = btn })
        btn.MouseButton1Down:Connect(function()
            TweenService:Create(s, Tw.pressDown, { Scale = 0.96 }):Play()
        end)
        btn.MouseButton1Up:Connect(function()
            TweenService:Create(s, Tw.pressUp, { Scale = 1 }):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(s, Tw.fast, { Scale = 1 }):Play()
        end)
    end

    local function hoverEffect(obj, targetColor, baseColor)
        obj.MouseEnter:Connect(function()
            TweenService:Create(obj, Tw.fast, { BackgroundColor3 = targetColor }):Play()
        end)
        obj.MouseLeave:Connect(function()
            TweenService:Create(obj, Tw.fast, { BackgroundColor3 = baseColor }):Play()
        end)
    end

    local function getAdaptiveScale()
        local vp = workspace.CurrentCamera.ViewportSize
        local s = math.min(vp.X / 820, vp.Y / 620, 1)
        return math.max(s, 0.55)
    end

    local regs = {}
    local function reg(el, prop, key)
        regs[#regs + 1] = { el = el, prop = prop, key = key }
    end

    local currentTab = nil
    local sidebarItems = {}
    local refreshSidebarColors

    local function applyTheme(name)
        currentTheme = name
        T = THEMES[name]
        for _, r in ipairs(regs) do
            if r.el and r.el.Parent then
                TweenService:Create(r.el, Tw.med, { [r.prop] = T[r.key] }):Play()
            end
        end
        if refreshSidebarColors then refreshSidebarColors() end
    end

    for _, n in ipairs({"CryoHubUI"}) do
        local o = pg:FindFirstChild(n); if o then o:Destroy() end
    end

    local gui = mk("ScreenGui", {
        Name = "CryoHubUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 999,
        Parent = pg,
    })

    -- ============================================================
    --  УВЕДОМЛЕНИЯ (снизу-справа)
    -- ============================================================
    local notifWrap = mk("Frame", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -20, 1, -20),
        Size = UDim2.fromOffset(340, 0),
        BackgroundTransparency = 1, ZIndex = 5, Parent = gui,
    })
    mk("UIListLayout", {
        Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        Parent = notifWrap,
    })

    local notifOrder = 0
    local function Notify(title, desc, iconId)
        notifOrder += 1
        iconId = iconId or ICONS.Check
        playSound("notify")
        local slot = mk("Frame", {
            Size = UDim2.fromOffset(340, 76), BackgroundTransparency = 1,
            LayoutOrder = notifOrder, Parent = notifWrap,
        })
        local card = mk("Frame", {
            Size = UDim2.fromScale(1, 1), Position = UDim2.new(1, 360, 0, 0),
            BackgroundColor3 = T.card, BackgroundTransparency = 0, Parent = slot,
        })
        corner(card, 16)
        stroke(card, T.stroke, 1.2, 0.35)

        local iconBox = mk("Frame", {
            Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(48, 48),
            BackgroundColor3 = T.activePill, BackgroundTransparency = 0, Parent = card,
        })
        corner(iconBox, 14)
        mk("ImageLabel", {
            Size = UDim2.fromOffset(24, 24),
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            BackgroundTransparency = 1, Image = iconId, ImageColor3 = T.accent, Parent = iconBox,
        })
        mk("TextLabel", {
            Position = UDim2.fromOffset(76, 14), Size = UDim2.new(1, -110, 0, 20),
            BackgroundTransparency = 1, Text = title,
            Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = T.text,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
        })
        mk("TextLabel", {
            Position = UDim2.fromOffset(76, 36), Size = UDim2.new(1, -90, 0, 30),
            BackgroundTransparency = 1, Text = desc,
            Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.textDim,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true, Parent = card,
        })
        local closeBtn = mk("TextButton", {
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10),
            Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1,
            Text = "×", Font = Enum.Font.GothamBold, TextSize = 18,
            TextColor3 = T.textDim, AutoButtonColor = false, Parent = card,
        })
        closeBtn.MouseEnter:Connect(function()
            playHover()
            TweenService:Create(closeBtn, Tw.fast, { TextColor3 = T.text }):Play()
        end)
        closeBtn.MouseLeave:Connect(function()
            TweenService:Create(closeBtn, Tw.fast, { TextColor3 = T.textDim }):Play()
        end)
        closeBtn.MouseButton1Down:Connect(function() playSound("click") end)

        local dismissed = false
        local function dismiss()
            if dismissed then return end
            dismissed = true
            local out = TweenService:Create(card, Tw.med, { Position = UDim2.new(1, 360, 0, 0) })
            out:Play()
            out.Completed:Connect(function() slot:Destroy() end)
        end
        closeBtn.MouseButton1Click:Connect(dismiss)
        TweenService:Create(card, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 0, 0, 0),
        }):Play()
        task.delay(4, dismiss)
    end

    -- ============================================================
    --  ROOT
    -- ============================================================
    local ROOT_W, ROOT_H = 700, 500
    local TITLE_H = 56
    local SIDEBAR_W = 190
    local isPanelMode = (CONFIG.UIMode == "panel")
    local baseScale = getAdaptiveScale()

    local root, content, titleBar
    local pages = {}
    local windowUiScale, windowBtnMin, windowBtnClose, windowPlayIntro
    local clampRootPosition

    if isPanelMode then
        local vp = workspace.CurrentCamera.ViewportSize
        local PANEL_W = math.min(360, vp.X * 0.88)
        local M = 14
        root = mk("CanvasGroup", {
            Name = "Root", AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, PANEL_W, 0, M),
            Size = UDim2.new(0, PANEL_W, 1, -M * 2),
            BackgroundColor3 = T.bg, BackgroundTransparency = 0,
            BorderSizePixel = 0, ClipsDescendants = true, Parent = gui,
        })
        corner(root, 22)
        reg(root, "BackgroundColor3", "bg")
        stroke(root, T.stroke, 1.5, 0.5)

        titleBar = mk("Frame", {
            Size = UDim2.new(1, 0, 0, TITLE_H),
            BackgroundTransparency = 1, ZIndex = 2, Parent = root,
        })
        local titleLbl = mk("TextLabel", {
            Position = UDim2.fromOffset(20, 0), Size = UDim2.new(1, -80, 1, 0),
            BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
            Text = "CryoHub", TextSize = 17, TextColor3 = T.text,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = titleBar,
        })
        reg(titleLbl, "TextColor3", "text")

        local tabStrip = mk("ScrollingFrame", {
            Position = UDim2.fromOffset(0, TITLE_H), Size = UDim2.new(1, 0, 0, 50),
            BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 3, ScrollBarImageColor3 = T.stroke, ScrollBarImageTransparency = 0.5,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.X,
            ScrollingDirection = Enum.ScrollingDirection.X, Parent = root,
        })
        mk("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Center, Parent = tabStrip,
        })
        mk("UIPadding", {
            PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14),
            PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = tabStrip,
        })

        for i, cfg in ipairs(TABS) do
            local item = mk("TextButton", {
                Size = UDim2.fromOffset(80, 38), BackgroundColor3 = T.content,
                BackgroundTransparency = 0, Text = "", AutoButtonColor = false,
                LayoutOrder = i, Parent = tabStrip,
            })
            corner(item, 19)
            press(item)
            local ico = mk("ImageLabel", {
                Position = UDim2.fromOffset(10, 11), Size = UDim2.fromOffset(16, 16),
                BackgroundTransparency = 1, Image = cfg.icon, ImageColor3 = T.textDim, Parent = item,
            })
            local lbl = mk("TextLabel", {
                Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -34, 1, 0),
                BackgroundTransparency = 1, Text = cfg.label,
                TextColor3 = T.textDim, Font = Enum.Font.GothamMedium,
                TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = item,
            })
            item.MouseEnter:Connect(function()
                playHover()
                if currentTab ~= cfg.id then
                    TweenService:Create(item, Tw.fast, { BackgroundColor3 = T.cardHover }):Play()
                end
            end)
            item.MouseLeave:Connect(function()
                if currentTab ~= cfg.id then
                    TweenService:Create(item, Tw.fast, { BackgroundColor3 = T.content }):Play()
                end
            end)
            item.MouseButton1Down:Connect(function() playSound("click") end)
            sidebarItems[cfg.id] = { btn = item, ico = ico, lbl = lbl, baseColor = T.content }
        end

        content = mk("Frame", {
            Position = UDim2.fromOffset(0, TITLE_H + 50),
            Size = UDim2.new(1, 0, 1, -TITLE_H - 50),
            BackgroundTransparency = 1, ClipsDescendants = true,
            BorderSizePixel = 0, Parent = root,
        })

        refreshSidebarColors = function()
            for tid, el in pairs(sidebarItems) do
                local active = (tid == currentTab)
                el.btn.BackgroundColor3 = active and T.activePill or (el.baseColor or T.content)
                el.lbl.TextColor3       = active and T.text or T.textDim
                el.ico.ImageColor3      = active and T.text or T.textDim
            end
        end

        local handle = mk("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0),
            Size = UDim2.fromOffset(14, 84), BackgroundColor3 = T.accent,
            BackgroundTransparency = 0.15, Text = "", AutoButtonColor = false,
            ZIndex = 15, Parent = gui,
        })
        corner(handle, 7)
        stroke(handle, T.stroke, 1, 0.5)
        local handleIcon = mk("TextLabel", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            Text = "‹", Font = Enum.Font.GothamBold, TextSize = 16,
            TextColor3 = T.bg, Parent = handle,
        })

        local panelOpen = false
        local function openPanel()
            if panelOpen then return end
            panelOpen = true
            playSound("toggle")
            TweenService:Create(root, Tw.waterIn, {
                Position = UDim2.new(1, -M, 0, M),
            }):Play()
            handleIcon.Text = "›"
        end
        local function closePanel()
            if not panelOpen then return end
            panelOpen = false
            playSound("toggle")
            TweenService:Create(root, Tw.water, {
                Position = UDim2.new(1, PANEL_W, 0, M),
            }):Play()
            handleIcon.Text = "‹"
        end
        local function togglePanel()
            if panelOpen then closePanel() else openPanel() end
        end
        handle.MouseButton1Click:Connect(togglePanel)

        local swipeStartX = nil
        UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.Touch then
                local pos = UserInputService:GetMouseLocation()
                local vp2 = workspace.CurrentCamera.ViewportSize
                if pos.X > vp2.X - 60 then swipeStartX = pos.X end
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not swipeStartX then return end
            if input.UserInputType == Enum.UserInputType.Touch then
                local pos = UserInputService:GetMouseLocation()
                local delta = pos.X - swipeStartX
                if not panelOpen and delta < -50 then openPanel(); swipeStartX = nil
                elseif panelOpen and delta > 50 then closePanel(); swipeStartX = nil end
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then swipeStartX = nil end
        end)
        UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.KeyCode == Enum.KeyCode.K then togglePanel() end
        end)

        windowPlayIntro = function()
            task.delay(0.4, function()
                Notify("Panel Ready", "Swipe right edge or tap handle.", ICONS.Check)
            end)
        end
    else
        root = mk("CanvasGroup", {
            Name = "Root",
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(ROOT_W, ROOT_H),
            BackgroundColor3 = T.bg, BackgroundTransparency = 0,
            BorderSizePixel = 0, ClipsDescendants = true,
            GroupTransparency = 1, Visible = false, Parent = gui,
        })
        corner(root, 22)
        reg(root, "BackgroundColor3", "bg")
        stroke(root, T.stroke, 1.5, 0.3)

        windowUiScale = mk("UIScale", { Scale = baseScale, Parent = root })

        titleBar = mk("Frame", {
            Name = "TitleBar", Size = UDim2.new(1, 0, 0, TITLE_H),
            BackgroundTransparency = 1, Active = true, ZIndex = 2, Parent = root,
        })
        local titleLbl = mk("TextLabel", {
            Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -200, 1, 0),
            BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
            Text = "CryoHub", TextSize = 17, TextColor3 = T.text,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = titleBar,
        })
        reg(titleLbl, "TextColor3", "text")

        local function windowGlyph(glyph, baseKey, brightKey, xOffset)
            local btn = mk("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, xOffset, 0.5, 0),
                Size = UDim2.fromOffset(36, 36), BackgroundTransparency = 1,
                Text = "", AutoButtonColor = false, Parent = titleBar,
            })
            local lbl = mk("TextLabel", {
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                Text = glyph, TextColor3 = T[baseKey],
                Font = Enum.Font.GothamBold, TextSize = 22, Parent = btn,
            })
            btn.MouseEnter:Connect(function()
                playHover()
                TweenService:Create(lbl, Tw.fast, { TextColor3 = T[brightKey] }):Play()
            end)
            btn.MouseLeave:Connect(function()
                TweenService:Create(lbl, Tw.fast, { TextColor3 = T[baseKey] }):Play()
            end)
            btn.MouseButton1Down:Connect(function() playSound("click") end)
            return btn
        end

        windowBtnMin = windowGlyph("−", "textDim", "text", -62)
        windowBtnClose = windowGlyph("×", "textDim", "redBright", -20)

        local sidebar = mk("Frame", {
            Name = "Sidebar", Position = UDim2.fromOffset(0, TITLE_H),
            Size = UDim2.new(0, SIDEBAR_W, 1, -TITLE_H),
            BackgroundColor3 = T.sidebar, BackgroundTransparency = 0,
            BorderSizePixel = 0, ZIndex = 2, Parent = root,
        })
        reg(sidebar, "BackgroundColor3", "sidebar")

        local sidebarScroll = mk("ScrollingFrame", {
            Position = UDim2.fromOffset(0, 0),
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 3, ScrollBarImageColor3 = T.stroke, ScrollBarImageTransparency = 0.5,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y, Parent = sidebar,
