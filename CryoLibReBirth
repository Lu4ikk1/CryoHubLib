            Name = "Content", Position = UDim2.fromOffset(SIDEBAR_W, TITLE_H),
            Size = UDim2.new(1, -SIDEBAR_W, 1, -TITLE_H),
            BackgroundColor3 = T.content, BackgroundTransparency = 0,
            ClipsDescendants = true, BorderSizePixel = 0, ZIndex = 2, Parent = root,
        })
        reg(content, "BackgroundColor3", "content")

        refreshSidebarColors = function()
            for tid, el in pairs(sidebarItems) do
                local active = (tid == currentTab)
                el.btn.BackgroundColor3 = active and T.activePill or T.sidebar
                el.btn.BackgroundTransparency = active and 0 or 1
                el.lbl.TextColor3       = active and T.text or T.textDim
                el.ico.ImageColor3      = active and T.text or T.textDim
            end
        end

        clampRootPosition = function()
            local vp = workspace.CurrentCamera.ViewportSize
            local sz = root.AbsoluteSize
            if sz.X <= 0 or sz.Y <= 0 then return end
            local cx = root.Position.X.Scale * vp.X + root.Position.X.Offset
            local cy = root.Position.Y.Scale * vp.Y + root.Position.Y.Offset
            local halfW, halfH = sz.X / 2, sz.Y / 2
            local clampedX = math.clamp(cx, halfW, vp.X - halfW)
            local clampedY = math.clamp(cy, halfH, vp.Y - halfH)
            root.Position = UDim2.new(0, clampedX, 0, clampedY)
        end

        workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            local s = getAdaptiveScale()
            if windowUiScale then TweenService:Create(windowUiScale, Tw.fast, { Scale = s }):Play() end
            task.wait(0.05)
            clampRootPosition()
        end)
    end

