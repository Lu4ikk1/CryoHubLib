local T = Themes.SteamDark
local CurrentTheme = "SteamDark"
local Regs = {} -- Реестр для смены тем
local function reg(el, prop, key)
    table.insert(Regs, { el = el, prop = prop, key = key })
end

local function applyTheme(name)
    if not Themes[name] then return end
    CurrentTheme = name
    T = Themes[name]
    for _, r in ipairs(Regs) do
        if r.el and r.el.Parent then
            TweenService:Create(r.el, TweenInfo.new(0.28), { [r.prop] = T[r.key] }):Play()
        end
    end
end

