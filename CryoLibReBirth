    mk("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = sidebarScroll })

    -- ✅ УБРАН corner(content, 16) - теперь root обрезает нижние углы идеально
    local content = mk("Frame", { Name = "Content", Position = UDim2.fromOffset(SIDEBAR_W, TITLE_H), Size = UDim2.new(1, -SIDEBAR_W, 1, -TITLE_H), BackgroundColor3 = T.content, BackgroundTransparency = 0, ClipsDescendants = true, BorderSizePixel = 0, ZIndex = 2, Parent = root })
    reg(content, "BackgroundColor3", "content")

    local Window = { Pages = {}, Tabs = {}, ActiveTab = nil, _sidebarItems = {}, _sidebar = sidebar, _content = content }

    local function refreshSidebarColors()
        for tid, el in pairs(Window._sidebarItems) do
            local active = (tid == Window.ActiveTab)
            el.btn.BackgroundColor3 = active and T.activePill or T.sidebar
            el.btn.BackgroundTransparency = active and 0 or 1
            el.lbl.TextColor3 = active and T.text or T.textDim
            el.ico.ImageColor3 = active and T.text or T.textDim
        end
    end
    onThemeChange(refreshSidebarColors)

    local function switchTab(id)
        if Window.ActiveTab == id then return end
        Window.ActiveTab = id
        refreshSidebarColors()
        for pid, page in pairs(Window.Pages) do
            if pid == id then
                page.Visible = true
                page.Position = UDim2.fromOffset(8, 0)
                TweenService:Create(page, Tw.med, { Position = UDim2.fromOffset(0, 0) }):Play()
            else
                page.Visible = false
