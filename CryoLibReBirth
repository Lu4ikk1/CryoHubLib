function Library:CreateWindow(config)
    config = config or {}
    local Title          = config.Title or "CryoHub"
    local FloatIcon      = config.FloatIcon or ICONS.Default
    local LoadingStages  = config.LoadingStages or {
        { text = "Initializing...", duration = 0.4 },
        { text = "Preparing interface...", duration = 0.4 },
        { text = "Ready.", duration = 0.2 },
    }
    local InitialTheme   = config.Theme or "SteamDark"

    ensureGui(); ensureNotifWrap()
    applyTheme(InitialTheme)

    local ROOT_W, ROOT_H = 700, 500
    local TITLE_H, SIDEBAR_W = 56, 190
    local baseScale = getAdaptiveScale()

    -- Root: Frame (ClipsDescendants = true for rounded corners)
    local root = mk("Frame", {
        Name = "Root", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55),
        Size = UDim2.fromOffset(ROOT_W, ROOT_H), BackgroundColor3 = T.bg,
