    for _, g in ipairs({{ size = 220, x = 140, y = 80, trans = 0.96 }, { size = 160, x = 200, y = 120, trans = 0.94 }, { size = 100, x = 300, y = 130, trans = 0.92 }}) do
        local glow = mk("Frame", { Position = UDim2.fromOffset(g.x, g.y), Size = UDim2.fromOffset(g.size, g.size), BackgroundColor3 = T.accent, BackgroundTransparency = g.trans, BorderSizePixel = 0, ZIndex = 201, Parent = decorHolder })
