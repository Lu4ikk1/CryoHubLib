    mk("TextLabel", { Position = UDim2.fromOffset(76, 14), Size = UDim2.new(1, -110, 0, 20), BackgroundTransparency = 1, Text = title, FontFace = FontBold, TextSize = 14, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
    mk("TextLabel", { Position = UDim2.fromOffset(76, 36), Size = UDim2.new(1, -90, 0, 30), BackgroundTransparency = 1, Text = desc, FontFace = FontRegular, TextSize = 12, TextColor3 = T.textDim, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Parent = card })

    local closeBtn = mk("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, Text = "×", FontFace = FontBold, TextSize = 18, TextColor3 = T.textDim, AutoButtonColor = false, Parent = card })
    closeBtn.MouseButton1Click:Connect(function() slot:Destroy() end)
    
    -- ✅ Новая анимация выезда уведомления (пружинистая)
    TweenService:Create(card, Tw.notifyIn, { Position = UDim2.new(0, 0, 0, 0) }):Play()
    task.delay(duration, function() if slot.Parent then slot:Destroy() end end)
end

