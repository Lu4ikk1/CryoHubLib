    playSound("notify")

    local slot = mk("Frame", { Size = UDim2.fromOffset(340, 76), BackgroundTransparency = 1, LayoutOrder = notifOrder, Parent = notifWrap })
    local card = mk("Frame", { Size = UDim2.fromScale(1, 1), Position = UDim2.new(1, 360, 0, 0), BackgroundColor3 = T.card, BackgroundTransparency = 0, Parent = slot })
    corner(card, 16); stroke(card, T.stroke, 1.2, 0.35)

    local iconBox = mk("Frame", { Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(48, 48), BackgroundColor3 = T.activePill, BackgroundTransparency = 0, Parent = card })
    corner(iconBox, 14)
