local function mk(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    return o
end

local function corner(p, r) return mk("UICorner", { CornerRadius = UDim.new(0, r or 16), Parent = p }) end

local function stroke(p, c, t, tr)
    return mk("UIStroke", {
        Color = c or Color3.fromRGB(61, 63, 71), Thickness = t or 1.4, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p,
    })
end

local function press(btn)
    local s = btn:FindFirstChildOfClass("UIScale") or mk("UIScale", { Scale = 1, Parent = btn })
    btn.MouseButton1Down:Connect(function() TweenService:Create(s, Tw.pressDown, { Scale = 0.96 }):Play() end)
    btn.MouseButton1Up:Connect(function() TweenService:Create(s, Tw.pressUp, { Scale = 1 }):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(s, Tw.fast, { Scale = 1 }):Play() end)
end

local function hoverEffect(obj, targetColor, baseColor)
    obj.MouseEnter:Connect(function() TweenService:Create(obj, Tw.fast, { BackgroundColor3 = targetColor }):Play() end)
    obj.MouseLeave:Connect(function() TweenService:Create(obj, Tw.fast, { BackgroundColor3 = baseColor }):Play() end)
end

local function getAdaptiveScale()
    local vp = workspace.CurrentCamera.ViewportSize
    local s = math.min(vp.X / 820, vp.Y / 620, 1)
    return math.max(s, 0.55)
end

function Library:CreateWindow(config)
    config = config or {}
    local Title = config.Title or "CryoHub"
    local UIMode = config.UIMode or "window"
    local ThemeName = config.Theme or "SteamDark"
    local T = THEMES[ThemeName]

    for _, n in ipairs({"CryoHubUI"}) do
        local o = pg:FindFirstChild(n); if o then o:Destroy() end
    end

    local gui = mk("ScreenGui", {
        Name = "CryoHubUI", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999, Parent = pg,
    })

    -- Уведомления
    local notifWrap = mk("Frame", {
        AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -20),
        Size = UDim2.fromOffset(340, 0), BackgroundTransparency = 1, ZIndex = 5, Parent = gui,
    })
    mk("UIListLayout", {
        Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Bottom, Parent = notifWrap,
    })

    local notifOrder = 0
    local function Notify(title, desc, iconId)
        notifOrder += 1
        iconId = iconId or ICONS.Check
        playSound("notify")
        local slot = mk("Frame", { Size = UDim2.fromOffset(340, 76), BackgroundTransparency = 1, LayoutOrder = notifOrder, Parent = notifWrap })
        local card = mk("Frame", { Size = UDim2.fromScale(1, 1), Position = UDim2.new(1, 360, 0, 0), BackgroundColor3 = T.card, Parent = slot })
        corner(card, 16); stroke(card, T.stroke, 1.2, 0.35)

        local iconBox = mk("Frame", { Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(48, 48), BackgroundColor3 = T.activePill, Parent = card })
        corner(iconBox, 14)
        mk("ImageLabel", { Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Image = iconId, ImageColor3 = T.accent, Parent = iconBox })
        mk("TextLabel", { Position = UDim2.fromOffset(76, 14), Size = UDim2.new(1, -110, 0, 20), BackgroundTransparency = 1, Text = title, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
        mk("TextLabel", { Position = UDim2.fromOffset(76, 36), Size = UDim2.new(1, -90, 0, 30), BackgroundTransparency = 1, Text = desc, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.textDim, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Parent = card })
        
        local closeBtn = mk("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, Text = "×", Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = T.textDim, AutoButtonColor = false, Parent = card })
        closeBtn.MouseButton1Click:Connect(function() slot:Destroy() end)
        TweenService:Create(card, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0, 0, 0, 0) }):Play()
        task.delay(4, function() if slot.Parent then slot:Destroy() end end)
    end
    Library.Notify = Notify

    local ROOT_W, ROOT_H = 700, 500
    local TITLE_H = 56
    local SIDEBAR_W = 190
    local isPanelMode = (UIMode == "panel")
    local baseScale = getAdaptiveScale()

    local root, content, titleBar
    local sidebarItems = {}
    local windowUiScale, windowBtnMin, windowBtnClose, windowPlayIntro, clampRootPosition

    if isPanelMode then
        local vp = workspace.CurrentCamera.ViewportSize
        local PANEL_W = math.min(360, vp.X * 0.88)
        local M = 14
        root = mk("CanvasGroup", {
            Name = "Root", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, PANEL_W, 0, M),
            Size = UDim2.new(0, PANEL_W, 1, -M * 2), BackgroundColor3 = T.bg, BorderSizePixel = 0, ClipsDescendants = true, Parent = gui,
        })
        corner(root, 22); stroke(root, T.stroke, 1.5, 0.5)

        titleBar = mk("Frame", { Size = UDim2.new(1, 0, 0, TITLE_H), BackgroundTransparency = 1, ZIndex = 2, Parent = root })
        mk("TextLabel", { Position = UDim2.fromOffset(20, 0), Size = UDim2.new(1, -80, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = Title, TextSize = 17, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = titleBar })
        
        content = mk("Frame", { Position = UDim2.fromOffset(0, TITLE_H + 50), Size = UDim2.new(1, 0, 1, -TITLE_H - 50), BackgroundTransparency = 1, ClipsDescendants = true, Parent = root })
    else
        root = mk("CanvasGroup", {
            Name = "Root", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(ROOT_W, ROOT_H), BackgroundColor3 = T.bg, BorderSizePixel = 0, ClipsDescendants = true, GroupTransparency = 1, Visible = false, Parent = gui,
        })
        corner(root, 22)
        windowUiScale = mk("UIScale", { Scale = baseScale, Parent = root })

        titleBar = mk("Frame", { Name = "TitleBar", Size = UDim2.new(1, 0, 0, TITLE_H), BackgroundTransparency = 1, Active = true, ZIndex = 3, Parent = root })
        mk("TextLabel", { Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -200, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = Title, TextSize = 17, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = titleBar })

        local function windowGlyph(glyph, baseKey, brightKey, xOffset)
            local btn = mk("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, xOffset, 0.5, 0), Size = UDim2.fromOffset(36, 36), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = titleBar })
            local lbl = mk("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = glyph, TextColor3 = T[baseKey], Font = Enum.Font.GothamBold, TextSize = 22, Parent = btn })
            btn.MouseEnter:Connect(function() playHover(); TweenService:Create(lbl, Tw.fast, { TextColor3 = T[brightKey] }):Play() end)
            btn.MouseLeave:Connect(function() TweenService:Create(lbl, Tw.fast, { TextColor3 = T[baseKey] }):Play() end)
            return btn
        end

        windowBtnMin = windowGlyph("−", "textDim", "text", -62)
        windowBtnClose = windowGlyph("×", "textDim", "redBright", -20)

        local sidebar = mk("Frame", { Name = "Sidebar", Position = UDim2.fromOffset(0, TITLE_H), Size = UDim2.new(0, SIDEBAR_W, 1, -TITLE_H), BackgroundColor3 = T.sidebar, BorderSizePixel = 0, ZIndex = 2, Parent = root })
        local sidebarScroll = mk("ScrollingFrame", { Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.stroke, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = sidebar })
        mk("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = sidebarScroll })
        mk("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = sidebarScroll })

        content = mk("Frame", { Name = "Content", Position = UDim2.fromOffset(SIDEBAR_W, TITLE_H), Size = UDim2.new(1, -SIDEBAR_W, 1, -TITLE_H), BackgroundColor3 = T.content, ClipsDescendants = true, BorderSizePixel = 0, ZIndex = 2, Parent = root })

        local strokeFrame = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 25, Parent = root })
        stroke(strokeFrame, T.stroke, 1.5, 0.3)

        clampRootPosition = function()
            local vp = workspace.CurrentCamera.ViewportSize
            local sz = root.AbsoluteSize
            if sz.X <= 0 or sz.Y <= 0 then return end
            local cx = root.Position.X.Scale * vp.X + root.Position.X.Offset
            local cy = root.Position.Y.Scale * vp.Y + root.Position.Y.Offset
            root.Position = UDim2.new(0, math.clamp(cx, sz.X/2, vp.X - sz.X/2), 0, math.clamp(cy, sz.Y/2, vp.Y - sz.Y/2))
        end
    end

    local Window = { Tabs = {}, ActiveTab = nil, SidebarScroll = sidebarScroll }
    local currentTab = nil
    local pages = {}

    function Window:CreateTab(tabConfig)
        local tabTitle = tabConfig.Title or "Tab"
        local tabIcon = tabConfig.Icon or ICONS.Toggle
        local tabId = tabTitle .. "_" .. tostring(#self.Tabs + 1)
        table.insert(self.Tabs, tabId)

        local item = mk("TextButton", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = T.sidebar, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = #self.Tabs, Parent = self.SidebarScroll })
        corner(item, 23); press(item)
        
        local ico = mk("ImageLabel", { Position = UDim2.fromOffset(18, 12), Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, Image = tabIcon, ImageColor3 = T.textDim, Parent = item })
        local lbl = mk("TextLabel", { Position = UDim2.fromOffset(54, 0), Size = UDim2.new(1, -66, 1, 0), BackgroundTransparency = 1, Text = tabTitle, TextColor3 = T.textDim, Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = item })
        
        sidebarItems[tabId] = { btn = item, ico = ico, lbl = lbl }

        item.MouseEnter:Connect(function() playHover(); if currentTab ~= tabId then TweenService:Create(item, Tw.fast, { BackgroundColor3 = T.cardHover, BackgroundTransparency = 0 }):Play() end end)
        item.MouseLeave:Connect(function() if currentTab ~= tabId then TweenService:Create(item, Tw.fast, { BackgroundTransparency = 1 }):Play() end end)

        local page = mk("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, GroupTransparency = 1, Visible = false, Parent = content })
        local scroll = mk("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = T.stroke, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = page })
        mk("UIPadding", { PaddingTop = UDim.new(0, 22), PaddingBottom = UDim.new(0, 22), PaddingLeft = UDim.new(0, 26), PaddingRight = UDim.new(0, 22), Parent = scroll })
        mk("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
        pages[tabId] = page

        local function switchThisTab()
            if currentTab == tabId then return end
            currentTab = tabId
            playSound("click")
            for tid, el in pairs(sidebarItems) do
                local active = (tid == tabId)
                el.btn.BackgroundColor3 = active and T.activePill or T.sidebar
                el.btn.BackgroundTransparency = active and 0 or 1
                el.lbl.TextColor3 = active and T.text or T.textDim
                el.ico.ImageColor3 = active and T.text or T.textDim
            end
            for pid, p in pairs(pages) do
                if pid == tabId then
                    p.Visible = true; p.GroupTransparency = 1
                    TweenService:Create(p, Tw.med, { GroupTransparency = 0 }):Play()
                else
                    p.Visible = false
                end
            end
        end

        item.MouseButton1Click:Connect(switchThisTab)
        if not currentTab then switchThisTab() end

        local Tab = { Scroll = scroll, Order = 0 }
        
        function Tab:CreateSection(name)
            self.Order += 1
            mk("TextLabel", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = name, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = T.accent, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = self.Order, Parent = scroll })
            self.Order += 1
            
            local group = mk("CanvasGroup", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.card, LayoutOrder = self.Order, ClipsDescendants = true, Parent = scroll })
            corner(group, 16); stroke(group, T.stroke, 1.2, 0.55)
            mk("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = group })

            local Section = { Group = group, NextOrder = 0 }

            local function addSeparator(row)
                mk("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, -36, 0, 1), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 2, Parent = row })
            end

            function Section:CreateToggle(cfg)
                self.NextOrder += 1
                local row = mk("TextButton", { Size = UDim2.new(1, 0, 0, cfg.Description and 62 or 52), BackgroundColor3 = T.card, Text = "", AutoButtonColor = false, LayoutOrder = self.NextOrder, Parent = group })
                hoverEffect(row, T.cardHover, T.card)
                row.MouseEnter:Connect(playHover); row.MouseButton1Down:Connect(function() playSound("click") end)

                mk("TextLabel", { Position = UDim2.fromOffset(18, cfg.Description and 10 or 0), Size = UDim2.new(1, -110, 0, cfg.Description and 22 or 52), BackgroundTransparency = 1, Text = cfg.Title, Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = cfg.Description and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center, Parent = row })
                if cfg.Description then
                    mk("TextLabel", { Position = UDim2.fromOffset(18, 34), Size = UDim2.new(1, -110, 0, 18), BackgroundTransparency = 1, Text = cfg.Description, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.textDim, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
                end

                local track = mk("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -18, 0.5, 0), Size = UDim2.fromOffset(50, 26), BackgroundColor3 = T.toggleOff, Parent = row })
                corner(track, 13)
                local knob = mk("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(3, 0) + UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(20, 20), BackgroundColor3 = T.toggleKnobOff, Parent = track })
                corner(knob, 10)

                local toggled = cfg.Default or false
                if toggled then
                    track.BackgroundColor3 = T.accent; knob.BackgroundColor3 = T.toggleKnobOn
                    knob.Position = UDim2.fromOffset(27, 0) + UDim2.fromScale(0, 0.5)
                end

                row.MouseButton1Click:Connect(function()
                    toggled = not toggled
                    if toggled then
                        TweenService:Create(track, Tw.fast, { BackgroundColor3 = T.accent }):Play()
                        TweenService:Create(knob, Tw.fast, { BackgroundColor3 = T.toggleKnobOn, Position = UDim2.fromOffset(27, 0) + UDim2.fromScale(0, 0.5) }):Play()
                        Notify(cfg.Title, "Enabled", ICONS.Check)
                    else
                        TweenService:Create(track, Tw.fast, { BackgroundColor3 = T.toggleOff }):Play()
                        TweenService:Create(knob, Tw.fast, { BackgroundColor3 = T.toggleKnobOff, Position = UDim2.fromOffset(3, 0) + UDim2.fromScale(0, 0.5) }):Play()
                        Notify(cfg.Title, "Disabled", ICONS.Check)
                    end
                    if cfg.Callback then cfg.Callback(toggled) end
                end)

                if not cfg.IsLast then addSeparator(row) end
                return row
            end

            function Section:CreateButton(cfg)
                self.NextOrder += 1
                local btn = mk("TextButton", { Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = T.card, Text = cfg.Title, Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = cfg.Danger and T.red or T.text, AutoButtonColor = false, LayoutOrder = self.NextOrder, Parent = group })
                hoverEffect(btn, T.cardHover, T.card)
                btn.MouseEnter:Connect(playHover)
                btn.MouseButton1Down:Connect(function() playSound("click") end)
                btn.MouseButton1Click:Connect(function() if cfg.Callback then cfg.Callback() end end)
                if not cfg.IsLast then addSeparator(btn) end
                return btn
            end

            function Section:CreateSlider(cfg)
                self.NextOrder += 1
                local box = mk("Frame", { Size = UDim2.new(1, 0, 0, 76), BackgroundColor3 = T.card, LayoutOrder = self.NextOrder, Parent = group })
                hoverEffect(box, T.cardHover, T.card); box.MouseEnter:Connect(playHover)

                mk("TextLabel", { Position = UDim2.fromOffset(18, 14), Size = UDim2.new(1, -110, 0, 20), BackgroundTransparency = 1, Text = cfg.Title, Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = box })
                local valLbl = mk("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 14), Size = UDim2.fromOffset(70, 20), BackgroundTransparency = 1, Text = tostring(cfg.Default or 50), Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = T.accent, TextXAlignment = Enum.TextXAlignment.Right, Parent = box })

                local trackBg = mk("Frame", { Position = UDim2.fromOffset(18, 52), Size = UDim2.new(1, -36, 0, 6), BackgroundColor3 = T.toggleOff, Parent = box })
                corner(trackBg, 3)
                local fill = mk("Frame", { Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = T.accent, Parent = trackBg })
                corner(fill, 3)
                local knob = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = T.accent, Parent = trackBg })
                corner(knob, 11)

                local min, max = cfg.Min or 0, cfg.Max or 100
                local val = cfg.Default or min
                local hit = mk("TextButton", { Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = "", Parent = box })

                local function update(input)
                    local rel = math.clamp((input.Position.X - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
                    val = math.floor(min + (max - min) * rel)
                    fill.Size = UDim2.fromScale(rel, 1)
                    knob.Position = UDim2.fromScale(rel, 0.5)
                    valLbl.Text = tostring(val)
                    playSliderTick()
                    if cfg.Callback then cfg.Callback(val) end
                end

                hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then update(input) end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                        -- можно добавить отслеживание перемещения ползунка
                    end
                end)

                if not cfg.IsLast then addSeparator(box) end
                return box
            end

            return Section
        end
        return Tab
    end

    if not isPanelMode then
        local floatBtn = mk("TextButton", {
            Name = "FloatToggle", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14),
            Size = UDim2.fromOffset(108, 44), BackgroundColor3 = T.card, Text = "", AutoButtonColor = false, ZIndex = 10, Parent = gui,
        })
        corner(floatBtn, 22)
        local fStroke = stroke(floatBtn, T.accent, 1.5, 0.4)
        mk("ImageLabel", { Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 16, 0.5, 0), BackgroundTransparency = 1, Image = ICONS.Toggle, ImageColor3 = T.accent, Parent = floatBtn })
        mk("TextLabel", { Position = UDim2.fromOffset(46, 0), Size = UDim2.new(1, -50, 1, 0), BackgroundTransparency = 1, Text = "CryoHub", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = floatBtn })

        local hidden = false
        floatBtn.MouseButton1Click:Connect(function()
            hidden = not hidden
            root.Visible = not hidden
            playSound("toggle")
        end)

        windowBtnClose.MouseButton1Click:Connect(function() gui:Destroy() end)
        windowBtnMin.MouseButton1Click:Connect(function()
            root.Size = root.Size.Y.Offset == ROOT_H and UDim2.fromOffset(ROOT_W, TITLE_H) or UDim2.fromOffset(ROOT_W, ROOT_H)
        end)

        task.spawn(function()
            task.wait(0.2)
            root.Visible = true
            TweenService:Create(root, Tw.med, { GroupTransparency = 0 }):Play()
            TweenService:Create(windowUiScale, Tw.med, { Scale = baseScale }):Play()
        end)
    end

    return Window
end

return Library
