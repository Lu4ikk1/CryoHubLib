        })
        corner(iconBox, R.FULL)
        reg(iconBox, "BackgroundColor3", "secondaryContainer")
        mk("ImageLabel", {
            Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1,
            Image = opts.Icon, ImageColor3 = T.onSecondaryContainer, Parent = iconBox,
        })
    end

    local textCol = mk("Frame", {
        Position = UDim2.new(0, opts.Icon and 56 or 14, 0, 14),
        Size = UDim2.new(1, opts.Icon and -70 or -28, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Parent = card,
    })
    local tLbl = mk("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Text = opts.Title or "Notification",
        Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = T.onSurface,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
        Parent = textCol,
    })
    reg(tLbl, "TextColor3", "onSurface")
    if opts.Desc and opts.Desc ~= "" then
        local dLbl = mk("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1, Text = opts.Desc,
            Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = T.onSurfaceVariant,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
            LayoutOrder = 2, Parent = textCol,
        })
        dLbl.Position = UDim2.new(0, 0, 0, 0)
        dLbl.LayoutOrder = 2
        reg(dLbl, "TextColor3", "onSurfaceVariant")
        local lay = mk("UIListLayout", { Padding = UDim.new(0, 2), Parent = textCol })
    end

    local closeBtn = mk("TextButton", {
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8),
        Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1,
        Text = "×", Font = Enum.Font.GothamBold, TextSize = 16,
        TextColor3 = T.onSurfaceVariant, AutoButtonColor = false, ZIndex = 5, Parent = card,
    })
    reg(closeBtn, "TextColor3", "onSurfaceVariant")
    closeBtn.MouseEnter:Connect(function() playHover()
        TweenService:Create(closeBtn, Tw.fast, { TextColor3 = T.onSurface }):Play() end)
    closeBtn.MouseLeave:Connect(function()
        TweenService:Create(closeBtn, Tw.fast, { TextColor3 = T.onSurfaceVariant }):Play() end)

    local barBg = mk("Frame", {
        AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = T.surfaceContainerHighest,
        BorderSizePixel = 0, ZIndex = 2, Parent = card,
    })
    reg(barBg, "BackgroundColor3", "surfaceContainerHighest")
    local barFill = mk("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.primary,
        BorderSizePixel = 0, ZIndex = 3, Parent = barBg,
    })
    reg(barFill, "BackgroundColor3", "primary")
    barBg.ClipsDescendants = true

    local dismissed, hovered = false, false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        local out = TweenService:Create(card, Tw.med, { Position = UDim2.new(1, 380, 0, 0) })
        out:Play()
        out.Completed:Connect(function() slot:Destroy() end)
    end
    closeBtn.MouseButton1Click:Connect(function() playSound("click"); dismiss() end)

    local elapsed, conn = 0, nil
    conn = game:GetService("RunService").Heartbeat:Connect(function(dt)
        if not slot.Parent then conn:Disconnect(); return end
        if not hovered and not dismissed then
            elapsed = elapsed + dt
            barFill.Size = UDim2.fromScale(math.clamp(1 - elapsed / duration, 0, 1), 1)
            if elapsed >= duration then conn:Disconnect(); dismiss() end
        end
    end)
    card.MouseEnter:Connect(function() hovered = true end)
    card.MouseLeave:Connect(function() hovered = false end)

    TweenService:Create(card, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Position = UDim2.new(0, 0, 0, 0) }):Play()
end

