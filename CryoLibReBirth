local lastHoverTime, lastSliderSoundTime = 0, 0
local function playSound(name)
    if not CONFIG.SoundEnabled then return end
    local s = sounds[name]; if s then s:Stop(); s:Play() end
end
local function playHover()
    if not CONFIG.SoundEnabled then return end
    local now = os.clock(); if now - lastHoverTime < 0.06 then return end
    lastHoverTime = now; playSound("hover")
end
local function playSliderTick()
    if not CONFIG.SoundEnabled then return end
    local now = os.clock(); if now - lastSliderSoundTime < 0.05 then return end
    lastSliderSoundTime = now; playSound("slider")
end

