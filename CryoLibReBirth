        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(1, 380, 0, 0),
        BackgroundColor3 = T.surfaceContainerHigh,
        BorderSizePixel = 0,
        Parent = slot,
    })
    corner(card, R.L)
