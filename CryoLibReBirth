--  DEPENDENCIES
-- ============================================================
local function processDependencies()
    for _, dep in ipairs(Library.Dependencies) do
        local parentFlag = Library.Flags[dep.flag]
        if parentFlag and dep.element then
            local isVisible = false
            if type(parentFlag.Value) == "boolean" then isVisible = (parentFlag.Value == dep.value)
            elseif type(parentFlag.Value) == "string" then isVisible = (parentFlag.Value == dep.value)
            elseif type(parentFlag.Value) == "number" then isVisible = (parentFlag.Value >= dep.value) end
            
            if dep.element.Visible ~= isVisible then
                dep.element.Visible = isVisible
                if isVisible then
                    dep.element.Size = UDim2.new(1, 0, 0, 0)
                    TweenService:Create(dep.element, Tw.med, { Size = dep.originalSize }):Play()
                end
            end
        end
    end
end

-- ============================================================
--  ROW MERGE & EDGE ROUNDING LOGIC
-- ============================================================
local function addMasks(row, radius, side)
    local mSize = UDim2.fromOffset(radius, radius)
    local makeMask = function(anchor, posX, posY)
        return mk("Frame", {
            Name = "__cornerMask", AnchorPoint = anchor,
            Position = UDim2.new(posX, 0, posY, 0), Size = mSize,
            BackgroundColor3 = row.BackgroundColor3,
            BackgroundTransparency = row.BackgroundTransparency,
            BorderSizePixel = 0, ZIndex = (row.ZIndex or 1) + 5, Parent = row,
        })
    end
    local masks = {}
    if side == "bottom" then
        table.insert(masks, makeMask(Vector2.new(0, 1), 0, 1))
        table.insert(masks, makeMask(Vector2.new(1, 1), 1, 1))
    else
        table.insert(masks, makeMask(Vector2.new(0, 0), 0, 0))
        table.insert(masks, makeMask(Vector2.new(1, 0), 1, 0))
    end
    row:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
        for _, m in ipairs(masks) do if m.Parent then m.BackgroundColor3 = row.BackgroundColor3 end end
    end)
end

local function addRowSeparator(row)
    local sep = mk("Frame", {
        Name = "__separator",
        AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0),
        Size = UDim2.new(1, -32, 0, 1), BackgroundColor3 = T.stroke,
        BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 2, Parent = row,
    })
    reg(sep, "BackgroundColor3", "stroke")
end

local function applyRowStyle(row, isFirst, isLast)
    local c = row:FindFirstChildOfClass("UICorner"); if c then c:Destroy() end
    for _, m in ipairs(row:GetChildren()) do if m.Name == "__cornerMask" then m:Destroy() end end
    local sep = row:FindFirstChild("__separator"); if sep then sep:Destroy() end

    local radius = 16
    if isFirst and isLast then
        corner(row, radius)
    elseif isFirst then
        corner(row, radius)
        addMasks(row, radius, "bottom")
    elseif isLast then
        corner(row, radius)
        addMasks(row, radius, "top")
    end
    if not isLast then addRowSeparator(row) end
end

local function attachRowTracker(group)
    local function refresh()
        local children = {}
        for _, child in ipairs(group:GetChildren()) do
            if child:GetAttribute("IsRow") then table.insert(children, child) end
        end
        table.sort(children, function(a, b) return a.LayoutOrder < b.LayoutOrder end)

        local visibleRows = {}
        for _, child in ipairs(children) do
            if child.Visible then table.insert(visibleRows, child) end
        end

        for _, child in ipairs(children) do
            local c = child:FindFirstChildOfClass("UICorner"); if c then c:Destroy() end
            for _, m in ipairs(child:GetChildren()) do if m.Name == "__cornerMask" then m:Destroy() end end
            local sep = child:FindFirstChild("__separator"); if sep then sep:Destroy() end
        end

        local i = 1
        while i <= #visibleRows do
            local row = visibleRows[i]
            local isMerge = row:GetAttribute("Merge") == true
            
            if isMerge then
                local j = i
                while j < #visibleRows and visibleRows[j+1]:GetAttribute("Merge") == true do
                    j = j + 1
                end
                for k = i, j do
                    local r = visibleRows[k]
                    if k == i and k == j then applyRowStyle(r, true, true)
                    elseif k == i then applyRowStyle(r, true, false)
                    elseif k == j then applyRowStyle(r, false, true)
                    else applyRowStyle(r, false, false) end
                end
                i = j + 1
            else
                applyRowStyle(row, true, true)
                i = i + 1
            end
        end
    end
    
    local function tryTrack(child)
        if child:GetAttribute("IsRow") == true then
            child:GetPropertyChangedSignal("Visible"):Connect(function() task.defer(refresh) end)
            task.defer(refresh)
        end
    end
    
    for _, child in ipairs(group:GetChildren()) do tryTrack(child) end
    group.ChildAdded:Connect(tryTrack)
    group.ChildRemoved:Connect(function() task.defer(refresh) end)
end

