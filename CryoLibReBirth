        btn.MouseButton1Click:Connect(function() switchTab(tabId) end)
        self._sidebarItems[tabId] = { btn = btn, ico = ico, lbl = lbl }

        local page = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = content })
        local scroll = mk("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 4, ScrollBarImageColor3 = T.stroke, ScrollBarImageTransparency = 0.4,
            CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y, Parent = page,
        })
        mk("UIPadding", { PaddingTop = UDim.new(0, 22), PaddingBottom = UDim.new(0, 22), PaddingLeft = UDim.new(0, 26), PaddingRight = UDim.new(0, 22), Parent = scroll })
        mk("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
        self.Pages[tabId] = page

        if not self.ActiveTab then
            self.ActiveTab = tabId
            page.Visible = true
            refreshSidebarColors()
        end

        local Tab = { Page = scroll, ID = tabId, _order = 0 }
        self.Tabs[tabId] = Tab

        function Tab:CreateSection(name)
            name = name or "Section"
            self._order += 1
            mk("TextLabel", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = name, FontFace = FontBold, TextSize = 13, TextColor3 = T.accent, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = self._order, Parent = scroll })
            self._order += 1
            
            local group = mk("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.card, BackgroundTransparency = 0, LayoutOrder = self._order, Parent = scroll })
            corner(group, 16); local gs = stroke(group, T.stroke, 1.2, 0.55)
            reg(group, "BackgroundColor3", "card"); reg(gs, "Color", "stroke")
            mk("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = group })
            attachRowTracker(group)

            local Section = { Group = group, _nextOrder = 0 }
            local function nextOrder() Section._nextOrder += 1; return Section._nextOrder end

            -- ============= TOGGLE =============
            function Section:CreateToggle(cfg)
                cfg = cfg or {}
                local isMerge = cfg.Merge or false
                local title = cfg.Title or "Toggle"
                local desc  = cfg.Description
                local state = cfg.Default or false
                local callback = cfg.Callback

                local row = mk("TextButton", { Size = UDim2.new(1, 0, 0, desc and 62 or 52), BackgroundColor3 = T.card, BackgroundTransparency = 0, Text = "", AutoButtonColor = false, LayoutOrder = nextOrder(), Parent = group })
                row:SetAttribute("IsRow", true)
                row:SetAttribute("Merge", isMerge)
                reg(row, "BackgroundColor3", "card"); hoverEffect(row, "cardHover", "card")

                local name = mk("TextLabel", { Position = UDim2.fromOffset(18, desc and 10 or 0), Size = UDim2.new(1, -110, 0, desc and 22 or 52), BackgroundTransparency = 1, Text = title, FontFace = FontMedium, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
                reg(name, "TextColor3", "text")
                if desc then
                    local d = mk("TextLabel", { Position = UDim2.fromOffset(18, 34), Size = UDim2.new(1, -110, 0, 18), BackgroundTransparency = 1, Text = desc, FontFace = FontRegular, TextSize = 12, TextColor3 = T.textDim, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
                    reg(d, "TextColor3", "textDim")
                end

                local track = mk("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -18, 0.5, 0), Size = UDim2.fromOffset(50, 26), BackgroundColor3 = T.toggleOff, Parent = row })
                corner(track, 13); reg(track, "BackgroundColor3", "toggleOff")
                local knob = mk("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(3, 0) + UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(20, 20), BackgroundColor3 = T.toggleKnobOff, Parent = track })
                corner(knob, 10); reg(knob, "BackgroundColor3", "toggleKnobOff")

                if state then
                    track.BackgroundColor3 = T.accent; knob.BackgroundColor3 = T.toggleKnobOn
                    knob.Position = UDim2.fromOffset(27, 0) + UDim2.fromScale(0, 0.5)
                end

                local ElementObj = { Value = state }
                function ElementObj:Set(v)
                    self.Value = v
                    if v then
                        -- ✅ Новая пружинистая анимация тумблера
                        TweenService:Create(track, Tw.toggle, { BackgroundColor3 = T.accent }):Play()
                        TweenService:Create(knob, Tw.toggle, { BackgroundColor3 = T.toggleKnobOn, Position = UDim2.fromOffset(27, 0) + UDim2.fromScale(0, 0.5) }):Play()
                    else
                        TweenService:Create(track, Tw.toggle, { BackgroundColor3 = T.toggleOff }):Play()
                        TweenService:Create(knob, Tw.toggle, { BackgroundColor3 = T.toggleKnobOff, Position = UDim2.fromOffset(3, 0) + UDim2.fromScale(0, 0.5) }):Play()
                    end
                end

                row.MouseButton1Click:Connect(function()
                    ElementObj:Set(not ElementObj.Value)
                    if callback then task.spawn(callback, ElementObj.Value) end
                end)
                return ElementObj
            end

            -- ============= BUTTON =============
            function Section:CreateButton(cfg)
                cfg = cfg or {}
                local isMerge = cfg.Merge or false
                local label = cfg.Title or "Button"
                local isDanger = cfg.Danger or false

                local btn = mk("TextButton", { Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = T.card, BackgroundTransparency = 0, Text = label, FontFace = FontBold, TextSize = 15, TextColor3 = isDanger and T.red or T.text, AutoButtonColor = false, LayoutOrder = nextOrder(), Parent = group })
                btn:SetAttribute("IsRow", true)
                btn:SetAttribute("Merge", isMerge)
                reg(btn, "BackgroundColor3", "card"); hoverEffect(btn, "cardHover", "card")
                press(btn) -- ✅ Добавил анимацию нажатия для кнопок
                btn.MouseButton1Click:Connect(function() if cfg.Callback then task.spawn(cfg.Callback) end end)
                return btn
            end

            return Section
        end
        return Tab
    end

    -- ============================================================
    --  CUSTOM LOADING SCREEN WITH STAGE CALLBACKS
    -- ============================================================
    local LOADING_W, LOADING_H = 460, 260
    local loadingScreen = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(LOADING_W, LOADING_H), BackgroundColor3 = T.card,
        BackgroundTransparency = 0, ZIndex = 200, ClipsDescendants = true, Parent = gui,
    })
    corner(loadingScreen, 22); stroke(loadingScreen, T.stroke, 1.2, 0.55)
    local loadingScale = mk("UIScale", { Scale = 0.5, Parent = loadingScreen })

    mk("TextLabel", { Position = UDim2.fromOffset(0, 98), Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Text = Title, FontFace = FontBold, TextSize = 28, TextColor3 = T.text, ZIndex = 210, Parent = loadingScreen })
    local loadingSubtitle = mk("TextLabel", { Position = UDim2.fromOffset(0, 136), Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = "Initializing...", FontFace = FontRegular, TextSize = 13, TextColor3 = T.textDim, ZIndex = 210, Parent = loadingScreen })
    local progressTrack = mk("Frame", { Position = UDim2.fromOffset(30, 176), Size = UDim2.new(1, -60, 0, 6), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.75, ZIndex = 210, Parent = loadingScreen })
    corner(progressTrack, 3)
    local progressFill = mk("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.accent, ZIndex = 211, Parent = progressTrack })
    corner(progressFill, 3)
    local percentLbl = mk("TextLabel", { Position = UDim2.fromOffset(0, 192), Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = "0%", FontFace = FontBold, TextSize = 12, TextColor3 = T.accent, ZIndex = 210, Parent = loadingScreen })

    task.spawn(function()
        loadingScreen.Visible = true
        TweenService:Create(loadingScale, Tw.med, { Scale = math.max(math.min(workspace.CurrentCamera.ViewportSize.X/820, 1), 0.55) * 0.85 }):Play()
        
        local total = #LoadingStages
        for i, stage in ipairs(LoadingStages) do
            loadingSubtitle.Text = stage.text
            local targetPct = (i / total) * 100
            TweenService:Create(progressFill, TweenInfo.new(0.3, Enum.EasingStyle.Quart), { Size = UDim2.fromScale(targetPct / 100, 1) }):Play()
            percentLbl.Text = math.floor(targetPct) .. "%"

            if stage.callback then
                local success, err = pcall(stage.callback)
                if not success then warn("Loading error in stage '" .. stage.text .. "': " .. tostring(err)) end
            elseif stage.duration then
                task.wait(stage.duration)
            end
        end

        task.wait(0.3)
        TweenService:Create(loadingScale, Tw.med, { Scale = 0.4 }):Play()
        task.wait(0.3)
        loadingScreen:Destroy()

        root.Visible = true
        uiScale.Scale = 0.85
        -- ✅ Новая пружинистая анимация появления окна
        TweenService:Create(root, Tw.med, { Position = UDim2.fromScale(0.5, 0.5) }):Play()
        TweenService:Create(uiScale, Tw.pressUp, { Scale = getAdaptiveScale() }):Play()
        
        task.delay(0.4, function() Library:Notify(Title .. " Ready", "Interface loaded successfully.", ICONS.Check) end)
    end)

    return Window
end

return Library
