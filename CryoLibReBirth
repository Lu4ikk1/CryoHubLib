local function initSounds()
    local map = {
        click  = { "6895079853", 0.4 },
        hover  = { "107511012621133", 0.2 },
        close  = { "97375206361343", 0.3 },
        notify = { "71730540025978", 0.4 },
        toggle = { "128389255905279", 0.4 },
        slider = { "121370732132760", 0.5 },
    }
    for name, cfg in pairs(map) do
        local s = mk("Sound", { SoundId = "rbxassetid://" .. cfg[1], Volume = cfg[2], Parent = SoundService })
        sounds[name] = s
    end
end

