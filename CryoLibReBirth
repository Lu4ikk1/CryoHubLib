                    optionRows[opt] = optRow
                    if not dropConfig.Multi and opt == dropConfig.Default or (not dropConfig.Multi and i == 1 and not dropConfig.Default) then
                        selected[opt] = true
                        check.Visible = true
                    end

                    optRow.MouseButton1Click:Connect(function()
                        if dropConfig.Multi then
                            selected[opt] = not selected[opt]
                            updateSelectionVisual()
                            local parts = {} for k, v in pairs(selected) do if v then table.insert(parts, k) end end table.sort(parts)
                            dropLbl.Text = #parts > 0 and table.concat(parts, ", ") or "Select..."
                            ElementObj.Value = selected
                            if dropConfig.Callback then task.spawn(dropConfig.Callback, parts) end
                        else
                            for k in pairs(selected) do selected[k] = nil end
                            selected[opt] = true
                            updateSelectionVisual()
                            dropLbl.Text = opt
