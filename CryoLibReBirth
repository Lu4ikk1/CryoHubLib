local function tryFont(weight, fallback)
    local ok, f = pcall(function() return Font.fromName("OPPO Sans", weight, Enum.FontStyle.Normal) end)
    if ok and f then return f end
    return Font.fromEnum(fallback)
end
local FontBold    = tryFont(Enum.FontWeight.Bold,    Enum.Font.GothamBold)
local FontMedium  = tryFont(Enum.FontWeight.Medium,  Enum.Font.GothamMedium)

