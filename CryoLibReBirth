            PaddingLeft = UDim.new(0, 22), PaddingRight = UDim.new(0, 18), Parent = scroll,
        })
        mk("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })

        local btn = mk("TextButton", {
            Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false, ZIndex = 4, Parent = sideScroll,
        })
        corner(btn, R.FULL)
        btn.ClipsDescendants = true
        local ico = mk("ImageLabel", {
            Position = UDim2.fromOffset(18, 12), Size = UDim2.fromOffset(24, 24),
            BackgroundTransparency = 1, Image = icon or "",
            ImageColor3 = T.onSurfaceVariant, ZIndex = 5, Parent = btn,
        })
        local lbl = mk("TextLabel", {
            Position = UDim2.fromOffset(56, 0), Size = UDim2.new(1, -66, 1, 0),
            BackgroundTransparency = 1, Text = name,
            TextColor3 = T.onSurfaceVariant, Font = Enum.Font.GothamMedium,
            TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5, Parent = btn,
        })
        if not icon then ico.Visible = false; lbl.Position = UDim2.fromOffset(20, 0); lbl.Size = UDim2.new(1, -30, 1, 0) end

        btn.MouseEnter:Connect(function() playHover()
            if currentTab ~= page then
                TweenService:Create(btn, Tw.fast, { BackgroundTransparency = 0.9, BackgroundColor3 = T.onSurface }):Play()
            end
        end)
        btn.MouseLeave:Connect(function()
            if currentTab ~= page then
                TweenService:Create(btn, Tw.fast, { BackgroundTransparency = 1 }):Play()
            end
        end)
        btn.MouseButton1Down:Connect(function()
            playSound("click")
            local c = btn.AbsolutePosition + btn.AbsoluteSize / 2
            ripple(btn, Vector2.new(c.X, c.Y))
        end)
        btn.MouseButton1Click:Connect(function() self:_switchTab(page) end)

        tabEls[page] = { btn = btn, ico = ico, lbl = lbl, hasIcon = icon ~= nil }

        local Tab = setmetatable({}, CryoHub)
        Tab._window = self
        Tab._page = page
        Tab._scroll = scroll
        pages[#pages + 1] = page
        page._tabId = #pages

        -- Секции и группы
        function Tab:CreateSection(text)
            local lbl = mk("TextLabel", {
                Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1,
                Text = string.upper(text), Font = Enum.Font.GothamBold, TextSize = 13,
                TextColor3 = T.primary, TextXAlignment = Enum.TextXAlignment.Left,
                LayoutOrder = self:_nextOrder(), Parent = scroll,
            })
            reg(lbl, "TextColor3", "primary")
            return lbl
        end

        function Tab:_nextOrder()
            scroll.LayoutOrder = (scroll.LayoutOrder or 0) + 1
            return scroll.LayoutOrder
        end

        function Tab:CreateGroup()
            local group = mk("CanvasGroup", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = T.surfaceContainerLow, BorderSizePixel = 0,
                LayoutOrder = self:_nextOrder(), ClipsDescendants = true, Parent = scroll,
            })
            corner(group, R.L)
            reg(group, "BackgroundColor3", "surfaceContainerLow")
            local grpStroke = stroke(group, T.outlineVariant, 1, 0.6)
            reg(grpStroke, "Color", "outlineVariant")
            mk("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = group })

            local rowCount = 0
            local function rowSep(row)
                local sep = mk("Frame", {
                    AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0),
                    Size = UDim2.new(1, -32, 0, 1),
                    BackgroundColor3 = T.outlineVariant, BackgroundTransparency = 0.6,
                    BorderSizePixel = 0, ZIndex = 2, Parent = row,
                })
                reg(sep, "BackgroundColor3", "outlineVariant")
            end

            local G = {}
            function G:_order() rowCount = rowCount + 1; return rowCount end
            function G:_sepIf(row, isLast) if not isLast then rowSep(row) end end
            G._group = group
            Tab._bindGroup(G)
            return G
        end

        -- Группа привязана к табу (компоненты ниже работают и с табом напрямую)
        function Tab:_bindGroup(G)
            local parent = G._group

            -- ---------- MD3 SWITCH ----------
            function G:CreateToggle(opts)
                opts = opts or {}
                local h = opts.Desc and 74 or 56
                local row = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1,
                    Text = "", AutoButtonColor = false, LayoutOrder = self:_order(), Parent = parent,
                })
                row.ClipsDescendants = true

                local name = mk("TextLabel", {
                    Position = UDim2.fromOffset(20, 0),
                    Size = UDim2.new(1, -110, 1, 0),
                    BackgroundTransparency = 1, Text = opts.Title or "Toggle",
                    Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = T.onSurface,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = opts.Desc and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
                    ZIndex = 3, Parent = row,
                })
                reg(name, "TextColor3", "onSurface")
                if opts.Desc then name.Position = UDim2.fromOffset(20, 12) end
                if opts.Desc then
                    local d = mk("TextLabel", {
                        Position = UDim2.fromOffset(20, 36), Size = UDim2.new(1, -110, 0, 20),
                        BackgroundTransparency = 1, Text = opts.Desc,
                        Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = T.onSurfaceVariant,
                        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3, Parent = row,
                    })
                    reg(d, "TextColor3", "onSurfaceVariant")
                end

                local track = mk("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -20, 0.5, 0),
                    Size = UDim2.fromOffset(52, 32), BackgroundColor3 = T.surfaceContainerHighest,
                    BorderSizePixel = 0, ZIndex = 3, Parent = row,
                })
                corner(track, R.FULL)
                reg(track, "BackgroundColor3", "surfaceContainerHighest")
                local trackStroke = stroke(track, T.outline, 2, 0.4)
                reg(trackStroke, "Color", "outline")

                local knob = mk("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(0, 16, 0.5, 0),
                    Size = UDim2.fromOffset(16, 16), BackgroundColor3 = T.outline,
                    BorderSizePixel = 0, ZIndex = 4, Parent = track,
                })
                corner(knob, R.FULL)
                reg(knob, "BackgroundColor3", "outline")

                local state = opts.Default or false
                local function apply(instant)
                    local ti = instant and TweenInfo.new(0) or Tw.med
                    if state then
                        TweenService:Create(track, ti, { BackgroundColor3 = T.primary }):Play()
                        TweenService:Create(trackStroke, ti, { Transparency = 1 }):Play()
                        TweenService:Create(knob, ti, {
                            BackgroundColor3 = T.onPrimary,
                            Size = UDim2.fromOffset(24, 24),
                            Position = UDim2.new(1, -16, 0.5, 0),
                        }):Play()
                    else
                        TweenService:Create(track, ti, { BackgroundColor3 = T.surfaceContainerHighest }):Play()
                        TweenService:Create(trackStroke, ti, { Transparency = 0.4 }):Play()
                        TweenService:Create(knob, ti, {
                            BackgroundColor3 = T.outline,
                            Size = UDim2.fromOffset(16, 16),
                            Position = UDim2.new(0, 16, 0.5, 0),
                        }):Play()
                    end
                end
                apply(true)

                row.MouseEnter:Connect(function() playHover()
                    TweenService:Create(row, Tw.fast, { BackgroundTransparency = 0.94, BackgroundColor3 = T.onSurface }):Play() end)
                row.MouseLeave:Connect(function()
                    TweenService:Create(row, Tw.fast, { BackgroundTransparency = 1 }):Play() end)
                row.MouseButton1Click:Connect(function()
                    local c = row.AbsolutePosition + Vector2.new(row.AbsoluteSize.X - 46, row.AbsoluteSize.Y / 2)
                    ripple(row, Vector2.new(c.X, c.Y))
                    state = not state
                    apply(false)
                    playSound("toggle")
                    if opts.Callback then task.spawn(opts.Callback, state) end
                end)
                self:_sepIf(row, opts.IsLast)
                return { Set = function(v) state = v; apply(false) end, Get = function() return state end }
            end

            -- ---------- MD3 SLIDER ----------
            function G:CreateSlider(opts)
                opts = opts or {}
                local min = opts.Min or 0
                local max = opts.Max or 100
                local decimals = opts.Rounding or 0
                local h = 84
                local box = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1,
                    LayoutOrder = self:_order(), Parent = parent,
                })

                local name = mk("TextLabel", {
                    Position = UDim2.fromOffset(20, 14), Size = UDim2.new(1, -120, 0, 20),
                    BackgroundTransparency = 1, Text = opts.Title or "Slider",
                    Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = T.onSurface,
                    TextXAlignment = Enum.TextXAlignment.Left, Parent = box,
                })
                reg(name, "TextColor3", "onSurface")

                local value = opts.Default or min
                local valLbl = mk("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 14),
                    Size = UDim2.fromOffset(80, 20), BackgroundTransparency = 1,
                    Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = T.primary,
                    TextXAlignment = Enum.TextXAlignment.Right, Parent = box,
                })
                reg(valLbl, "TextColor3", "primary")

                local trackBg = mk("Frame", {
                    Position = UDim2.fromOffset(20, 56), Size = UDim2.new(1, -40, 0, 6),
                    BackgroundColor3 = T.surfaceContainerHighest, BorderSizePixel = 0,
                    Parent = box,
                })
                corner(trackBg, R.FULL)
                reg(trackBg, "BackgroundColor3", "surfaceContainerHighest")
                local fill = mk("Frame", {
                    Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.primary,
                    BorderSizePixel = 0, Parent = trackBg,
                })
                corner(fill, R.FULL)
                reg(fill, "BackgroundColor3", "primary")
                local knob = mk("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
                    Size = UDim2.fromOffset(20, 20), BackgroundColor3 = T.primary,
                    BorderSizePixel = 0, ZIndex = 3, Parent = trackBg,
                })
                corner(knob, R.FULL)
                reg(knob, "BackgroundColor3", "primary")
                local knobDot = mk("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                    Size = UDim2.fromOffset(6, 6), BackgroundColor3 = T.primaryContainer,
                    BorderSizePixel = 0, ZIndex = 4, Parent = knob,
                })
                corner(knobDot, R.FULL)
                reg(knobDot, "BackgroundColor3", "primaryContainer")

                local bubble = mk("Frame", {
                    AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(20, 44),
                    Size = UDim2.fromOffset(0, 0), BackgroundColor3 = T.primaryContainer,
                    BorderSizePixel = 0, ZIndex = 6, Parent = box,
                })
                corner(bubble, R.S)
                reg(bubble, "BackgroundColor3", "primaryContainer")
                local bubbleLbl = mk("TextLabel", {
                    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                    Text = "", Font = Enum.Font.GothamBold, TextSize = 12,
                    TextColor3 = T.onPrimaryContainer, ZIndex = 7, Parent = bubble,
                })
                reg(bubbleLbl, "TextColor3", "onPrimaryContainer")
                local bubblePad = mk("UIPadding", {
                    PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
                    PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = bubble,
                })

                local function fmt(v)
                    if decimals > 0 then return string.format("%." .. decimals .. "f", v)
                    else return tostring(math.floor(v + 0.5)) end
                end
                local function setVisual(a)
                    fill.Size = UDim2.fromScale(a, 1)
                    knob.Position = UDim2.fromScale(a, 0.5)
                    valLbl.Text = fmt(min + a * (max - min)) .. (opts.Suffix or "")
                end
                local dragging = false

                local function update(input, fire)
                    local a = math.clamp((input.Position.X - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
                    local v = min + a * (max - min)
                    if decimals == 0 then v = math.floor(v + 0.5) end
                    a = (v - min) / (max - min)
                    value = v
                    setVisual(a)
                    bubbleLbl.Text = fmt(v) .. (opts.Suffix or "")
                    playTick()
                    if fire and opts.Callback then task.spawn(opts.Callback, v) end
                end

                local hit = mk("TextButton", {
                    Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 36),
                    BackgroundTransparency = 1, Text = "", Parent = box,
                })
                local function showBubble(showIt)
                    if showIt then
                        local a = (value - min) / (max - min)
                        bubble.Position = UDim2.fromOffset(20 + a * (trackBg.AbsoluteSize.X), 48)
                        bubbleLbl.Text = fmt(value) .. (opts.Suffix or "")
                        TweenService:Create(bubble, Tw.fast, { Size = UDim2.fromOffset(44, 26) }):Play()
                    else
                        TweenService:Create(bubble, Tw.fast, { Size = UDim2.fromOffset(0, 0) }):Play()
                    end
                end
                hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true; update(input, true); showBubble(true)
                    end
                end)
                local connChanged = UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        update(input, true)
                        local a = (value - min) / (max - min)
                        bubble.Position = UDim2.fromOffset(20 + a * (trackBg.AbsoluteSize.X), 48)
                    end
                end)
                local connEnded = UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        if dragging then dragging = false; showBubble(false) end
                    end
                end)
                gui.Destroying:Connect(function() connChanged:Disconnect(); connEnded:Disconnect() end)

                setVisual((value - min) / (max - min))
                self:_sepIf(box, opts.IsLast)
                return { Set = function(v) value = math.clamp(v, min, max); setVisual((value - min) / (max - min)) end,
                         Get = function() return value end }
            end

            -- ---------- MD3 FILLED TEXT FIELD ----------
            function G:CreateInput(opts)
                opts = opts or {}
                local box = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 92), BackgroundTransparency = 1,
                    LayoutOrder = self:_order(), Parent = parent,
                })
                local name = mk("TextLabel", {
                    Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1, Text = opts.Title or "Input",
                    Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = T.onSurface,
                    TextXAlignment = Enum.TextXAlignment.Left, Parent = box,
                })
                reg(name, "TextColor3", "onSurface")

                local field = mk("Frame", {
                    Position = UDim2.fromOffset(20, 40), Size = UDim2.new(1, -40, 0, 40),
                    BackgroundColor3 = T.surfaceContainerHighest, BorderSizePixel = 0,
                    Parent = box,
                })
                corner(field, R.S)
                reg(field, "BackgroundColor3", "surfaceContainerHighest")
                local fieldStroke = stroke(field, T.outline, 1, 0.6)
                reg(fieldStroke, "Color", "outline")

                local textBox = mk("TextBox", {
                    Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 1, 0),
                    BackgroundTransparency = 1, Text = opts.Default or "",
                    PlaceholderText = opts.Placeholder or "",
                    PlaceholderColor3 = T.onSurfaceVariant, TextColor3 = T.onSurface,
                    Font = Enum.Font.Gotham, TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
                    Parent = field,
                })
                reg(textBox, "TextColor3", "onSurface")
                reg(textBox, "PlaceholderColor3", "onSurfaceVariant")

                textBox.Focused:Connect(function()
                    TweenService:Create(fieldStroke, Tw.fast, { Thickness = 2, Transparency = 0 }):Play()
                end)
                textBox.FocusLost:Connect(function(enter)
                    TweenService:Create(fieldStroke, Tw.fast, { Thickness = 1, Transparency = 0.6 }):Play()
                    if opts.Callback and (enter or opts.CallbackOnChange) then
                        task.spawn(opts.Callback, textBox.Text)
                    end
                end)
                field.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        textBox:CaptureFocus(); playSound("click")
                    end
                end)
                self:_sepIf(box, opts.IsLast)
                return { Set = function(t) textBox.Text = t end, Get = function() return textBox.Text end }
            end

            -- ---------- MD3 EXPOSED DROPDOWN MENU ----------
            local openMenus = {}
            overlay.MouseButton1Click:Connect(function()
                for i = #openMenus, 1, -1 do openMenus[i].close(); end
                overlay.Visible = #openMenus > 0
            end)

            function G:CreateDropdown(opts)
                opts = opts or {}
                local options = opts.Options or {}
                local multi = opts.Multi or false
                local h = 92
                local itemH = 44

                local box = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1,
                    LayoutOrder = self:_order(), Parent = parent,
                })
                local name = mk("TextLabel", {
                    Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1, Text = opts.Title or "Select",
                    Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = T.onSurface,
                    TextXAlignment = Enum.TextXAlignment.Left, Parent = box,
                })
                reg(name, "TextColor3", "onSurface")

                local btn = mk("TextButton", {
                    Position = UDim2.fromOffset(20, 40), Size = UDim2.new(1, -40, 0, 40),
                    BackgroundColor3 = T.surfaceContainerHighest, BorderSizePixel = 0,
                    Text = "", AutoButtonColor = false, Parent = box,
                })
                corner(btn, R.S)
                btn.ClipsDescendants = true
                reg(btn, "BackgroundColor3", "surfaceContainerHighest")
                stroke(btn, T.outline, 1, 0.6)

                local selected = {}
                if multi then
                    for _, d in ipairs(opts.Default or {}) do selected[d] = true end
                else
                    if opts.Default then selected[opts.Default] = true
                    elseif options[1] then selected[options[1]] = true end
                end
                local function selText()
                    local parts = {}
                    for k, v in pairs(selected) do if v then parts[#parts + 1] = k end end
                    table.sort(parts)
                    if #parts == 0 then return "Select..." end
                    return table.concat(parts, ", ")
                end

                local valLbl = mk("TextLabel", {
                    Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -44, 1, 0),
                    BackgroundTransparency = 1, Text = multi and selText() or next(selected) or "Select...",
                    Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = T.onSurface,
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3, Parent = btn,
                })
                reg(valLbl, "TextColor3", "onSurface")
                local arr = mk("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1,
                    Text = "▾", Font = Enum.Font.GothamBold, TextSize = 14,
                    TextColor3 = T.onSurfaceVariant, ZIndex = 3, Parent = btn,
                })
                reg(arr, "TextColor3", "onSurfaceVariant")

                -- MD3 menu в оверлее (корректный учёт GuiInset)
                local menuHolder
                local function closeMenu()
                    if not menuHolder then return end
                    arr.Text = "▾"
                    local m = menuHolder
                    menuHolder = nil
                    local t = TweenService:Create(m, Tw.fast, {
                        Size = UDim2.fromOffset(m.Size.X.Offset, 0) })
                    t:Play()
                    t.Completed:Connect(function() m:Destroy() end)
                    for i = #openMenus, 1, -1 do if openMenus[i].menu == m then table.remove(openMenus, i) end end
                    if #openMenus == 0 then overlay.Visible = false end
                end

                btn.MouseButton1Click:Connect(function()
                    playSound("click")
                    local c = btn.AbsolutePosition + btn.AbsoluteSize / 2
                    ripple(btn, Vector2.new(c.X, c.Y))
                    if menuHolder then closeMenu(); return end
                    overlay.Visible = true
                    arr.Text = "▴"

                    local inset = GuiService:GetGuiInset()
                    local pos = btn.AbsolutePosition - inset
                    local w = btn.AbsoluteSize.X
                    local listH = math.min(#options * (itemH + 2) + 16, 320)

                    menuHolder = mk("CanvasGroup", {
                        Position = UDim2.fromOffset(math.floor(pos.X), math.floor(pos.Y + btn.AbsoluteSize.Y + 4)),
                        Size = UDim2.fromOffset(math.floor(w), 0),
                        BackgroundColor3 = T.surfaceContainerHigh, BorderSizePixel = 0,
                        GroupTransparency = 0, ZIndex = 600, Parent = overlay,
                    })
                    corner(menuHolder, R.M)
                    local menuStroke = stroke(menuHolder, T.outlineVariant, 1, 0.4)
                    reg(menuStroke, "Color", "outlineVariant")
                    local mp = mk("UIPadding", {
                        PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
                        PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = menuHolder })
                    local ml = mk("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = menuHolder })

                    for i, opt in ipairs(options) do
                        local item = mk("TextButton", {
                            Size = UDim2.new(1, 0, 0, itemH), BackgroundTransparency = 1,
                            Text = "", AutoButtonColor = false, LayoutOrder = i, ZIndex = 601, Parent = menuHolder,
                        })
                        corner(item, R.S)
                        item.ClipsDescendants = true
                        local il = mk("TextLabel", {
                            Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -50, 1, 0),
                            BackgroundTransparency = 1, Text = tostring(opt),
                            Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = T.onSurface,
                            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 602, Parent = item,
                        })
                        reg(il, "TextColor3", "onSurface")
                        local chk = mk("TextLabel", {
                            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
                            Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1,
                            Text = "✓", Font = Enum.Font.GothamBold, TextSize = 15,
                            TextColor3 = T.primary, Visible = selected[opt] == true, ZIndex = 602, Parent = item,
                        })
                        reg(chk, "TextColor3", "primary")
                        item.MouseEnter:Connect(function() playHover()
                            TweenService:Create(item, Tw.fast, { BackgroundTransparency = 0.9, BackgroundColor3 = T.onSurface }):Play() end)
                        item.MouseLeave:Connect(function()
                            TweenService:Create(item, Tw.fast, { BackgroundTransparency = 1 }):Play() end)
                        item.MouseButton1Click:Connect(function()
                            local cc = item.AbsolutePosition + item.AbsoluteSize / 2
                            ripple(item, Vector2.new(cc.X, cc.Y))
                            if multi then
                                selected[opt] = not selected[opt]
                                chk.Visible = selected[opt] == true
                                valLbl.Text = selText()
                                local parts = {}
                                for k, v in pairs(selected) do if v then parts[#parts + 1] = k end end
                                table.sort(parts)
                                if opts.Callback then task.spawn(opts.Callback, parts) end
                            else
                                for k in pairs(selected) do selected[k] = nil end
                                selected[opt] = true
                                valLbl.Text = tostring(opt)
                                if opts.Callback then task.spawn(opts.Callback, opt) end
                                closeMenu()
                            end
                        end)
                    end
                    TweenService:Create(menuHolder, Tw.med, { Size = UDim2.fromOffset(math.floor(w), listH) }):Play()
                    table.insert(openMenus, { menu = menuHolder, btn = btn, close = closeMenu })
                end)

                self:_sepIf(box, opts.IsLast)
                return { Set = function(v) if multi then selected = {}; for _, x in ipairs(v or {}) do selected[x] = true end; valLbl.Text = selText()
                                             else for k in pairs(selected) do selected[k] = nil end; selected[v] = true; valLbl.Text = tostring(v) end end,
                         Get = function() local parts = {}; for k, v in pairs(selected) do if v then parts[#parts + 1] = k end end; table.sort(parts); return parts end }
            end

