function CryoHub:SetTheme(name)
    if not THEMES[name] then return end
    T = THEMES[name]
    for _, r in ipairs(regs) do
        if r.el and r.el.Parent then
            TweenService:Create(r.el, Tw.med, { [r.prop] = T[r.key] }):Play()
        end
    end
    if self._refreshTheme then self:_refreshTheme() end
end

