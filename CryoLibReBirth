                local open = false
                local panel = mk("Frame", {
                    Position = UDim2.fromOffset(0, baseH), Size = UDim2.new(1, 0, 0, 0),
                    BackgroundTransparency = 1, ClipsDescendants = true, Parent = box,
                })
                local function refresh(fire)
                    cur = Color3.fromRGB(ch.R, ch.G, ch.B)
                    swatch.BackgroundColor3 = cur
                    rgbLbl.Text = string.format("RGB %d, %d, %d", ch.R, ch.G, ch.B)
                    if fire and opts.Callback then task.spawn(opts.Callback, cur) end
                end

                local chColors = { R = Color3.fromRGB(242, 184, 181), G = Color3.fromRGB(116, 199, 108), B = Color3.fromRGB(102, 192, 244) }
                local idx = 0
                for _, key in ipairs({ "R", "G", "B" }) do
                    idx = idx + 1
                    local row = mk("Frame", {
                        Position = UDim2.fromOffset(20, 12 + (idx - 1) * 44),
                        Size = UDim2.new(1, -40, 0, 40), BackgroundTransparency = 1, Parent = panel,
                    })
                    mk("TextLabel", {
                        Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(20, 16),
                        BackgroundTransparency = 1, Text = key, Font = Enum.Font.GothamBold,
                        TextSize = 13, TextColor3 = chColors[key], TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
                    })
                    local track = mk("Frame", {
                        Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 6),
                        BackgroundColor3 = T.surfaceContainerHighest, BorderSizePixel = 0, Parent = row,
                    })
                    corner(track, R.FULL)
                    reg(track, "BackgroundColor3", "surfaceContainerHighest")
                    local fill = mk("Frame", {
                        Size = UDim2.fromScale(ch[key] / 255, 1), BackgroundColor3 = chColors[key],
                        BorderSizePixel = 0, Parent = track,
                    })
                    corner(fill, R.FULL)
                    local knob = mk("Frame", {
                        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(ch[key] / 255, 0.5),
                        Size = UDim2.fromOffset(16, 16), BackgroundColor3 = chColors[key],
                        BorderSizePixel = 0, ZIndex = 3, Parent = track,
                    })
                    corner(knob, R.FULL)
                    local dragging = false
                    local function upd(input, fire)
                        local a = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        ch[key] = math.floor(a * 255)
                        fill.Size = UDim2.fromScale(a, 1)
                        knob.Position = UDim2.fromScale(a, 0.5)
                        refresh(fire)
                        playTick()
                    end
                    local hitB = mk("TextButton", {
                        Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 22),
                        BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = row,
