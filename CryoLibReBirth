                            if dropConfig.Callback then task.spawn(dropConfig.Callback, opt) end
                            TweenService:Create(list, Tw.fast, { Size = UDim2.new(1, -36, 0, 0) }):Play()
                            TweenService:Create(box, Tw.fast, { Size = UDim2.new(1, 0, 0, baseHeight) }):Play()
                            isOpen = false
                        end
                        processDependencies()
                    end)
                end

