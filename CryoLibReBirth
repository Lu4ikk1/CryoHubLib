    local openDropdowns = {}
    local function createDropdown(parent, title, options, order, opts)
        opts = opts or {}
        local multi = opts.multi or false
        local onSelect = opts.onSelect
        local isLast = opts.isLast
        local baseHeight = 76
        local optHeight = 40
        local listHeight = #options * optHeight

        local box = mk("Frame", {
            Size = UDim2.new(1, 0, 0, baseHeight), BackgroundColor3 = T.card,
            BackgroundTransparency = 0, LayoutOrder = order or 0, Parent = parent,
        })
        reg(box, "BackgroundColor3", "card")
        hoverEffect(box, T.cardHover, T.card)
        box.MouseEnter:Connect(playHover)

        local name = mk("TextLabel", {
            Position = UDim2.fromOffset(18, 10), Size = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1, Text = title,
            Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = T.text,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = box,
        })
        reg(name, "TextColor3", "text")

        local dropBtn = mk("TextButton", {
            Position = UDim2.fromOffset(18, 36), Size = UDim2.new(1, -36, 0, 34),
            BackgroundColor3 = T.toggleOff, BackgroundTransparency = 0,
            Text = "", AutoButtonColor = false, Parent = box,
        })
        corner(dropBtn, 12)
        reg(dropBtn, "BackgroundColor3", "toggleOff")
        stroke(dropBtn, T.stroke, 1, 0.6)

        local dropLbl = mk("TextLabel", {
            Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 1, 0),
            BackgroundTransparency = 1, Text = multi and "Select..." or options[1],
            Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = T.text,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = dropBtn,
        })
        reg(dropLbl, "TextColor3", "text")

        local list = mk("Frame", {
            Position = UDim2.fromOffset(18, baseHeight), Size = UDim2.new(1, -36, 0, 0),
            BackgroundColor3 = T.toggleOff, BackgroundTransparency = 0,
            ClipsDescendants = true, Parent = box,
        })
        corner(list, 12)
        reg(list, "BackgroundColor3", "toggleOff")

        mk("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

        local selected = {}
        local optionRows = {}

        local function updateSelectionVisual()
            for opt, row in pairs(optionRows) do
                local check = row:FindFirstChild("Check")
                if check then check.Visible = selected[opt] == true end
            end
        end

        for i, opt in ipairs(options) do
            local optRow = mk("TextButton", {
                Size = UDim2.new(1, 0, 0, optHeight), BackgroundColor3 = T.card,
                BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
                LayoutOrder = i, Parent = list,
            })
            optRow.MouseEnter:Connect(function()
                playHover()
                TweenService:Create(optRow, Tw.fast, { BackgroundColor3 = T.cardHover, BackgroundTransparency = 0 }):Play()
            end)
            optRow.MouseLeave:Connect(function()
                TweenService:Create(optRow, Tw.fast, { BackgroundTransparency = 1 }):Play()
            end)
            optRow.MouseButton1Down:Connect(function() playSound("click") end)

            local lbl = mk("TextLabel", {
                Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -56, 1, 0),
                BackgroundTransparency = 1, Text = opt,
                Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = T.text,
                TextXAlignment = Enum.TextXAlignment.Left, Parent = optRow,
            })
            reg(lbl, "TextColor3", "text")

            local check = mk("TextLabel", {
                Name = "Check",
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
                Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1,
                Text = "✓", Font = Enum.Font.GothamBold, TextSize = 16,
                TextColor3 = T.accent, Visible = false, Parent = optRow,
            })
            reg(check, "TextColor3", "accent")

            optionRows[opt] = optRow
            if not multi and i == 1 then
                selected[opt] = true
                check.Visible = true
            end

            optRow.MouseButton1Click:Connect(function()
                if multi then
                    selected[opt] = not selected[opt]
                    updateSelectionVisual()
                    local parts = {}
                    for k, v in pairs(selected) do if v then table.insert(parts, k) end end
                    table.sort(parts)
                    dropLbl.Text = #parts > 0 and table.concat(parts, ", ") or "Select..."
                    if onSelect then onSelect(parts) end
                    Notify(title, #parts > 0 and "Selected: " .. table.concat(parts, ", ") or "Cleared", ICONS.Check)
                else
                    for k in pairs(selected) do selected[k] = nil end
                    selected[opt] = true
                    updateSelectionVisual()
                    dropLbl.Text = opt
                    if onSelect then onSelect(opt) end
                    Notify(title, "Selected: " .. opt, ICONS.Check)
                    task.defer(function()
                        for i2, dd in ipairs(openDropdowns) do
                            if dd.box == box then dd.close(); break end
                        end
                    end)
                end
            end)
        end

        local isOpen = false
        local function closeDrop()
            if not isOpen then return end
            isOpen = false
            TweenService:Create(list, Tw.fast, { Size = UDim2.new(1, -36, 0, 0) }):Play()
            TweenService:Create(box, Tw.fast, { Size = UDim2.new(1, 0, 0, baseHeight) }):Play()
            for i, dd in ipairs(openDropdowns) do
                if dd.box == box then table.remove(openDropdowns, i); break end
            end
        end

        dropBtn.MouseButton1Click:Connect(function()
            playSound("click")
            if isOpen then
                closeDrop()
            else
                isOpen = true
                TweenService:Create(list, Tw.med, { Size = UDim2.new(1, -36, 0, listHeight) }):Play()
                TweenService:Create(box, Tw.med, { Size = UDim2.new(1, 0, 0, baseHeight + listHeight) }):Play()
                table.insert(openDropdowns, { box = box, btn = dropBtn, list = list, close = closeDrop })
            end
        end)

        if not isLast then addRowSeparator(box) end
        return box
    end

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            local px, py = input.Position.X, input.Position.Y
            for i = #openDropdowns, 1, -1 do
                local dd = openDropdowns[i]
                local btnAbs = dd.btn.AbsolutePosition
                local btnSize = dd.btn.AbsoluteSize
                local inBtn = px >= btnAbs.X and px <= btnAbs.X + btnSize.X
                         and py >= btnAbs.Y and py <= btnAbs.Y + btnSize.Y
                local inList = false
                if dd.list then
                    local listAbs = dd.list.AbsolutePosition
                    local listSize = dd.list.AbsoluteSize
                    inList = px >= listAbs.X and px <= listAbs.X + listSize.X
                         and py >= listAbs.Y and py <= listAbs.Y + listSize.Y
                end
                if not inBtn and not inList then dd.close() end
            end
        end
    end)

