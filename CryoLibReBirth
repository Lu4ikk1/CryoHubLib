            reg(lIcon, "BackgroundColor3", "primaryContainer")
            mk("ImageLabel", {
                Size = UDim2.fromOffset(28, 28), AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1,
                Image = Icon, ImageColor3 = T.onPrimaryContainer, Parent = lIcon,
            })
            local ring = mk("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(56, 56), BackgroundColor3 = T.primary,
                BackgroundTransparency = 0.85, ZIndex = 0, Parent = screen,
            })
            corner(ring, R.FULL)
            local rs = mk("UIScale", { Scale = 1, Parent = ring })
            task.spawn(function()
                while screen.Parent do
                    TweenService:Create(rs, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Scale = 1.3 }):Play()
                    TweenService:Create(ring, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.95 }):Play()
                    task.wait(1.2)
                    if not screen.Parent then break end
                    TweenService:Create(rs, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Scale = 1 }):Play()
                    TweenService:Create(ring, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.85 }):Play()
                    task.wait(1.2)
                end
            end)
        end

        local lTitle = mk("TextLabel", {
            Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1,
            Text = loadingCfg.Title or Title, Font = Enum.Font.GothamBold,
            TextSize = 24, TextColor3 = T.onSurface,
            TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2, Parent = screen,
        })
        reg(lTitle, "TextColor3", "onSurface")
        local lStage = mk("TextLabel", {
            Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1,
            Text = "", Font = Enum.Font.Gotham, TextSize = 13,
            TextColor3 = T.onSurfaceVariant, TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 3, Parent = screen,
        })
        reg(lStage, "TextColor3", "onSurfaceVariant")

        -- MD3 linear progress track
        local pTrack = mk("Frame", {
            Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = T.surfaceContainerHighest,
            BorderSizePixel = 0, LayoutOrder = 4, Parent = screen,
        })
        corner(pTrack, R.FULL)
        reg(pTrack, "BackgroundColor3", "surfaceContainerHighest")
        local pFill = mk("Frame", {
            Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.primary,
            BorderSizePixel = 0, Parent = pTrack,
        })
        corner(pFill, R.FULL)
        reg(pFill, "BackgroundColor3", "primary")
        local pHead = mk("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.fromOffset(6, 6), BackgroundColor3 = T.primaryContainer,
            BorderSizePixel = 0, ZIndex = 3, Parent = pFill,
        })
        corner(pHead, R.FULL)

        mk("UIListLayout", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder, Parent = screen })

        task.spawn(function()
            task.wait(0.15)
            TweenService:Create(screen, Tw.med, { GroupTransparency = 0 }):Play()
            task.wait(0.35)
            local stages = loadingCfg.Stages or {}
            local total = #stages
            for i, st in ipairs(stages) do
                lStage.Text = st.text or "..."
                local target = i / total
                TweenService:Create(pFill, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
                    { Size = UDim2.fromScale(target, 1) }):Play()
                if st.callback then
                    local ok, err = pcall(st.callback)
                    if not ok then warn("[CryoHub] Loading stage error: " .. tostring(err)) end
                else
                    task.wait(st.duration or 0.3)
                end
            end
            task.wait(0.25)
            TweenService:Create(screen, Tw.med, { GroupTransparency = 1 }):Play()
            task.wait(0.3)
            screen:Destroy()
            playIntro()
        end)
    end

    return Window
end

return CryoHub
