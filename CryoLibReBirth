                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = true; upd(input, false)
                        end
                    end)
                    local cC = UserInputService.InputChanged:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                            upd(input, false)
                        end
                    end)
                    local cE = UserInputService.InputEnded:Connect(function(input)
                        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and dragging then
                            dragging = false; refresh(true)
                        end
                    end)
                    gui.Destroying:Connect(function() cC:Disconnect(); cE:Disconnect() end)
                end

                local clickArea = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, baseH), BackgroundTransparency = 1, Text = "", ZIndex = 6, Parent = box,
                })
                clickArea.MouseButton1Click:Connect(function()
