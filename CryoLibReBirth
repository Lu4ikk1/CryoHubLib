            local t = TweenService:Create(confirmOverlay, Tw.fast, { BackgroundTransparency = 1 })
            t:Play()
            t.Completed:Connect(function() confirmOverlay.Visible = false end)
        end)

        local function playSimpleOutro()
            loaded = false
            TweenService:Create(windowUiScale, Tw.med, { Scale = 0.88 }):Play()
            TweenService:Create(floatBtn, Tw.fast, { BackgroundTransparency = 1 }):Play()
            TweenService:Create(floatIcon, Tw.fast, { ImageTransparency = 1 }):Play()
            TweenService:Create(floatText, Tw.fast, { TextTransparency = 1 }):Play()
            local t = TweenService:Create(root, Tw.med, { GroupTransparency = 1 })
            t:Play()
            t.Completed:Connect(function() gui:Destroy() end)
        end

        btnYes.MouseButton1Click:Connect(function()
            playSound("close")
            confirmOverlay.Visible = false
            playSimpleOutro()
        end)

        windowPlayIntro = function()
            loaded = true
            root.Visible = true
            root.GroupTransparency = 1
            windowUiScale.Scale = 0.88
            TweenService:Create(root, Tw.med, { GroupTransparency = 0 }):Play()
            TweenService:Create(windowUiScale, Tw.med, { Scale = getAdaptiveScale() }):Play()
            task.delay(0.35, function()
                floatBtn.Visible = true
                floatBtn.BackgroundTransparency = 1
                floatIcon.ImageTransparency = 1
                floatText.TextTransparency = 1
                TweenService:Create(floatBtn, Tw.med, { BackgroundTransparency = 0 }):Play()
                TweenService:Create(floatIcon, Tw.med, { ImageTransparency = 0 }):Play()
                TweenService:Create(floatText, Tw.med, { TextTransparency = 0 }):Play()
            end)
            task.delay(0.8, function()
                Notify("CryoHub Ready", "Interface loaded.", ICONS.Check)
            end)
            task.delay(0.4, function()
                if clampRootPosition then clampRootPosition() end
            end)
        end

        local dragging, dragStart, startPos = false, nil, nil
        titleBar.InputBegan:Connect(function(input)
            if not loaded then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                if toggling or hidden then return end
                dragging = true
                dragStart = input.Position
                startPos = root.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - dragStart
                root.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
                if clampRootPosition then clampRootPosition() end
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    -- ============================================================
    --  LOADING
    -- ============================================================
    local LOADING_W, LOADING_H = 460, 260
    local loadingScreen = mk("CanvasGroup", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(LOADING_W, LOADING_H), BackgroundColor3 = T.card,
        BackgroundTransparency = 0, GroupTransparency = 1, ZIndex = 200,
        ClipsDescendants = true, Parent = gui,
    })
    corner(loadingScreen, 22)
    stroke(loadingScreen, T.stroke, 1.2, 0.55)

    local loadingScale = mk("UIScale", { Scale = 0.85 * getAdaptiveScale(), Parent = loadingScreen })

    local function repositionLoading()
        local vp = workspace.CurrentCamera.ViewportSize
        local targetScale = math.min(vp.X / 820, vp.Y / 620, 1)
        targetScale = math.max(targetScale, 0.55) * 0.85
        loadingScale.Scale = targetScale
    end
    repositionLoading()
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(repositionLoading)

    local loadingDrag = false
    local loadingDragStart = nil
    local loadingDragPos = nil
    loadingScreen.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            loadingDrag = true
            loadingDragStart = input.Position
            loadingDragPos = loadingScreen.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if loadingDrag and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - loadingDragStart
            loadingScreen.Position = UDim2.new(
                loadingDragPos.X.Scale, loadingDragPos.X.Offset + d.X,
                loadingDragPos.Y.Scale, loadingDragPos.Y.Offset + d.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            loadingDrag = false
        end
    end)

    local decorHolder = mk("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        ClipsDescendants = true, ZIndex = 200, Parent = loadingScreen,
    })
    do
        local dotSpacing, dotSize = 24, 2
        local maxCols = math.floor(LOADING_W / dotSpacing) + 1
        local maxRows = math.floor(LOADING_H / dotSpacing) + 1
        for col = 0, maxCols do
            for row = 0, maxRows do
                local dot = mk("Frame", {
                    Position = UDim2.fromOffset(col * dotSpacing - 4, row * dotSpacing - 4),
                    Size = UDim2.fromOffset(dotSize, dotSize),
                    BackgroundColor3 = T.stroke, BackgroundTransparency = 0.65,
                    BorderSizePixel = 0, ZIndex = 200, Parent = decorHolder,
                })
                corner(dot, 1)
            end
        end
    end

    for _, g in ipairs({
        { size = 220, x = 140, y = 80,  trans = 0.96 },
        { size = 160, x = 200, y = 120, trans = 0.94 },
        { size = 100, x = 300, y = 130, trans = 0.92 },
    }) do
        local glow = mk("Frame", {
            Position = UDim2.fromOffset(g.x, g.y),
            Size = UDim2.fromOffset(g.size, g.size),
            BackgroundColor3 = T.accent, BackgroundTransparency = g.trans,
            BorderSizePixel = 0, ZIndex = 201, Parent = decorHolder,
        })
        corner(glow, g.size / 2)
    end

    local iconHolder = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24),
        Size = UDim2.fromOffset(60, 60), BackgroundTransparency = 1,
        ZIndex = 210, Parent = loadingScreen,
    })

    if CONFIG.LoadingHasGlow then
        local glowRing = mk("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(60, 60),
            BackgroundColor3 = CONFIG.LoadingIconColor or T.accent,
            BackgroundTransparency = 0.85, ZIndex = 209, Parent = iconHolder,
        })
        corner(glowRing, 30)
        local glowRingScale = mk("UIScale", { Scale = 1, Parent = glowRing })
        task.spawn(function()
            while loadingScreen and loadingScreen.Parent do
                TweenService:Create(glowRingScale, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Scale = 1.35 }):Play()
                TweenService:Create(glowRing, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.95 }):Play()
                task.wait(1.2)
                if not (loadingScreen and loadingScreen.Parent) then break end
                TweenService:Create(glowRingScale, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Scale = 1 }):Play()
                TweenService:Create(glowRing, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.85 }):Play()
                task.wait(1.2)
            end
        end)
    end

    local iconCircle = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(52, 52), BackgroundColor3 = T.accent,
        BackgroundTransparency = 0, ZIndex = 210, Parent = iconHolder,
    })
    corner(iconCircle, 26)

    mk("ImageLabel", {
        Size = UDim2.fromOffset(CONFIG.LoadingIconSize, CONFIG.LoadingIconSize),
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        BackgroundTransparency = 1, Image = CONFIG.LoadingIcon,
        ImageColor3 = CONFIG.LoadingIconColor or T.bg, ZIndex = 211, Parent = iconCircle,
    })

    mk("TextLabel", {
        Position = UDim2.fromOffset(0, 98), Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1, Text = "CryoHub",
        Font = Enum.Font.GothamBold, TextSize = 28, TextColor3 = T.text,
        ZIndex = 210, Parent = loadingScreen,
    })

    local loadingSubtitle = mk("TextLabel", {
        Position = UDim2.fromOffset(0, 136), Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1, Text = "Initializing...",
        Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = T.textDim,
        ZIndex = 210, Parent = loadingScreen,
    })

    local progressTrack = mk("Frame", {
        Position = UDim2.fromOffset(30, 176), Size = UDim2.new(1, -60, 0, 6),
        BackgroundColor3 = T.stroke, BackgroundTransparency = 0.75,
        ZIndex = 210, Parent = loadingScreen,
    })
    corner(progressTrack, 3)

    local progressFill = mk("Frame", {
        Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.accent,
        BackgroundTransparency = 0, ZIndex = 211, Parent = progressTrack,
    })
    corner(progressFill, 3)

    local percentLbl = mk("TextLabel", {
        Position = UDim2.fromOffset(0, 192), Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1, Text = "0%",
        Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.accent,
        ZIndex = 210, Parent = loadingScreen,
    })

    local function runLoading()
        local totalStages = #CONFIG.LoadingStages
        for i, stage in ipairs(CONFIG.LoadingStages) do
            loadingSubtitle.Text = stage.text
            local targetPct = (i / totalStages) * 100
            
            TweenService:Create(progressFill,
                TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
                { Size = UDim2.fromScale(targetPct / 100, 1) }
            ):Play()
            
            task.spawn(function()
                local startPct = ((i - 1) / totalStages) * 100
                local elapsed = 0
                while elapsed < 0.3 do
                    elapsed += task.wait()
                    local alpha = math.min(elapsed / 0.3, 1)
                    percentLbl.Text = math.floor(startPct + (targetPct - startPct) * alpha) .. "%"
                end
                percentLbl.Text = math.floor(targetPct) .. "%"
            end)

            if stage.callback then
                local success, err = pcall(stage.callback)
                if not success then warn("Loading stage error: " .. tostring(err)) end
            elseif stage.duration then
                task.wait(stage.duration)
            end
        end
        task.wait(0.3)
    end

    switchTab("toggles")

    task.spawn(function()
        task.wait(0.2)
        TweenService:Create(loadingScreen, Tw.med, { GroupTransparency = 0 }):Play()
        TweenService:Create(loadingScale, Tw.med, {
            Scale = math.max(math.min(workspace.CurrentCamera.ViewportSize.X / 820, 1), 0.55) * 0.85
        }):Play()
        task.wait(0.35)
        runLoading()
        TweenService:Create(loadingScreen, Tw.med, { GroupTransparency = 1 }):Play()
        TweenService:Create(loadingScale, Tw.med, { Scale = 0.5 }):Play()
        task.wait(0.3)
        loadingScreen:Destroy()
        if windowPlayIntro then windowPlayIntro() end
    end)

    -- Возвращаем API для взаимодействия со скриптом
    return {
        Gui = gui,
        Notify = Notify,
        ApplyTheme = applyTheme
    }
end

return CryoHub
