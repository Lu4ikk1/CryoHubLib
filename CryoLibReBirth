    SteamDark = {
        bg = Color3.fromRGB(23, 26, 33), sidebar = Color3.fromRGB(27, 30, 38),
        content = Color3.fromRGB(32, 35, 44), card = Color3.fromRGB(42, 46, 56),
        cardHover = Color3.fromRGB(52, 57, 70), activePill = Color3.fromRGB(60, 63, 77),
        stroke = Color3.fromRGB(61, 63, 71), text = Color3.fromRGB(224, 228, 235),
        textDim = Color3.fromRGB(150, 155, 165), accent = Color3.fromRGB(102, 192, 244),
        red = Color3.fromRGB(235, 100, 98),
        toggleOff = Color3.fromRGB(30, 34, 43),
        toggleKnobOff = Color3.fromRGB(150, 155, 165),
        toggleKnobOn = Color3.fromRGB(23, 26, 33),
    },
}

