    local loadingSubtitle = mk("TextLabel", { Position = UDim2.fromOffset(0, 136), Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = "Initializing...", Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = T.textDim, ZIndex = 210, Parent = loadingScreen })
    
    local progressTrack = mk("Frame", { Position = UDim2.fromOffset(30, 176), Size = UDim2.new(1, -60, 0, 6), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.75, ZIndex = 210, Parent = loadingScreen })
    corner(progressTrack, 3)
    local progressFill = mk("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.accent, BackgroundTransparency = 0, ZIndex = 211, Parent = progressTrack })
    corner(progressFill, 3)
    local percentLbl = mk("TextLabel", { Position = UDim2.fromOffset(0, 192), Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = "0%", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.accent, ZIndex = 210, Parent = loadingScreen })

    -- ============================================================
    --  WINDOW METHODS
    -- ============================================================
    function Window:SetTheme(name)
        applyTheme(name)
        refreshSidebar()
    end

    function Window:ToggleSound(enabled)
        SoundEnabled = enabled
    end

    function Window:CreateTab(tabConfig)
        local tabId = tabConfig.Title .. "_" .. tostring(#self.Tabs + 1)
        local tab = { Title = tabConfig.Title, Elements = {} }

        local btn = mk("TextButton", { Name = "Tab_" .. tabId, Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = T.sidebar, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = #self.Tabs + 1, Parent = sidebarScroll })
        corner(btn, 23)
        press(btn)

        local ico = mk("ImageLabel", { Name = "Icon", Position = UDim2.fromOffset(18, 12), Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, Image = tabConfig.Icon or ICONS.Default, ImageColor3 = T.textDim, Parent = btn })
        local lbl = mk("TextLabel", { Name = "Label", Position = UDim2.fromOffset(54, 0), Size = UDim2.new(1, -66, 1, 0), BackgroundTransparency = 1, Text = tabConfig.Title, TextColor3 = T.textDim, Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = btn })

        btn.MouseEnter:Connect(function()
            playHover()
            if self.ActiveTab ~= tabId then TweenService:Create(btn, Tw.fast, { BackgroundColor3 = T.cardHover, BackgroundTransparency = 0 }):Play() end
        end)
        btn.MouseLeave:Connect(function()
            if self.ActiveTab ~= tabId then TweenService:Create(btn, Tw.fast, { BackgroundTransparency = 1 }):Play() end
        end)
        btn.MouseButton1Down:Connect(function() playSound("click") end)

        self.Tabs[tabId] = { btn = btn, ico = ico, lbl = lbl }

        local page = mk("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, GroupTransparency = 1, Visible = false, Parent = content })
        local scroll = mk("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4,
            ScrollBarImageColor3 = T.stroke, ScrollBarImageTransparency = 0.4, CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, Parent = page,
        })
        mk("UIPadding", { PaddingTop = UDim.new(0, 22), PaddingBottom = UDim.new(0, 22), PaddingLeft = UDim.new(0, 26), PaddingRight = UDim.new(0, 22), Parent = scroll })
        mk("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
        self.Pages[tabId] = page
        tab.Page = scroll
        tab.ID = tabId

        btn.MouseButton1Click:Connect(function()
            if self.ActiveTab == tabId then return end
            self.ActiveTab = tabId
            refreshSidebar()
            for pid, p in pairs(self.Pages) do
                if pid == tabId then
                    p.Visible = true; p.GroupTransparency = 1; p.Position = UDim2.fromOffset(8, 0)
                    TweenService:Create(p, Tw.med, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }):Play()
                else
                    local t = TweenService:Create(p, Tw.fast, { GroupTransparency = 1 })
                    t:Play(); t.Completed:Connect(function() if self.ActiveTab ~= pid then p.Visible = false end end)
                end
            end
        end)

        if not self.ActiveTab then
            self.ActiveTab = tabId
            page.Visible = true
            page.GroupTransparency = 0
            refreshSidebar()
        end

        -- ============================================================
        --  SECTION & ELEMENTS
        -- ============================================================
        function tab:CreateSection(sectionTitle)
            local Section = {}
            local sectionLabel = mk("TextLabel", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = sectionTitle, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = T.accent, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = #self.Elements + 1, Parent = self.Page })
            reg(sectionLabel, "TextColor3", "accent")
            table.insert(self.Elements, sectionLabel)

            local group = mk("CanvasGroup", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.card, BackgroundTransparency = 0, LayoutOrder = #self.Elements + 1, ClipsDescendants = true, Parent = self.Page })
            corner(group, 16)
            local grpStroke = stroke(group, T.stroke, 1.2, 0.55)
            reg(group, "BackgroundColor3", "card")
            reg(grpStroke, "Color", "stroke")
            mk("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = group })
            table.insert(self.Elements, group)

            local rowCount = 0
            local function addRowSeparator(row)
                local sep = mk("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, -36, 0, 1), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 2, Parent = row })
                reg(sep, "BackgroundColor3", "stroke")
            end
            local function getIsLast() return false end -- Dynamic check handled by appending

            -- Toggle
            function Section:CreateToggle(togConfig)
                local row = mk("TextButton", { Size = UDim2.new(1, 0, 0, togConfig.Description and 62 or 52), BackgroundColor3 = T.card, BackgroundTransparency = 0, Text = "", AutoButtonColor = false, LayoutOrder = rowCount + 1, Parent = group })
                rowCount += 1
                reg(row, "BackgroundColor3", "card")
                hoverEffect(row, T.cardHover, T.card)
                row.MouseEnter:Connect(playHover)
                row.MouseButton1Down:Connect(function() playSound("click") end)

                local name = mk("TextLabel", { Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -110, 0, togConfig.Description and 22 or 52), BackgroundTransparency = 1, Text = togConfig.Title, Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = togConfig.Description and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center, Parent = row })
                if togConfig.Description then name.Position = UDim2.fromOffset(18, 10) end
                reg(name, "TextColor3", "text")
                
                if togConfig.Description then
                    local d = mk("TextLabel", { Position = UDim2.fromOffset(18, 34), Size = UDim2.new(1, -110, 0, 18), BackgroundTransparency = 1, Text = togConfig.Description, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.textDim, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
                    reg(d, "TextColor3", "textDim")
                end

                local track = mk("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -18, 0.5, 0), Size = UDim2.fromOffset(50, 26), BackgroundColor3 = T.toggleOff, BackgroundTransparency = 0, Parent = row })
                corner(track, 13)
                reg(track, "BackgroundColor3", "toggleOff")
                local knob = mk("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(3, 0) + UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(20, 20), BackgroundColor3 = T.toggleKnobOff, BackgroundTransparency = 0, Parent = track })
                corner(knob, 10)
                reg(knob, "BackgroundColor3", "toggleKnobOff")

                local state = togConfig.Default or false
                if state then
                    track.BackgroundColor3 = T.accent; knob.BackgroundColor3 = T.toggleKnobOn
                    knob.Position = UDim2.fromOffset(27, 0) + UDim2.fromScale(0, 0.5)
                end

                local ElementObj = { Value = state }
                function ElementObj:Set(val)
                    if self.Value == val then return end
                    self.Value = val
                    if val then
                        TweenService:Create(track, Tw.fast, { BackgroundColor3 = T.accent }):Play()
                        TweenService:Create(knob, Tw.fast, { BackgroundColor3 = T.toggleKnobOn, Position = UDim2.fromOffset(27, 0) + UDim2.fromScale(0, 0.5) }):Play()
                    else
                        TweenService:Create(track, Tw.fast, { BackgroundColor3 = T.toggleOff }):Play()
                        TweenService:Create(knob, Tw.fast, { BackgroundColor3 = T.toggleKnobOff, Position = UDim2.fromOffset(3, 0) + UDim2.fromScale(0, 0.5) }):Play()
                    end
                end
                function ElementObj:Get() return self.Value end

                row.MouseButton1Click:Connect(function()
                    state = not state
                    ElementObj:Set(state)
                    if togConfig.Callback then task.spawn(togConfig.Callback, state) end
                end)

                row.MouseEnter:Connect(function() rowCount = rowCount end) -- No-op
                table.insert(self.Elements, row) -- Track for layout
                -- Re-eval separators
                for i, v in ipairs(group:GetChildren()) do
                    if v:IsA("TextButton") then
                        local sep = v:FindFirstChild("RowSep")
                        if not sep then
                            local s = mk("Frame", { Name = "RowSep", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, -36, 0, 1), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 2, Parent = v })
                            reg(s, "BackgroundColor3", "stroke")
                        end
                    end
                end
                return ElementObj
            end

            -- Slider
            function Section:CreateSlider(sliderConfig)
                local box = mk("Frame", { Size = UDim2.new(1, 0, 0, 76), BackgroundColor3 = T.card, BackgroundTransparency = 0, LayoutOrder = rowCount + 1, Parent = group })
                rowCount += 1
                reg(box, "BackgroundColor3", "card")
                hoverEffect(box, T.cardHover, T.card)
                box.MouseEnter:Connect(playHover)

                local name = mk("TextLabel", { Position = UDim2.fromOffset(18, 14), Size = UDim2.new(1, -110, 0, 20), BackgroundTransparency = 1, Text = sliderConfig.Title, Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = box })
                reg(name, "TextColor3", "text")
                local valLbl = mk("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 14), Size = UDim2.fromOffset(70, 20), BackgroundTransparency = 1, Text = tostring(sliderConfig.Default or sliderConfig.Min or 0), Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = T.accent, TextXAlignment = Enum.TextXAlignment.Right, Parent = box })
                reg(valLbl, "TextColor3", "accent")

                local trackBg = mk("Frame", { Position = UDim2.fromOffset(18, 52), Size = UDim2.new(1, -36, 0, 6), BackgroundColor3 = T.toggleOff, BackgroundTransparency = 0, Parent = box })
                corner(trackBg, 3)
                reg(trackBg, "BackgroundColor3", "toggleOff")
                
                local min = sliderConfig.Min or 0
                local max = sliderConfig.Max or 100
                local default = sliderConfig.Default or min
                local pct = (default - min) / (max - min)

                local fill = mk("Frame", { Size = UDim2.fromScale(pct, 1), BackgroundColor3 = T.accent, BackgroundTransparency = 0, Parent = trackBg })
                corner(fill, 3)
                reg(fill, "BackgroundColor3", "accent")
                local knob = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(pct, 0.5), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = T.accent, BackgroundTransparency = 0, Parent = trackBg })
                corner(knob, 11)
                reg(knob, "BackgroundColor3", "accent")
                local knobInner = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(8, 8), BackgroundColor3 = T.accentBright, BackgroundTransparency = 0, Parent = knob })
                corner(knobInner, 4)
                reg(knobInner, "BackgroundColor3", "accentBright")

                local hit = mk("TextButton", { Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = "", Parent = box })
                local dragging = false
                local ElementObj = { Value = default }

                function ElementObj:Set(val)
                    val = math.clamp(val, min, max)
                    self.Value = val
                    local p = (val - min) / (max - min)
                    fill.Size = UDim2.fromScale(p, 1)
                    knob.Position = UDim2.fromScale(p, 0.5)
                    valLbl.Text = tostring(math.floor(val))
                end
                function ElementObj:Get() return self.Value end

                local function update(input)
                    local relX = math.clamp((input.Position.X - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
                    local val = math.floor(min + (max - min) * relX)
                    ElementObj:Set(val)
                    if sliderConfig.Callback then task.spawn(sliderConfig.Callback, val) end
                    playSliderTick()
                end

                hit.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; update(input) end end)
                UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end end)
                UserInputService.InputEnded:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then dragging = false end end)

                table.insert(self.Elements, box)
                -- Add separator
                local sep = mk("Frame", { Name = "RowSep", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, -36, 0, 1), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 2, Parent = box })
                reg(sep, "BackgroundColor3", "stroke")
                return ElementObj
            end

            -- Dropdown
            function Section:CreateDropdown(dropConfig)
                local baseHeight, optHeight = 76, 40
                local listHeight = #dropConfig.Options * optHeight
                local box = mk("Frame", { Size = UDim2.new(1, 0, 0, baseHeight), BackgroundColor3 = T.card, BackgroundTransparency = 0, LayoutOrder = rowCount + 1, Parent = group })
                rowCount += 1
                reg(box, "BackgroundColor3", "card")
                hoverEffect(box, T.cardHover, T.card)
                box.MouseEnter:Connect(playHover)

                local name = mk("TextLabel", { Position = UDim2.fromOffset(18, 10), Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = dropConfig.Title, Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = box })
                reg(name, "TextColor3", "text")
                
                local dropBtn = mk("TextButton", { Position = UDim2.fromOffset(18, 36), Size = UDim2.new(1, -36, 0, 34), BackgroundColor3 = T.toggleOff, BackgroundTransparency = 0, Text = "", AutoButtonColor = false, Parent = box })
                corner(dropBtn, 12)
                reg(dropBtn, "BackgroundColor3", "toggleOff")
                stroke(dropBtn, T.stroke, 1, 0.6)

                local dropLbl = mk("TextLabel", { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 1, 0), BackgroundTransparency = 1, Text = dropConfig.Default or (dropConfig.Multi and "Select..." or dropConfig.Options[1]), Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = dropBtn })
                reg(dropLbl, "TextColor3", "text")

                local list = mk("Frame", { Position = UDim2.fromOffset(18, baseHeight), Size = UDim2.new(1, -36, 0, 0), BackgroundColor3 = T.toggleOff, BackgroundTransparency = 0, ClipsDescendants = true, Parent = box })
                corner(list, 12)
                reg(list, "BackgroundColor3", "toggleOff")
                mk("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

                local selected = {}
                local optionRows = {}
                local ElementObj = { Value = dropConfig.Multi and {} or dropConfig.Default }

                local function updateSelectionVisual()
                    for opt, row in pairs(optionRows) do
                        local check = row:FindFirstChild("Check")
                        if check then check.Visible = (dropConfig.Multi and selected[opt] or (not dropConfig.Multi and selected[opt] == true)) end
                    end
                end

                function ElementObj:Set(val)
                    self.Value = val
                    if dropConfig.Multi then
                        selected = val
                        updateSelectionVisual()
                        local parts = {} for k, v in pairs(val) do if v then table.insert(parts, k) end end
                        dropLbl.Text = #parts > 0 and table.concat(parts, ", ") or "Select..."
                    else
                        for k in pairs(selected) do selected[k] = nil end
                        selected[val] = true
                        updateSelectionVisual()
                        dropLbl.Text = val
                    end
                end

                for i, opt in ipairs(dropConfig.Options) do
                    local optRow = mk("TextButton", { Size = UDim2.new(1, 0, 0, optHeight), BackgroundColor3 = T.card, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = i, Parent = list })
                    optRow.MouseEnter:Connect(function() playHover(); TweenService:Create(optRow, Tw.fast, { BackgroundColor3 = T.cardHover, BackgroundTransparency = 0 }):Play() end)
                    optRow.MouseLeave:Connect(function() TweenService:Create(optRow, Tw.fast, { BackgroundTransparency = 1 }):Play() end)
                    optRow.MouseButton1Down:Connect(function() playSound("click") end)

                    local lbl = mk("TextLabel", { Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -56, 1, 0), BackgroundTransparency = 1, Text = opt, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = optRow })
                    reg(lbl, "TextColor3", "text")
                    local check = mk("TextLabel", { Name = "Check", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Text = "✓", Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = T.accent, Visible = false, Parent = optRow })
                    reg(check, "TextColor3", "accent")

                    optionRows[opt] = optRow
                    if not dropConfig.Multi and opt == dropConfig.Default or (not dropConfig.Multi and i == 1 and not dropConfig.Default) then
                        selected[opt] = true
                        check.Visible = true
                    end

                    optRow.MouseButton1Click:Connect(function()
                        if dropConfig.Multi then
                            selected[opt] = not selected[opt]
                            updateSelectionVisual()
                            local parts = {} for k, v in pairs(selected) do if v then table.insert(parts, k) end end table.sort(parts)
                            dropLbl.Text = #parts > 0 and table.concat(parts, ", ") or "Select..."
                            ElementObj.Value = selected
                            if dropConfig.Callback then task.spawn(dropConfig.Callback, parts) end
                        else
                            for k in pairs(selected) do selected[k] = nil end
                            selected[opt] = true
                            updateSelectionVisual()
                            dropLbl.Text = opt
                            ElementObj.Value = opt
                            if dropConfig.Callback then task.spawn(dropConfig.Callback, opt) end
                            -- Close
                            TweenService:Create(list, Tw.fast, { Size = UDim2.new(1, -36, 0, 0) }):Play()
                            TweenService:Create(box, Tw.fast, { Size = UDim2.new(1, 0, 0, baseHeight) }):Play()
                        end
                    end)
                end

                local isOpen = false
                dropBtn.MouseButton1Click:Connect(function()
                    playSound("click")
                    isOpen = not isOpen
                    if isOpen then
                        TweenService:Create(list, Tw.med, { Size = UDim2.new(1, -36, 0, listHeight) }):Play()
                        TweenService:Create(box, Tw.med, { Size = UDim2.new(1, 0, 0, baseHeight + listHeight) }):Play()
                    else
                        TweenService:Create(list, Tw.fast, { Size = UDim2.new(1, -36, 0, 0) }):Play()
                        TweenService:Create(box, Tw.fast, { Size = UDim2.new(1, 0, 0, baseHeight) }):Play()
                    end
                end)

                table.insert(self.Elements, box)
                local sep = mk("Frame", { Name = "RowSep", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, -36, 0, 1), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 2, Parent = box })
                reg(sep, "BackgroundColor3", "stroke")
                return ElementObj
            end

            -- Button
            function Section:CreateButton(btnConfig)
                local btn = mk("TextButton", { Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = T.card, BackgroundTransparency = 0, Text = btnConfig.Title, Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = btnConfig.Danger and T.red or T.text, AutoButtonColor = false, LayoutOrder = rowCount + 1, Parent = group })
                rowCount += 1
                reg(btn, "BackgroundColor3", "card")
                hoverEffect(btn, T.cardHover, T.card)
                btn.MouseEnter:Connect(playHover)
                btn.MouseButton1Down:Connect(function() playSound("click") end)
                btn.MouseButton1Click:Connect(function() if btnConfig.Callback then task.spawn(btnConfig.Callback) end end)
                
                table.insert(self.Elements, btn)
                local sep = mk("Frame", { Name = "RowSep", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, -36, 0, 1), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 2, Parent = btn })
                reg(sep, "BackgroundColor3", "stroke")
                return btn
            end
            
            -- Input
            function Section:CreateInput(inpConfig)
                local box = mk("Frame", { Size = UDim2.new(1, 0, 0, 80), BackgroundColor3 = T.card, BackgroundTransparency = 0, LayoutOrder = rowCount + 1, Parent = group })
                rowCount += 1
                reg(box, "BackgroundColor3", "card")
                hoverEffect(box, T.cardHover, T.card)
                box.MouseEnter:Connect(playHover)

                local name = mk("TextLabel", { Position = UDim2.fromOffset(18, 10), Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = inpConfig.Title, Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = box })
                reg(name, "TextColor3", "text")
                local field = mk("Frame", { Position = UDim2.fromOffset(18, 36), Size = UDim2.new(1, -36, 0, 34), BackgroundColor3 = T.toggleOff, BackgroundTransparency = 0, Parent = box })
                corner(field, 12)
                reg(field, "BackgroundColor3", "toggleOff")
                stroke(field, T.stroke, 1, 0.6)

                local textBox = mk("TextBox", { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 1, 0), BackgroundTransparency = 1, Text = inpConfig.Default or "", PlaceholderText = inpConfig.Placeholder or "", PlaceholderColor3 = T.textDim, TextColor3 = T.text, Font = Enum.Font.Gotham, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Parent = field })
                reg(textBox, "TextColor3", "text")
                reg(textBox, "PlaceholderColor3", "textDim")

                field.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then textBox:CaptureFocus(); playSound("click") end end)
                textBox.FocusLost:Connect(function() if inpConfig.Callback then task.spawn(inpConfig.Callback, textBox.Text) end end)

                local ElementObj = {}
                function ElementObj:Set(val) textBox.Text = tostring(val) end
                function ElementObj:Get() return textBox.Text end

                table.insert(self.Elements, box)
                local sep = mk("Frame", { Name = "RowSep", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, -36, 0, 1), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 2, Parent = box })
                reg(sep, "BackgroundColor3", "stroke")
                return ElementObj
            end

            -- Keybind
            function Section:CreateKeybind(keyConfig)
                local box = mk("Frame", { Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = T.card, BackgroundTransparency = 0, LayoutOrder = rowCount + 1, Parent = group })
                rowCount += 1
                reg(box, "BackgroundColor3", "card")
                hoverEffect(box, T.cardHover, T.card)
                box.MouseEnter:Connect(playHover)

                local name = mk("TextLabel", { Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -150, 1, 0), BackgroundTransparency = 1, Text = keyConfig.Title, Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = box })
                reg(name, "TextColor3", "text")
                
                local currentKey = keyConfig.Default or Enum.KeyCode.Unknown
                local keyBtn = mk("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -18, 0.5, 0), Size = UDim2.fromOffset(100, 34), BackgroundColor3 = T.toggleOff, BackgroundTransparency = 0, Text = currentKey.Name ~= "Unknown" and currentKey.Name or "None", Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = T.accent, AutoButtonColor = false, Parent = box })
                corner(keyBtn, 17)
                reg(keyBtn, "BackgroundColor3", "toggleOff")
                reg(keyBtn, "TextColor3", "accent")
                keyBtn.MouseButton1Down:Connect(function() playSound("click") end)

                local listening = false
                local ElementObj = { Value = currentKey }
                function ElementObj:Set(k) currentKey = k; keyBtn.Text = k.Name end

                keyBtn.MouseButton1Click:Connect(function() if not listening then listening = true; keyBtn.Text = "Press..."; keyBtn.TextColor3 = T.textDim end end)
                
                local conn = UserInputService.InputBegan:Connect(function(input, gpe)
                    if gpe or not listening then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        currentKey = input.KeyCode
                        ElementObj.Value = currentKey
                        keyBtn.Text = currentKey.Name
                        keyBtn.TextColor3 = T.accent
                        listening = false
                        if keyConfig.Callback then task.spawn(keyConfig.Callback, currentKey) end
                    end
                end)

                table.insert(self.Elements, box)
                local sep = mk("Frame", { Name = "RowSep", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, -36, 0, 1), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 2, Parent = box })
                reg(sep, "BackgroundColor3", "stroke")
                return ElementObj
            end
            
            -- Colorpicker
            function Section:CreateColorPicker(colConfig)
                local baseHeight, sliderRowHeight, padding = 80, 44, 12
                local panelHeight = padding + sliderRowHeight * 3 + padding
                
                local defColor = colConfig.Default or Color3.fromRGB(255, 255, 255)
                local currentR, currentG, currentB = defColor.R * 255, defColor.G * 255, defColor.B * 255
                
                local box = mk("Frame", { Size = UDim2.new(1, 0, 0, baseHeight), BackgroundColor3 = T.card, BackgroundTransparency = 0, LayoutOrder = rowCount + 1, Parent = group })
                rowCount += 1
                reg(box, "BackgroundColor3", "card")
                hoverEffect(box, T.cardHover, T.card)
                box.MouseEnter:Connect(playHover)

                local swatchBg = mk("Frame", { Position = UDim2.fromOffset(18, 18), Size = UDim2.fromOffset(44, 44), BackgroundColor3 = defColor, BackgroundTransparency = 0, Parent = box })
                corner(swatchBg, 12)
                stroke(swatchBg, T.stroke, 1, 0.4)

                local name = mk("TextLabel", { Position = UDim2.fromOffset(76, 18), Size = UDim2.new(1, -140, 0, 22), BackgroundTransparency = 1, Text = colConfig.Title, Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = box })
                reg(name, "TextColor3", "text")
                local hexLbl = mk("TextLabel", { Position = UDim2.fromOffset(76, 40), Size = UDim2.new(1, -140, 0, 18), BackgroundTransparency = 1, Text = string.format("RGB: %d, %d, %d", currentR, currentG, currentB), Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.textDim, TextXAlignment = Enum.TextXAlignment.Left, Parent = box })
                reg(hexLbl, "TextColor3", "textDim")

                local clickArea = mk("TextButton", { Size = UDim2.new(1, 0, 0, baseHeight), BackgroundTransparency = 1, Text = "", Parent = box })
                clickArea.MouseButton1Down:Connect(function() playSound("click") end)

                local panel = mk("Frame", { Position = UDim2.fromOffset(0, baseHeight), Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = T.toggleOff, BackgroundTransparency = 0, ClipsDescendants = true, Parent = box })
                corner(panel, 14)
                reg(panel, "BackgroundColor3", "toggleOff")
                
                local ElementObj = { Value = defColor }

                local function updateColor()
                    local c = Color3.fromRGB(math.floor(currentR), math.floor(currentG), math.floor(currentB))
                    ElementObj.Value = c
                    swatchBg.BackgroundColor3 = c
                    hexLbl.Text = string.format("RGB: %d, %d, %d", math.floor(currentR), math.floor(currentG), math.floor(currentB))
                    if colConfig.Callback then task.spawn(colConfig.Callback, c) end
                end

                function ElementObj:Set(c)
                    currentR, currentG, currentB = c.R * 255, c.G * 255, c.B * 255
                    updateColor()
                end
                
                local function createChannel(yPos, label, chColor, getVal, setVal)
                    local row = mk("Frame", { Position = UDim2.fromOffset(padding, yPos), Size = UDim2.new(1, -padding * 2, 0, sliderRowHeight), BackgroundTransparency = 1, Parent = panel })
                    mk("TextLabel", { Position = UDim2.fromOffset(0, 4), Size = UDim2.fromOffset(20, 16), BackgroundTransparency = 1, Text = label, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = chColor, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
                    local valueLbl = mk("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 4), Size = UDim2.fromOffset(40, 16), BackgroundTransparency = 1, Text = tostring(math.floor(getVal())), Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = chColor, TextXAlignment = Enum.TextXAlignment.Right, Parent = row })
                    local track = mk("Frame", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.5, Parent = row })
                    corner(track, 3)
                    local fill = mk("Frame", { Size = UDim2.fromScale(getVal() / 255, 1), BackgroundColor3 = chColor, BackgroundTransparency = 0, Parent = track })
                    corner(fill, 3)
                    local knob = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(getVal() / 255, 0.5), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = chColor, BackgroundTransparency = 0, Parent = track })
                    corner(knob, 8)

                    local dragging = false
                    local hit = mk("TextButton", { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Text = "", Parent = row })

                    local function update(input)
                        local relX = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        local val = relX * 255
                        fill.Size = UDim2.fromScale(relX, 1)
                        knob.Position = UDim2.fromScale(relX, 0.5)
                        valueLbl.Text = tostring(math.floor(val))
                        setVal(val)
                        updateColor()
                        playSliderTick()
                    end

                    hit.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; update(input) end end)
                    UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end end)
                    UserInputService.InputEnded:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then dragging = false end end)
                end

                createChannel(padding, "R", Color3.fromRGB(235, 100, 98), function() return currentR end, function(v) currentR = v end)
                createChannel(padding + sliderRowHeight, "G", Color3.fromRGB(116, 199, 108), function() return currentG end, function(v) currentG = v end)
                createChannel(padding + sliderRowHeight * 2, "B", Color3.fromRGB(102, 192, 244), function() return currentB end, function(v) currentB = v end)

                local isOpen = false
                clickArea.MouseButton1Click:Connect(function()
                    isOpen = not isOpen
                    if isOpen then
                        TweenService:Create(panel, Tw.med, { Size = UDim2.new(1, 0, 0, panelHeight) }):Play()
                        TweenService:Create(box, Tw.med, { Size = UDim2.new(1, 0, 0, baseHeight + panelHeight) }):Play()
                    else
                        TweenService:Create(panel, Tw.fast, { Size = UDim2.new(1, 0, 0, 0) }):Play()
                        TweenService:Create(box, Tw.fast, { Size = UDim2.new(1, 0, 0, baseHeight) }):Play()
                    end
                end)

                table.insert(self.Elements, box)
                local sep = mk("Frame", { Name = "RowSep", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, -36, 0, 1), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 2, Parent = box })
                reg(sep, "BackgroundColor3", "stroke")
                return ElementObj
            end

            return Section
        end

        return tab
    end

    -- ============================================================
    --  START WINDOW
    -- ============================================================
    local function runLoading()
        local stages = LoadingConfig.Stages or {}
        local totalStages = #stages
        if totalStages == 0 then return end
        for i, stage in ipairs(stages) do
            loadingSubtitle.Text = stage.text
            local targetPct = (i / totalStages) * 100
            TweenService:Create(progressFill, TweenInfo.new(0.3, Enum.EasingStyle.Quart), { Size = UDim2.fromScale(targetPct / 100, 1) }):Play()
            task.spawn(function()
                local startPct = ((i - 1) / totalStages) * 100
                local elapsed = 0
                while elapsed < 0.3 do
                    elapsed += task.wait()
                    local alpha = math.min(elapsed / 0.3, 1)
                    percentLbl.Text = math.floor(startPct + (targetPct - startPct) * alpha) .. "%"
                end
                percentLbl.Text = math.floor(targetPct) .. "%"
            end)

            if stage.callback then pcall(stage.callback) elseif stage.duration then task.wait(stage.duration) end
        end
        task.wait(0.3)
    end

    task.spawn(function()
        task.wait(0.2)
        TweenService:Create(loadingScreen, Tw.med, { GroupTransparency = 0 }):Play()
        TweenService:Create(loadingScale, Tw.med, { Scale = math.max(math.min(workspace.CurrentCamera.ViewportSize.X / 820, 1), 0.55) * 0.85 }):Play()
        task.wait(0.35)
        runLoading()
        TweenService:Create(loadingScreen, Tw.med, { GroupTransparency = 1 }):Play()
        TweenService:Create(loadingScale, Tw.med, { Scale = 0.5 }):Play()
        task.wait(0.3)
        loadingScreen:Destroy()
        
        loaded = true
        root.Visible = true; root.GroupTransparency = 1; uiScale.Scale = 0.88
        TweenService:Create(root, Tw.med, { GroupTransparency = 0 }):Play()
        TweenService:Create(uiScale, Tw.med, { Scale = getAdaptiveScale() }):Play()
        
        task.delay(0.35, function()
            floatBtn.Visible = true; floatBtn.BackgroundTransparency = 1; floatIcon.ImageTransparency = 1; floatText.TextTransparency = 1
            TweenService:Create(floatBtn, Tw.med, { BackgroundTransparency = 0 }):Play()
            TweenService:Create(floatIcon, Tw.med, { ImageTransparency = 0 }):Play()
            TweenService:Create(floatText, Tw.med, { TextTransparency = 0 }):Play()
        end)
        
        task.delay(0.8, function()
            Library:Notify("System Ready", "Interface loaded successfully.", ICONS.Check)
        end)
        
        task.delay(0.4, function()
            clampRootPosition()
        end)
    end)

    return Window
end

return Library
