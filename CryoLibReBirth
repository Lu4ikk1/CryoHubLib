local function mk(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    return o
end

local function corner(p, r) return mk("UICorner", { CornerRadius = UDim.new(0, r or 16), Parent = p }) end

local function stroke(p, c, t, tr)
    return mk("UIStroke", {
        Color = c or T.stroke, Thickness = t or 1.4, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p,
    })
end

local function hoverEffect(obj, targetKey, baseKey)
    obj.MouseEnter:Connect(function() TweenService:Create(obj, Tw.fast, { BackgroundColor3 = T[targetKey] }):Play() end)
    obj.MouseLeave:Connect(function() TweenService:Create(obj, Tw.fast, { BackgroundColor3 = T[baseKey] }):Play() end)
end

local function getAdaptiveScale()
    local vp = workspace.CurrentCamera.ViewportSize
    local s = math.min(vp.X / 820, vp.Y / 620, 1)
    return math.max(s, 0.55)
end

-- Логика слияния рядов (Merge)
local function addMasks(row, radius, side)
    local mSize = UDim2.fromOffset(radius, radius)
    local makeMask = function(anchor, posX, posY)
        return mk("Frame", {
            Name = "__cornerMask", AnchorPoint = anchor,
            Position = UDim2.new(posX, 0, posY, 0), Size = mSize,
            BackgroundColor3 = row.BackgroundColor3, BackgroundTransparency = row.BackgroundTransparency,
            BorderSizePixel = 0, ZIndex = (row.ZIndex or 1) + 5, Parent = row,
        })
    end
    if side == "bottom" then makeMask(Vector2.new(0, 1), 0, 1); makeMask(Vector2.new(1, 1), 1, 1)
    else makeMask(Vector2.new(0, 0), 0, 0); makeMask(Vector2.new(1, 0), 1, 0) end
end

local function addRowSeparator(row)
    mk("Frame", {
        Name = "__separator", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0),
        Size = UDim2.new(1, -32, 0, 1), BackgroundColor3 = T.stroke, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 2, Parent = row,
    })
end

local function applyRowStyle(row, isFirst, isLast)
    local c = row:FindFirstChildOfClass("UICorner"); if c then c:Destroy() end
    for _, m in ipairs(row:GetChildren()) do if m.Name == "__cornerMask" or m.Name == "__separator" then m:Destroy() end end
    local radius = 16
    if isFirst and isLast then corner(row, radius)
    elseif isFirst then corner(row, radius); addMasks(row, radius, "bottom")
    elseif isLast then corner(row, radius); addMasks(row, radius, "top") end
    if not isLast then addRowSeparator(row) end
end

local function attachRowTracker(group)
    local function refresh()
        local children = {}
        for _, child in ipairs(group:GetChildren()) do if child:GetAttribute("IsRow") then table.insert(children, child) end end
        table.sort(children, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
        local visibleRows = {}
        for _, child in ipairs(children) do if child.Visible then table.insert(visibleRows, child) end end
        for _, child in ipairs(children) do
            local c = child:FindFirstChildOfClass("UICorner"); if c then c:Destroy() end
            local m1 = child:FindFirstChild("__cornerMask"); if m1 then m1:Destroy() end
            local m2 = child:FindFirstChild("__separator"); if m2 then m2:Destroy() end
        end
        local i = 1
        while i <= #visibleRows do
            local row = visibleRows[i]
            local isMerge = row:GetAttribute("Merge") == true
            if isMerge then
                local j = i
                while j < #visibleRows and visibleRows[j+1]:GetAttribute("Merge") == true do j = j + 1 end
                for k = i, j do
                    local r = visibleRows[k]
                    if k == i and k == j then applyRowStyle(r, true, true)
                    elseif k == i then applyRowStyle(r, true, false)
                    elseif k == j then applyRowStyle(r, false, true)
                    else applyRowStyle(r, false, false) end
                end
                i = j + 1
            else
                applyRowStyle(row, true, true)
                i = i + 1
            end
        end
    end
    for _, child in ipairs(group:GetChildren()) do
        if child:GetAttribute("IsRow") == true then child:GetPropertyChangedSignal("Visible"):Connect(function() task.defer(refresh) end) end
    end
    task.defer(refresh)
end

function Library:CreateWindow(config)
    config = config or {}
    local Title = config.Title or "CryoHub"
    local LoadingStages = config.LoadingStages or { { text = "Ready.", duration = 0.2 } }

    local gui = mk("ScreenGui", { Name = "CryoHubUI", ResetOnSpawn = false, IgnoreGuiInset = true, Parent = pg })
    
    local root = mk("Frame", {
        Name = "Root", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(700, 500), BackgroundColor3 = T.bg, ClipsDescendants = true,
        Visible = false, Parent = gui,
    })
    corner(root, 22)
    
    -- Внешняя рамка без швов
    local strokeFrame = mk("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 10, Parent = root,
    })
    stroke(strokeFrame, T.stroke, 1.5, 0.3)

    local uiScale = mk("UIScale", { Scale = getAdaptiveScale(), Parent = root })

    local titleBar = mk("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1, Parent = root })
    mk("TextLabel", { Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -200, 1, 0), BackgroundTransparency = 1, Text = Title, FontFace = FontBold, TextSize = 17, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = titleBar })

    -- Сайдбар с защитой углов от вылезания
    local sidebar = mk("Frame", { Position = UDim2.fromOffset(0, 56), Size = UDim2.new(0, 190, 1, -56), BackgroundColor3 = T.sidebar, ClipsDescendants = true, Parent = root })
    mk("Frame", { Position = UDim2.new(0, 0, 1, -10), Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = T.sidebar, BorderSizePixel = 0, Parent = sidebar }) -- Маска нижнего угла

    local sidebarScroll = mk("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, CanvasSize = UDim2.new(0,0,0,0), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = sidebar })
    mk("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = sidebarScroll })
    mk("UIListLayout", { Padding = UDim.new(0, 6), Parent = sidebarScroll })

    -- Контентная зона с маской углов
    local content = mk("Frame", { Position = UDim2.new(0, 190, 0, 56), Size = UDim2.new(1, -190, 1, -56), BackgroundColor3 = T.content, ClipsDescendants = true, Parent = root })
    mk("Frame", { Position = UDim2.new(1, -10, 1, -10), Size = UDim2.new(0, 10, 0, 10), BackgroundColor3 = T.content, BorderSizePixel = 0, Parent = content }) -- Маска правого нижнего угла

    local Window = { Pages = {}, Tabs = {}, ActiveTab = nil, _sidebarItems = {} }

    function Window:CreateTab(tabConfig)
        local tabTitle = tabConfig.Title or "Tab"
        local tabId = tabTitle .. "_" .. tostring(#self.Tabs + 1)

        local btn = mk("TextButton", { Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1, Text = "", Parent = sidebarScroll })
        corner(btn, 12)
        mk("TextLabel", { Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -16, 1, 0), BackgroundTransparency = 1, Text = tabTitle, TextColor3 = T.textDim, FontFace = FontMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = btn })

        local page = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = content })
        local scroll = mk("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, CanvasSize = UDim2.new(0,0,0,0), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = page })
        mk("UIPadding", { PaddingTop = UDim.new(0, 20), PaddingBottom = UDim.new(0, 20), PaddingLeft = UDim.new(0, 20), PaddingRight = UDim.new(0, 20), Parent = scroll })
        mk("UIListLayout", { Padding = UDim.new(0, 12), Parent = scroll })
        
        self.Pages[tabId] = page
        self._sidebarItems[tabId] = { btn = btn, label = btn:FindFirstChildOfClass("TextLabel") }

        btn.MouseButton1Click:Connect(function()
            Window.ActiveTab = tabId
            for pid, p in pairs(self.Pages) do p.Visible = (pid == tabId) end
            for tid, item in pairs(self._sidebarItems) do
                item.btn.BackgroundColor3 = (tid == tabId) and T.activePill or T.sidebar
                item.btn.BackgroundTransparency = (tid == tabId) and 0 or 1
                item.label.TextColor3 = (tid == tabId) and T.text or T.textDim
            end
        end)

        if not self.ActiveTab then
            self.ActiveTab = tabId
            page.Visible = true
            btn.BackgroundColor3 = T.activePill
            btn.BackgroundTransparency = 0
            btn:FindFirstChildOfClass("TextLabel").TextColor3 = T.text
        end

        local Tab = { Page = scroll, _order = 0 }
        function Tab:CreateSection(name)
            self._order += 1
            mk("TextLabel", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = name, FontFace = FontBold, TextSize = 13, TextColor3 = T.accent, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = self._order, Parent = scroll })
            self._order += 1
            
            local group = mk("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.card, LayoutOrder = self._order, Parent = scroll })
            corner(group, 16); stroke(group, T.stroke, 1.2, 0.55)
            mk("UIListLayout", { Padding = UDim.new(0, 0), Parent = group })
            attachRowTracker(group)

            local Section = { Group = group, _nextOrder = 0 }

            -- 1. TOGGLE
            function Section:CreateToggle(cfg)
                Section._nextOrder += 1
                local row = mk("TextButton", { Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = T.card, BackgroundTransparency = 0, Text = "", LayoutOrder = Section._nextOrder, Parent = group })
                row:SetAttribute("IsRow", true); row:SetAttribute("Merge", cfg.Merge == true)
                hoverEffect(row, "cardHover", "card")
                mk("TextLabel", { Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -110, 1, 0), BackgroundTransparency = 1, Text = cfg.Title, FontFace = FontMedium, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
                
                local track = mk("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -18, 0.5, 0), Size = UDim2.fromOffset(50, 26), BackgroundColor3 = T.toggleOff, Parent = row })
                corner(track, 13)
                local knob = mk("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, -10), Size = UDim2.fromOffset(20, 20), BackgroundColor3 = T.toggleKnobOff, Parent = track })
                corner(knob, 10)

                local state = cfg.Default or false
                row.MouseButton1Click:Connect(function()
                    state = not state
                    track.BackgroundColor3 = state and T.accent or T.toggleOff
                    knob.Position = state and UDim2.new(0, 27, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
                    if cfg.Callback then cfg.Callback(state) end
                end)
                return row
            end

            -- 2. SLIDER
            function Section:CreateSlider(cfg)
                Section._nextOrder += 1
                local min, max, default = cfg.Min or 0, cfg.Max or 100, cfg.Default or 0
                local box = mk("Frame", { Size = UDim2.new(1, 0, 0, 76), BackgroundColor3 = T.card, LayoutOrder = Section._nextOrder, Parent = group })
                box:SetAttribute("IsRow", true); box:SetAttribute("Merge", cfg.Merge == true)
                hoverEffect(box, "cardHover", "card")

                mk("TextLabel", { Position = UDim2.fromOffset(18, 14), Size = UDim2.new(1, -110, 0, 20), BackgroundTransparency = 1, Text = cfg.Title, FontFace = FontMedium, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = box })
                local valLbl = mk("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 14), Size = UDim2.fromOffset(70, 20), BackgroundTransparency = 1, Text = tostring(default), FontFace = FontBold, TextSize = 14, TextColor3 = T.accent, TextXAlignment = Enum.TextXAlignment.Right, Parent = box })
                
                local trackBg = mk("Frame", { Position = UDim2.fromOffset(18, 52), Size = UDim2.new(1, -36, 0, 6), BackgroundColor3 = T.toggleOff, Parent = box })
                corner(trackBg, 3)
                local pct = (default - min) / (max - min)
                local fill = mk("Frame", { Size = UDim2.fromScale(pct, 1), BackgroundColor3 = T.accent, Parent = trackBg })
                corner(fill, 3)
                local knob = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(pct, 0.5), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = T.accent, Parent = trackBg })
                corner(knob, 11)

                local dragging = false
                local hit = mk("TextButton", { Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = "", Parent = box })
                local function update(input)
                    local relX = math.clamp((input.Position.X - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
                    local val = math.floor(min + (max - min) * relX)
                    fill.Size = UDim2.fromScale(relX, 1); knob.Position = UDim2.fromScale(relX, 0.5)
                    valLbl.Text = tostring(val)
                    if cfg.Callback then cfg.Callback(val) end
                end
                hit.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; update(input) end end)
                UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end end)
                UserInputService.InputEnded:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then dragging = false end end)
                return box
            end

            -- 3. INPUT
            function Section:CreateInput(cfg)
                Section._nextOrder += 1
                local box = mk("Frame", { Size = UDim2.new(1, 0, 0, 80), BackgroundColor3 = T.card, LayoutOrder = Section._nextOrder, Parent = group })
                box:SetAttribute("IsRow", true); box:SetAttribute("Merge", cfg.Merge == true)
                hoverEffect(box, "cardHover", "card")

                mk("TextLabel", { Position = UDim2.fromOffset(18, 10), Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = cfg.Title, FontFace = FontMedium, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = box })
                local field = mk("Frame", { Position = UDim2.fromOffset(18, 36), Size = UDim2.new(1, -36, 0, 34), BackgroundColor3 = T.toggleOff, Parent = box })
                corner(field, 12); stroke(field, T.stroke, 1, 0.6)
                local textBox = mk("TextBox", { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 1, 0), BackgroundTransparency = 1, Text = cfg.Default or "", PlaceholderText = cfg.Placeholder or "", PlaceholderColor3 = T.textDim, TextColor3 = T.text, FontFace = FontRegular, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Parent = field })
                textBox.FocusLost:Connect(function() if cfg.Callback then cfg.Callback(textBox.Text) end end)
                return box
            end

            -- 4. BUTTON
            function Section:CreateButton(cfg)
                Section._nextOrder += 1
                local btn = mk("TextButton", { Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = T.card, BackgroundTransparency = 0, Text = cfg.Title, FontFace = FontBold, TextSize = 15, TextColor3 = cfg.Danger and T.red or T.text, LayoutOrder = Section._nextOrder, Parent = group })
                btn:SetAttribute("IsRow", true); btn:SetAttribute("Merge", cfg.Merge == true)
                hoverEffect(btn, "cardHover", "card")
                btn.MouseButton1Click:Connect(function() if cfg.Callback then cfg.Callback() end end)
                return btn
            end

            -- 5. KEYBIND
            function Section:CreateKeybind(cfg)
                Section._nextOrder += 1
                local box = mk("Frame", { Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = T.card, LayoutOrder = Section._nextOrder, Parent = group })
                box:SetAttribute("IsRow", true); box:SetAttribute("Merge", cfg.Merge == true)
                hoverEffect(box, "cardHover", "card")

                mk("TextLabel", { Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -150, 1, 0), BackgroundTransparency = 1, Text = cfg.Title, FontFace = FontMedium, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = box })
                local keyBtn = mk("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -18, 0.5, 0), Size = UDim2.fromOffset(100, 34), BackgroundColor3 = T.toggleOff, Text = cfg.Default and cfg.Default.Name or "None", FontFace = FontBold, TextSize = 13, TextColor3 = T.accent, Parent = box })
                corner(keyBtn, 17)

                local listening = false
                keyBtn.MouseButton1Click:Connect(function()
                    if listening then return end
                    listening = true; keyBtn.Text = "Press..."; keyBtn.TextColor3 = T.textDim
                end)
                UserInputService.InputBegan:Connect(function(input, gpe)
                    if gpe or not listening then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        keyBtn.Text = input.KeyCode.Name; keyBtn.TextColor3 = T.accent; listening = false
                        if cfg.Callback then cfg.Callback(input.KeyCode) end
                    end
                end)
                return box
            end

            return Section
        end
        return Tab
    end

    -- Настраиваемая загрузка с поддержкой callback
    local LOADING_W, LOADING_H = 460, 260
    local loadingScreen = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(LOADING_W, LOADING_H), BackgroundColor3 = T.card,
        ZIndex = 200, ClipsDescendants = true, Parent = gui,
    })
    corner(loadingScreen, 22); stroke(loadingScreen, T.stroke, 1.2, 0.55)
    local loadingScale = mk("UIScale", { Scale = 0.5, Parent = loadingScreen })
    mk("TextLabel", { Position = UDim2.fromOffset(0, 98), Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Text = Title, FontFace = FontBold, TextSize = 28, TextColor3 = T.text, ZIndex = 210, Parent = loadingScreen })
    local loadingSubtitle = mk("TextLabel", { Position = UDim2.fromOffset(0, 136), Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = "Initializing...", FontFace = FontRegular, TextSize = 13, TextColor3 = T.textDim, ZIndex = 210, Parent = loadingScreen })
    local progressTrack = mk("Frame", { Position = UDim2.fromOffset(30, 176), Size = UDim2.new(1, -60, 0, 6), BackgroundColor3 = T.stroke, ZIndex = 210, Parent = loadingScreen })
    corner(progressTrack, 3)
    local progressFill = mk("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.accent, ZIndex = 211, Parent = progressTrack })
    corner(progressFill, 3)

    task.spawn(function()
        loadingScreen.Visible = true
        TweenService:Create(loadingScale, Tw.med, { Scale = math.max(math.min(workspace.CurrentCamera.ViewportSize.X/820, 1), 0.55) * 0.85 }):Play()
        
        local total = #LoadingStages
        for i, stage in ipairs(LoadingStages) do
            loadingSubtitle.Text = stage.text
            TweenService:Create(progressFill, TweenInfo.new(0.3, Enum.EasingStyle.Quart), { Size = UDim2.fromScale((i / total), 1) }):Play()
            if stage.callback then
                pcall(stage.callback)
            elseif stage.duration then
                task.wait(stage.duration)
            end
        end

        TweenService:Create(loadingScale, Tw.med, { Scale = 0.4 }):Play()
        task.wait(0.2)
        loadingScreen:Destroy()
        root.Visible = true
    end)

    return Window
end

return Library
