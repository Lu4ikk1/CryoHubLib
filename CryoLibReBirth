                UserInputService.InputBegan:Connect(function(input, gpe)
                    if gpe or not listening then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        currentKey = input.KeyCode
                        keyBtn.Text = input.KeyCode.Name
                        keyBtn.TextColor3 = self.T.accent
                        listening = false
                        self:Notify(title, "Keybind: " .. input.KeyCode.Name, ICONS.Keybind)
                        if callback then callback(input.KeyCode) end
                    end
                end)
                addSep(box)
                return {
                    GetValue = function() return currentKey end,
                    SetValue = function(key)
                        currentKey = key
                        keyBtn.Text = key and key.Name or "None"
                        keyBtn.TextColor3 = self.T.accent
                        if callback then callback(key) end
                    end,
                    OnChanged = function(cb) callback = cb end
                }
            end

            function group:AddColorPicker(title, defaultColor, callback)
                local baseHeight = 80
                local sliderRowHeight = 44
                local padding = 12
                local panelHeight = padding + sliderRowHeight * 3 + padding

                local currentR = defaultColor.R * 255
                local currentG = defaultColor.G * 255
                local currentB = defaultColor.B * 255
                local currentColor = defaultColor

                local box = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, baseHeight), BackgroundColor3 = self.T.card,
                    BackgroundTransparency = 0, Parent = groupFrame,
                })
                table.insert(self.Regs, { el = box, prop = "BackgroundColor3", key = "card" })
                hoverEffect(box, self.T.cardHover, self.T.card); box.MouseEnter:Connect(playHover)

                local swatchBg = mk("Frame", {
                    Position = UDim2.fromOffset(18, 18), Size = UDim2.fromOffset(44, 44),
                    BackgroundColor3 = defaultColor, BackgroundTransparency = 0, Parent = box,
                })
                corner(swatchBg, 12); stroke(swatchBg, self.T.stroke, 1, 0.4)

                local name = mk("TextLabel", {
                    Position = UDim2.fromOffset(76, 18), Size = UDim2.new(1, -140, 0, 22),
                    BackgroundTransparency = 1, Text = title, Font = Enum.Font.GothamBold,
                    TextSize = 15, TextColor3 = self.T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = box,
                })
                table.insert(self.Regs, { el = name, prop = "TextColor3", key = "text" })

                local hexLbl = mk("TextLabel", {
                    Position = UDim2.fromOffset(76, 40), Size = UDim2.new(1, -140, 0, 18),
                    BackgroundTransparency = 1, Text = "RGB: 255, 80, 80",
                    Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = self.T.textDim,
                    TextXAlignment = Enum.TextXAlignment.Left, Parent = box,
                })
                table.insert(self.Regs, { el = hexLbl, prop = "TextColor3", key = "textDim" })

                local clickArea = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, baseHeight), BackgroundTransparency = 1, Text = "", Parent = box,
                })
                clickArea.MouseButton1Down:Connect(function() playSound("click") end)

                local panel = mk("Frame", {
                    Position = UDim2.fromOffset(0, baseHeight), Size = UDim2.new(1, 0, 0, 0),
                    BackgroundColor3 = self.T.toggleOff, BackgroundTransparency = 0,
                    ClipsDescendants = true, Parent = box,
                })
                corner(panel, 14); table.insert(self.Regs, { el = panel, prop = "BackgroundColor3", key = "toggleOff" })

                local function updateColor()
                    currentColor = Color3.fromRGB(math.floor(currentR), math.floor(currentG), math.floor(currentB))
                    swatchBg.BackgroundColor3 = currentColor
                    hexLbl.Text = string.format("RGB: %d, %d, %d", math.floor(currentR), math.floor(currentG), math.floor(currentB))
                    if callback then callback(currentColor) end
                end
                updateColor()

                local function createChannel(yPos, label, chColor, getVal, setVal)
                    local row = mk("Frame", {
                        Position = UDim2.fromOffset(padding, yPos), Size = UDim2.new(1, -padding * 2, 0, sliderRowHeight),
                        BackgroundTransparency = 1, Parent = panel,
                    })
                    mk("TextLabel", {
                        Position = UDim2.fromOffset(0, 4), Size = UDim2.fromOffset(20, 16),
                        BackgroundTransparency = 1, Text = label, Font = Enum.Font.GothamBold,
                        TextSize = 13, TextColor3 = chColor, TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
                    })
                    local valueLbl = mk("TextLabel", {
                        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 4),
                        Size = UDim2.fromOffset(40, 16), BackgroundTransparency = 1,
                        Text = tostring(math.floor(getVal())), Font = Enum.Font.GothamBold,
                        TextSize = 12, TextColor3 = chColor, TextXAlignment = Enum.TextXAlignment.Right, Parent = row,
                    })
                    local track = mk("Frame", {
                        Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 6),
                        BackgroundColor3 = self.T.stroke, BackgroundTransparency = 0.5, Parent = row,
                    })
                    corner(track, 3)

                    local fill = mk("Frame", {
                        Size = UDim2.fromScale(getVal() / 255, 1), BackgroundColor3 = chColor,
                        BackgroundTransparency = 0, Parent = track,
                    })
                    corner(fill, 3)
                    local knob = mk("Frame", {
                        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(getVal() / 255, 0.5),
                        Size = UDim2.fromOffset(16, 16), BackgroundColor3 = chColor,
                        BackgroundTransparency = 0, Parent = track,
                    })
                    corner(knob, 8)

                    local dragging = false
                    local hit = mk("TextButton", {
                        Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 22),
                        BackgroundTransparency = 1, Text = "", Parent = row,
                    })

                    local function update(input)
                        local relX = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        local val = relX * 255
                        fill.Size = UDim2.fromScale(relX, 1)
                        knob.Position = UDim2.fromScale(relX, 0.5)
                        valueLbl.Text = tostring(math.floor(val))
                        setVal(val)
                        updateColor()
                        playSliderTick()
                    end

                    hit.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = true; update(input)
                        end
                    end)
                    UserInputService.InputChanged:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
                    end)
                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
                    end)
                end

                createChannel(padding, "R", Color3.fromRGB(235, 100, 98), function() return currentR end, function(v) currentR = v end)
                createChannel(padding + sliderRowHeight, "G", Color3.fromRGB(116, 199, 108), function() return currentG end, function(v) currentG = v end)
                createChannel(padding + sliderRowHeight * 2, "B", Color3.fromRGB(102, 192, 244), function() return currentB end, function(v) currentB = v end)

                local isOpen = false
                clickArea.MouseButton1Click:Connect(function()
                    isOpen = not isOpen
                    if isOpen then
                        TweenService:Create(panel, Tw.med, { Size = UDim2.new(1, 0, 0, panelHeight) }):Play()
                        TweenService:Create(box, Tw.med, { Size = UDim2.new(1, 0, 0, baseHeight + panelHeight) }):Play()
                    else
                        TweenService:Create(panel, Tw.fast, { Size = UDim2.new(1, 0, 0, 0) }):Play()
                        TweenService:Create(box, Tw.fast, { Size = UDim2.new(1, 0, 0, baseHeight) }):Play()
                        self:Notify(title, string.format("RGB: %d, %d, %d", math.floor(currentR), math.floor(currentG), math.floor(currentB)), ICONS.Color)
                    end
                end)
                addSep(box)
                return {
                    GetValue = function() return currentColor end,
                    SetValue = function(color)
                        currentColor = color
                        currentR, currentG, currentB = color.R * 255, color.G * 255, color.B * 255
                        updateColor()
                    end
                }
            end

            function group:AddButton(label, isDanger, onClick)
                local btn = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = self.T.card,
                    BackgroundTransparency = 0, Text = label, Font = Enum.Font.GothamBold,
                    TextSize = 15, TextColor3 = isDanger and self.T.red or self.T.text,
                    AutoButtonColor = false, Parent = groupFrame,
                })
                table.insert(self.Regs, { el = btn, prop = "BackgroundColor3", key = "card" })
                hoverEffect(btn, self.T.cardHover, self.T.card)
                btn.MouseEnter:Connect(playHover); btn.MouseButton1Down:Connect(function() playSound("click") end)
                if onClick then btn.MouseButton1Click:Connect(onClick) end
                addSep(btn)
                return btn
            end

            return group
        end
        return tabObj
    end

    function self:SwitchTab(id)
        if self.CurrentTab == id then return end
        self.CurrentTab = id
        self:RefreshSidebarColors()
        for pid, data in pairs(self.Pages) do
            local page = data.Page
            if pid == id then
                page.Visible = true
                page.GroupTransparency = 1
                page.Position = UDim2.fromOffset(8, 0)
                TweenService:Create(page, Tw.med, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }):Play()
            else
                local t = TweenService:Create(page, Tw.fast, { GroupTransparency = 1 })
                t:Play()
                t.Completed:Connect(function() if self.CurrentTab ~= pid then page.Visible = false end end)
            end
        end
    end

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local px, py = input.Position.X, input.Position.Y
            for i = #self.OpenDropdowns, 1, -1 do
                local dd = self.OpenDropdowns[i]
                local btnAbs = dd.btn.AbsolutePosition
                local btnSize = dd.btn.AbsoluteSize
                local inBtn = px >= btnAbs.X and px <= btnAbs.X + btnSize.X and py >= btnAbs.Y and py <= btnAbs.Y + btnSize.Y
                local inList = false
                if dd.list then
                    local listAbs = dd.list.AbsolutePosition
                    local listSize = dd.list.AbsoluteSize
                    inList = px >= listAbs.X and px <= listAbs.X + listSize.X and py >= listAbs.Y and py <= listAbs.Y + listSize.Y
                end
                if not inBtn and not inList then dd.close() end
            end
        end
    end)

    -- Loading Screen
    local LOADING_W, LOADING_H = 460, 260
    local loadingScreen = mk("CanvasGroup", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(LOADING_W, LOADING_H), BackgroundColor3 = self.T.card,
        BackgroundTransparency = 0, GroupTransparency = 1, ZIndex = 200,
        ClipsDescendants = true, Parent = self.Gui,
    })
    corner(loadingScreen, 22); stroke(loadingScreen, self.T.stroke, 1.2, 0.55)
    local loadingScale = mk("UIScale", { Scale = 0.85 * getAdaptiveScale(), Parent = loadingScreen })

    local decorHolder = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 200, Parent = loadingScreen })
    do
        local dotSpacing, dotSize = 24, 2
        local maxCols = math.floor(LOADING_W / dotSpacing) + 1
        local maxRows = math.floor(LOADING_H / dotSpacing) + 1
        for col = 0, maxCols do
            for row = 0, maxRows do
                local dot = mk("Frame", {
                    Position = UDim2.fromOffset(col * dotSpacing - 4, row * dotSpacing - 4),
                    Size = UDim2.fromOffset(dotSize, dotSize), BackgroundColor3 = self.T.stroke,
                    BackgroundTransparency = 0.65, BorderSizePixel = 0, ZIndex = 200, Parent = decorHolder,
                })
                corner(dot, 1)
            end
        end
    end
    for _, g in ipairs({ { size = 220, x = 140, y = 80, trans = 0.96 }, { size = 160, x = 200, y = 120, trans = 0.94 }, { size = 100, x = 300, y = 130, trans = 0.92 } }) do
        local glow = mk("Frame", {
            Position = UDim2.fromOffset(g.x, g.y), Size = UDim2.fromOffset(g.size, g.size),
            BackgroundColor3 = self.T.accent, BackgroundTransparency = g.trans,
            BorderSizePixel = 0, ZIndex = 201, Parent = decorHolder,
        })
        corner(glow, g.size / 2)
    end

    local iconHolder = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24),
        Size = UDim2.fromOffset(60, 60), BackgroundTransparency = 1, ZIndex = 210, Parent = loadingScreen,
    })
    if self.Config.LoadingHasGlow then
        local glowRing = mk("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(60, 60), BackgroundColor3 = self.Config.LoadingIconColor or self.T.accent,
            BackgroundTransparency = 0.85, ZIndex = 209, Parent = iconHolder,
        })
        corner(glowRing, 30)
        local glowRingScale = mk("UIScale", { Scale = 1, Parent = glowRing })
        task.spawn(function()
            while loadingScreen and loadingScreen.Parent do
                TweenService:Create(glowRingScale, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Scale = 1.35 }):Play()
                TweenService:Create(glowRing, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.95 }):Play()
                task.wait(1.2)
                if not (loadingScreen and loadingScreen.Parent) then break end
                TweenService:Create(glowRingScale, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Scale = 1 }):Play()
                TweenService:Create(glowRing, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.85 }):Play()
                task.wait(1.2)
            end
        end)
    end

    local iconCircle = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(52, 52), BackgroundColor3 = self.T.accent,
        BackgroundTransparency = 0, ZIndex = 210, Parent = iconHolder,
    })
    corner(iconCircle, 26)
    mk("ImageLabel", {
        Size = UDim2.fromOffset(self.Config.LoadingIconSize, self.Config.LoadingIconSize),
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        BackgroundTransparency = 1, Image = self.Config.LoadingIcon,
        ImageColor3 = self.Config.LoadingIconColor or self.T.bg, ZIndex = 211, Parent = iconCircle,
    })
    mk("TextLabel", {
        Position = UDim2.fromOffset(0, 98), Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1, Text = "CryoHub", Font = Enum.Font.GothamBold,
        TextSize = 28, TextColor3 = self.T.text, ZIndex = 210, Parent = loadingScreen,
    })
    local loadingSubtitle = mk("TextLabel", {
        Position = UDim2.fromOffset(0, 136), Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1, Text = "Initializing...", Font = Enum.Font.Gotham,
        TextSize = 13, TextColor3 = self.T.textDim, ZIndex = 210, Parent = loadingScreen,
    })
    local progressTrack = mk("Frame", {
        Position = UDim2.fromOffset(30, 176), Size = UDim2.new(1, -60, 0, 6),
        BackgroundColor3 = self.T.stroke, BackgroundTransparency = 0.75, ZIndex = 210, Parent = loadingScreen,
    })
    corner(progressTrack, 3)
    local progressFill = mk("Frame", {
        Size = UDim2.fromScale(0, 1), BackgroundColor3 = self.T.accent,
        BackgroundTransparency = 0, ZIndex = 211, Parent = progressTrack,
    })
    corner(progressFill, 3)
    local percentLbl = mk("TextLabel", {
        Position = UDim2.fromOffset(0, 192), Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1, Text = "0%", Font = Enum.Font.GothamBold,
        TextSize = 12, TextColor3 = self.T.accent, ZIndex = 210, Parent = loadingScreen,
    })

    local function runLoading()
        local totalStages = #self.Config.LoadingStages
        for i, stage in ipairs(self.Config.LoadingStages) do
            loadingSubtitle.Text = stage.text
            local targetPct = (i / totalStages) * 100
            TweenService:Create(progressFill, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.fromScale(targetPct / 100, 1) }):Play()
            task.spawn(function()
                local startPct = ((i - 1) / totalStages) * 100
                local elapsed = 0
                while elapsed < 0.3 do
                    elapsed += task.wait()
                    local alpha = math.min(elapsed / 0.3, 1)
                    percentLbl.Text = math.floor(startPct + (targetPct - startPct) * alpha) .. "%"
                end
                percentLbl.Text = math.floor(targetPct) .. "%"
            end)
            if stage.callback then
                local success, err = pcall(stage.callback)
                if not success then warn("Loading stage error: " .. tostring(err)) end
            elseif stage.duration then
                task.wait(stage.duration)
            end
        end
        task.wait(0.3)
    end

    task.spawn(function()
        task.wait(0.2)
        TweenService:Create(loadingScreen, Tw.med, { GroupTransparency = 0 }):Play()
        TweenService:Create(loadingScale, Tw.med, { Scale = math.max(math.min(workspace.CurrentCamera.ViewportSize.X / 820, 1), 0.55) * 0.85 }):Play()
        task.wait(0.35)
        runLoading()
        TweenService:Create(loadingScreen, Tw.med, { GroupTransparency = 1 }):Play()
        TweenService:Create(loadingScale, Tw.med, { Scale = 0.5 }):Play()
        task.wait(0.3)
        loadingScreen:Destroy()
        
        self.Loaded = true
        self.Root.Visible = true
        self.Root.GroupTransparency = 1
        if self.UiScale then
            self.UiScale.Scale = 0.88
            TweenService:Create(self.Root, Tw.med, { GroupTransparency = 0 }):Play()
            TweenService:Create(self.UiScale, Tw.med, { Scale = getAdaptiveScale() }):Play()
        end
        task.delay(0.8, function() self:Notify("CryoHub Ready", "Interface loaded.", ICONS.Check) end)
        if self.WindowPlayIntro then self.WindowPlayIntro() end
    end)

    return self
end

return CryoHub
