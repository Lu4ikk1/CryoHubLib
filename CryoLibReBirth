    function Window:_switchTab(page)
        if currentTab == page then return end
        currentTab = page
        for p, el in pairs(tabEls) do
            local active = (p == page)
            if active then
                el.btn.BackgroundColor3 = T.secondaryContainer
                TweenService:Create(el.btn, Tw.med, { BackgroundTransparency = 0 }):Play()
                el.lbl.TextColor3 = T.onSecondaryContainer
                el.ico.ImageColor3 = T.onSecondaryContainer
            else
                TweenService:Create(el.btn, Tw.med, { BackgroundTransparency = 1 }):Play()
                el.lbl.TextColor3 = T.onSurfaceVariant
                el.ico.ImageColor3 = T.onSurfaceVariant
            end
        end
        for _, p in ipairs(pages) do
            if p == page then
                p.Visible = true
                p.GroupTransparency = 1
                p.Position = UDim2.fromOffset(10, 0)
                TweenService:Create(p, Tw.med, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }):Play()
            else
                local t = TweenService:Create(p, Tw.fast, { GroupTransparency = 1 })
                t:Play()
                t.Completed:Connect(function() if currentTab ~= p then p.Visible = false end end)
            end
        end
    end

    function Window:_refreshTheme()
        for p, el in pairs(tabEls) do
            if p == currentTab then
                el.btn.BackgroundColor3 = T.secondaryContainer
                el.lbl.TextColor3 = T.onSecondaryContainer
                el.ico.ImageColor3 = T.onSecondaryContainer
            end
        end
    end
