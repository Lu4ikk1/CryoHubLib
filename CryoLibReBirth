    local loadingScale = mk("UIScale", { Scale = 0.85 * getAdaptiveScale(), Parent = loadingScreen })
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        loadingScale.Scale = math.max(math.min(workspace.CurrentCamera.ViewportSize.X / 820, 1), 0.55) * 0.85
    end)

    local loadingDrag, loadingDragStart, loadingDragPos = false, nil, nil
    loadingScreen.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            loadingDrag = true; loadingDragStart = input.Position; loadingDragPos = loadingScreen.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if loadingDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - loadingDragStart
            loadingScreen.Position = UDim2.new(loadingDragPos.X.Scale, loadingDragPos.X.Offset + d.X, loadingDragPos.Y.Scale, loadingDragPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then loadingDrag = false end
    end)

    -- Decor
