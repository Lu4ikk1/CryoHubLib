-- ============================================================
local function mk(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    return o
end
local function corner(p, r) return mk("UICorner", { CornerRadius = UDim.new(0, r or R.L), Parent = p }) end
local function stroke(p, c, t, tr)
    return mk("UIStroke", { Color = c, Thickness = t or 1, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p })
end

-- Состояние библиотеки
local T = THEMES.Dark
local SoundOn = true
local regs = {}
local function reg(el, prop, key)
    regs[#regs + 1] = { el = el, prop = prop, key = key }
end

local sounds = {}
local lastHover = 0
local lastTick  = 0
local function playSound(name)
    if not SoundOn then return end
    local s = sounds[name]
    if s then s:Stop(); s:Play() end
end
local function playHover()
    local n = os.clock(); if n - lastHover < 0.06 then return end
    lastHover = n; playSound("hover")
end
local function playTick()
    local n = os.clock(); if n - lastTick < 0.05 then return end
    lastTick = n; playSound("slider")
end

-- MD3 Ripple
local function ripple(parent, pos, color)
    local abs, size = parent.AbsolutePosition, parent.AbsoluteSize
    local rel = Vector2.new(pos.X - abs.X, pos.Y - abs.Y)
    local maxD = math.max(rel.X, size.X - rel.X, rel.Y, size.Y - rel.Y)
    local dot = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(math.floor(rel.X), math.floor(rel.Y)),
        Size = UDim2.fromOffset(6, 6),
        BackgroundColor3 = color or T.onSurface,
        BackgroundTransparency = 0.85,
        BorderSizePixel = 0,
        ZIndex = (parent.ZIndex or 1) + 10,
        Parent = parent,
    })
    corner(dot, R.FULL)
    local t = TweenService:Create(dot, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        { Size = UDim2.fromOffset(math.floor(maxD * 2.4), math.floor(maxD * 2.4)), BackgroundTransparency = 1 })
    t:Play()
    t.Completed:Connect(function() dot:Destroy() end)
end

local function pressScale(btn)
    local s = btn:FindFirstChildOfClass("UIScale") or mk("UIScale", { Scale = 1, Parent = btn })
    btn.MouseButton1Down:Connect(function()
        TweenService:Create(s, Tw.pressDown, { Scale = 0.97 }):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenService:Create(s, Tw.pressUp, { Scale = 1 }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(s, Tw.fast, { Scale = 1 }):Play()
    end)
end

