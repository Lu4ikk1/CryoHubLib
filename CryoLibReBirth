                TweenService:Create(box, Tw.fast, { Size = UDim2.new(1, 0, 0, baseHeight) }):Play()
                Notify(title, string.format("RGB: %d, %d, %d",
                    math.floor(currentR), math.floor(currentG), math.floor(currentB)), ICONS.Color)
            end
        end)

        if not isLast then addRowSeparator(box) end
        return box
    end

