                local list = mk("Frame", { Position = UDim2.fromOffset(18, baseHeight), Size = UDim2.new(1, -36, 0, 0), BackgroundColor3 = T.toggleOff, BackgroundTransparency = 0, ClipsDescendants = true, Parent = box })
                corner(list, 12)
                mk("UIListLayout", { Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

                local selected = {}
                local optionRows = {}
                local ElementObj = { Value = dropConfig.Multi and {} or dropConfig.Default }

                local function updateSelectionVisual()
                    for opt, row in pairs(optionRows) do
                        local check = row:FindFirstChild("Check")
                        if check then check.Visible = (dropConfig.Multi and selected[opt] or (not dropConfig.Multi and selected[opt] == true)) end
                    end
                end

                function ElementObj:Set(val)
                    self.Value = val
                    if dropConfig.Multi then
                        selected = val
                        updateSelectionVisual()
                        local parts = {} for k, v in pairs(val) do if v then table.insert(parts, k) end end
                        dropLbl.Text = #parts > 0 and table.concat(parts, ", ") or "Select..."
                    else
                        for k in pairs(selected) do selected[k] = nil end
                        selected[val] = true
                        updateSelectionVisual()
                        dropLbl.Text = val
                    end
                    processDependencies()
                end

                for i, opt in ipairs(dropConfig.Options) do
                    local optRow = mk("TextButton", { Size = UDim2.new(1, 0, 0, optHeight), BackgroundColor3 = T.cardHover, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = i, Parent = list })
