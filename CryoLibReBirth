local regs = {}
local function reg(el, prop, key) regs[#regs+1] = { el = el, prop = prop, key = key } end
local refreshCallbacks = {}
local function onThemeChange(fn) table.insert(refreshCallbacks, fn) end

local function applyTheme(name)
    if not THEMES[name] then return end
    currentTheme = name
    T = THEMES[name]
    for _, r in ipairs(regs) do
        if r.el and r.el.Parent then
            TweenService:Create(r.el, Tw.med, { [r.prop] = T[r.key] }):Play()
        end
    end
    for _, fn in ipairs(refreshCallbacks) do pcall(fn, T) end
end

