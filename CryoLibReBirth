    local function createColorPicker(parent, title, defaultColor, order, onPick, isLast)
        local baseHeight = 80
        local sliderRowHeight = 44
        local padding = 12
        local panelHeight = padding + sliderRowHeight * 3 + padding

        local currentR = defaultColor.R * 255
        local currentG = defaultColor.G * 255
        local currentB = defaultColor.B * 255
        local currentColor = defaultColor

        local box = mk("Frame", {
            Size = UDim2.new(1, 0, 0, baseHeight), BackgroundColor3 = T.card,
            BackgroundTransparency = 0, LayoutOrder = order or 0, Parent = parent,
        })
        reg(box, "BackgroundColor3", "card")
        hoverEffect(box, T.cardHover, T.card)
        box.MouseEnter:Connect(playHover)

        local swatchBg = mk("Frame", {
            Position = UDim2.fromOffset(18, 18), Size = UDim2.fromOffset(44, 44),
            BackgroundColor3 = defaultColor, BackgroundTransparency = 0, Parent = box,
        })
        corner(swatchBg, 12)
        stroke(swatchBg, T.stroke, 1, 0.4)

        local name = mk("TextLabel", {
            Position = UDim2.fromOffset(76, 18), Size = UDim2.new(1, -140, 0, 22),
            BackgroundTransparency = 1, Text = title,
            Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = T.text,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = box,
        })
        reg(name, "TextColor3", "text")

        local hexLbl = mk("TextLabel", {
            Position = UDim2.fromOffset(76, 40), Size = UDim2.new(1, -140, 0, 18),
            BackgroundTransparency = 1, Text = "RGB: 255, 80, 80",
            Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.textDim,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = box,
        })
        reg(hexLbl, "TextColor3", "textDim")

        local clickArea = mk("TextButton", {
            Size = UDim2.new(1, 0, 0, baseHeight),
            BackgroundTransparency = 1, Text = "", Parent = box,
        })
        clickArea.MouseButton1Down:Connect(function() playSound("click") end)

        local panel = mk("Frame", {
            Position = UDim2.fromOffset(0, baseHeight),
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundColor3 = T.toggleOff, BackgroundTransparency = 0,
            ClipsDescendants = true, Parent = box,
        })
        corner(panel, 14)
        reg(panel, "BackgroundColor3", "toggleOff")

        local function updateColor()
            currentColor = Color3.fromRGB(math.floor(currentR), math.floor(currentG), math.floor(currentB))
            swatchBg.BackgroundColor3 = currentColor
            hexLbl.Text = string.format("RGB: %d, %d, %d",
                math.floor(currentR), math.floor(currentG), math.floor(currentB))
            if onPick then onPick(currentColor) end
        end
        updateColor()

        local function createChannel(yPos, label, chColor, getVal, setVal)
            local row = mk("Frame", {
                Position = UDim2.fromOffset(padding, yPos),
                Size = UDim2.new(1, -padding * 2, 0, sliderRowHeight),
                BackgroundTransparency = 1, Parent = panel,
            })
            mk("TextLabel", {
                Position = UDim2.fromOffset(0, 4), Size = UDim2.fromOffset(20, 16),
                BackgroundTransparency = 1, Text = label,
                Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = chColor,
                TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
            })
            local valueLbl = mk("TextLabel", {
                AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 4),
                Size = UDim2.fromOffset(40, 16), BackgroundTransparency = 1,
                Text = tostring(math.floor(getVal())),
                Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = chColor,
                TextXAlignment = Enum.TextXAlignment.Right, Parent = row,
            })
            local track = mk("Frame", {
                Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 6),
                BackgroundColor3 = T.stroke, BackgroundTransparency = 0.5, Parent = row,
            })
            corner(track, 3)

            local fill = mk("Frame", {
                Size = UDim2.fromScale(getVal() / 255, 1), BackgroundColor3 = chColor,
                BackgroundTransparency = 0, Parent = track,
            })
            corner(fill, 3)
            local knob = mk("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(getVal() / 255, 0.5),
                Size = UDim2.fromOffset(16, 16), BackgroundColor3 = chColor,
                BackgroundTransparency = 0, Parent = track,
            })
            corner(knob, 8)

            local dragging = false
            local hit = mk("TextButton", {
                Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 22),
                BackgroundTransparency = 1, Text = "", Parent = row,
            })

            local function update(input)
                local relX = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                local val = relX * 255
                fill.Size = UDim2.fromScale(relX, 1)
                knob.Position = UDim2.fromScale(relX, 0.5)
                valueLbl.Text = tostring(math.floor(val))
                setVal(val)
                updateColor()
                playSliderTick()
            end

            hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true; update(input)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    update(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
        end

        createChannel(padding, "R", Color3.fromRGB(235, 100, 98),
            function() return currentR end, function(v) currentR = v end)
        createChannel(padding + sliderRowHeight, "G", Color3.fromRGB(116, 199, 108),
            function() return currentG end, function(v) currentG = v end)
        createChannel(padding + sliderRowHeight * 2, "B", Color3.fromRGB(102, 192, 244),
            function() return currentB end, function(v) currentB = v end)

        local isOpen = false
        clickArea.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            if isOpen then
                TweenService:Create(panel, Tw.med, { Size = UDim2.new(1, 0, 0, panelHeight) }):Play()
